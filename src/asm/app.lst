046EDC F1          0341*        pop af
046EDD C9          0342*        ret
046EDE             0343*    
046EDE             0344*    
046EDE             0345*    ; inputs: whatever is in the flags register
046EDE             0346*    ; outputs: binary representation of flags
046EDE             0347*    ;          with a header so we know which is what
046EDE             0348*    ; destroys: nothing
046EDE             0349*    ; preserves: everything
046EDE             0350*    dumpFlags:
046EDE             0351*    ; first we curse zilog for not giving direct access to flags
046EDE F5          0352*        push af ; this is so we can send it back unharmed
046EDF F5          0353*        push af ; this is so we can pop it to hl
046EE0             0354*    ; store everything in scratch
046EE0 22 AA 03 04 0355*        ld (uhl),hl
046EE4 ED 43 AD 03 0356*        ld (ubc),bc
       04          
046EE9 ED 53 B0 03 0357*        ld (ude),de
       04          
046EEE DD 22 B3 03 0358*        ld (uix),ix
       04          
046EF3 FD 22 B6 03 0359*        ld (uiy),iy
       04          
046EF8             0360*    ; next we print the header
046EF8 21 24 6F 04 0361*        ld hl,@header
046EFC CD 67 00 04 0362*        call printString
046F00 E1          0363*        pop hl ; flags are now in l
046F01 7D          0364*        ld a,l ; flags are now in a
046F02 CD E3 02 04 0365*        call printBin8
046F06 CD 7C 00 04 0366*        call printNewLine
046F0A             0367*    ; restore everything
046F0A 2A AA 03 04 0368*        ld hl, (uhl)
046F0E ED 4B AD 03 0369*        ld bc, (ubc)
       04          
046F13 ED 5B B0 03 0370*        ld de, (ude)
       04          
046F18 DD 2A B3 03 0371*        ld ix, (uix)
       04          
046F1D FD 2A B6 03 0372*        ld iy, (uiy)
       04          
046F22 F1          0373*        pop af ; send her home the way she came
046F23 C9          0374*        ret
046F24             0375*    ; Bit 7 (S): Sign flag
046F24             0376*    ; Bit 6 (Z): Zero flag
046F24             0377*    ; Bit 5 (5): Reserved (copy of bit 5 of the result)
046F24             0378*    ; Bit 4 (H): Half Carry flag
046F24             0379*    ; Bit 3 (3): Reserved (copy of bit 3 of the result)
046F24             0380*    ; Bit 2 (PV): Parity/Overflow flag
046F24             0381*    ; Bit 1 (N): Subtract flag
046F24             0382*    ; Bit 0 (C): Carry flag
046F24 53 5A 78 48 0383*    @header: db "SZxHxPNC\r\n",0 ; cr/lf and 0 terminator
       78 50 4E 43 

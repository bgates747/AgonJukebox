043D94 A7          0184*        and a ; check for zero files in the directory
043D95 C8          0185*        ret z ; nothing to see here, move along
043D96 AF          0186*        xor a ; song index
043D97             0187*    @loop:
043D97 C5          0188*        push bc ; save loop counter
043D98 F5          0189*        push af ; save song index
043D99 CD 68 6C 04 0190*        call printHexA ; print the song index
043D9D DD 31 00    0191*        ld iy,(ix) ; iy points to filinfo struct
043DA0 CD 0B 3E 04 0192*        call bf_print_dir_or_file
043DA4             0193*    @bump_counters:
043DA4 ED 32 03    0194*        lea ix,ix+3 ; bump the filename pointer
043DA7 F1          0195*        pop af ; restore song index

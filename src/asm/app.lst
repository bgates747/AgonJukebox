0401E4             0007*M1      ; 13 cycles total
0401E4 01 F0 D8 FF 0311*        ld bc, -10000
0401E8 CD 0B 02 04 0312*        call @one_int
0401EC 01 18 FC FF 0313*        ld bc, -1000
0401F0 CD 0B 02 04 0314*        call @one_int
0401F4 01 9C FF FF 0315*        ld bc, -100
0401F8 CD 0B 02 04 0316*        call @one_int
0401FC 0E F6       0317*        ld c, -10
0401FE CD 0B 02 04 0318*        call @one_int
040202 48          0319*        ld c, b
040203 CD 0B 02 04 0320*        call @one_int
040207 C3 16 02 04 0321*        jp @frac ; Jump to fractional part conversion
04020B             0322*    @one_int:
04020B 3E 2F       0323*        ld a, '0' - 1 ; Start ASCII character at '0'
04020D             0324*    @divide_me:
04020D 3C          0325*        inc a
04020E 09          0326*        add hl, bc ; Accumulate until overflow

04111B             0457*    ; atan2_(ub.c,ud.e) --> uh.l
04111B             0458*    ; inputs: ub.c and ud.e are dx and dy in 16.8 fixed format
04111B             0459*    ;   whether inputs are integers or fractional doesn't matter
04111B             0460*    ;   so long as the sign bit of the upper byte is correct
04111B             0461*    ; output: uh.l is the 16.8 fixed angle in degrees 256
04111B             0462*    ; angles are COMPASS HEADINGS based on
04111B             0463*    ; screen coordinate conventions,where the y axis is flipped
04111B             0464*    ; #E0 224      0       32 #20
04111B             0465*    ;        -x,-y | +x,-y
04111B             0466*    ; #C0 192------+------ 64 #40
04111B             0467*    ;        -x,+y | +x,+y
04111B             0468*    ; #A0 160   128 #80   96 #60

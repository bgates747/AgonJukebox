043C0B 00          0352*        db 0 ; list terminator
043C0C             0050         include "browse.inc"
043C0C             0001*    bf_files_per_pg: equ 10 ; number of directories / files to display per page
043C0C             0002*    
043C0C             0003*    bf_get_dir:
043C0C             0004*    ; initialize counters
043C0C 21 00 00 00 0005*        ld hl,0
043C10 22 01 00 07 0006*        ld (bf_dir_num_files),hl
043C14             0007*    
043C14             0008*    ; initialize pointers to store directory info and print directory name
043C14 21 10 00 07 0009*        ld hl,bf_dir_path  ; where to store result
043C18 01 FF 00 00 0010*        ld bc,255          ; max length (final byte is zero terminator) [has no effect]
043C1C             0011*        FFSCALL ffs_getcwd ; MOS api get current working directory
                       M1 Args: function=ffs_getcwd 
043C1C FD E5       0001*M1  			PUSH IY
043C1E 3E 9E       0002*M1  			LD	A, function
043C20 5B CF       0003*M1  			RST.LIL	08h
043C22 FD E1       0004*M1  			POP IY
043C24             0012*    
043C24             0013*    ; get dir info
043C24 21 00 02 07 0014*        ld hl,bf_dir_struct ; define where to store directory info
043C28 11 10 00 07 0015*        ld de,bf_dir_path   ; this is pointer to the path to the directory
043C2C AF          0016*        xor a               ; tell MOS to expect zero-terminated string
043C2D             0017*        FFSCALL ffs_dopen   ; open dir
                       M1 Args: function=ffs_dopen 
043C2D FD E5       0001*M1  			PUSH IY
043C2F 3E 91       0002*M1  			LD	A, function
043C31 5B CF       0003*M1  			RST.LIL	08h
043C33 FD E1       0004*M1  			POP IY
043C35             0018*    
043C35             0019*    ; set up pointers
043C35 DD 21 00 06 0020*        ld ix,bf_dir_fil_list ; this is the pointer to the filinfo structs
       07          
043C3A FD 21 00 03 0021*        ld iy,bf_filinfo_ptrs ; where to store pointers to filinfo structs
       07          
043C3F             0022*    
043C3F             0023*    @readFileInfo:               ; we will loop here until all files have been processed
043C3F 21 00 02 07 0024*        ld hl,bf_dir_struct      ; HL is where to get directory info
043C43 ED 12 00    0025*        lea de,ix                ; DE is where to store filinfo struct
043C46             0026*        FFSCALL ffs_dread        ; read next item from dir into filinfo struct
                       M1 Args: function=ffs_dread 
043C46 FD E5       0001*M1  			PUSH IY
043C48 3E 93       0002*M1  			LD	A, function
043C4A 5B CF       0003*M1  			RST.LIL	08h
043C4C FD E1       0004*M1  			POP IY
043C4E             0027*    
043C4E DD 7E 16    0028*        ld a,(ix+filinfo_fname)  ; get first char of file name
043C51 B7          0029*        or a                     ; if zero then we are at the end of the listing
043C52 CA AD 3C 04 0030*        jp z,@allDone
043C56             0031*    
043C56 DD 7E 08    0032*        ld a,(ix+filinfo_fattrib) ; get the file attribute
043C59 CB AF       0033*        res AM_ARC,a ; clear bit 5 (archive) see: https://discord.com/channels/1158535358624039014/1158536667670511726/1328466726098309173
043C5B B7          0034*        or a ; if zero this is a file
043C5C C2 65 3C 04 0035*        jp nz,@F ; not zero so this is some other file type
043C60 CB EF       0036*        set AM_ARC,a ; set bit 5 (archive) so will be consistent btw emulator and hardware
043C62 DD 77 08    0037*        ld (ix+filinfo_fattrib),a ; update so we don't have to do this every time downstream
043C65             0038*    
043C65             0039*    @@: ; skip over writing hidden and system files
043C65 CB 4F       0040*        bit AM_HID,a ; hidden file
043C67 C2 3F 3C 04 0041*        jp nz,@readFileInfo
043C6B CB 57       0042*        bit AM_SYS,a ; system file
043C6D C2 3F 3C 04 0043*        jp nz,@readFileInfo
043C71             0044*    
043C71             0045*    ; check for valid directory
043C71 CB 67       0046*        bit AM_DIR,a ; directory
043C73 C2 8F 3C 04 0047*        jp nz,@isDir ; is directory so skip .wav file check
043C77             0048*    
043C77             0049*    ; is file so check for valid .wav format
043C77 21 00 FF 06 0050*        ld hl,bf_fil_struct ; hl = pointer to fil struct
043C7B ED 12 16    0051*        lea de,ix+filinfo_fname ; de = pointer to filename
043C7E CD BD 6B 04 0052*        call bf_verify_wav
043C82 CA 3F 3C 04 0053*        jp z,@readFileInfo ; not a .wav file, so skip it
043C86             0054*    ; set the last byte of filinfo_faltname to 1 to indicate this is a file for filename sorting
043C86 3E 31       0055*        ld a,'1'
043C88 DD 77 15    0056*        ld (ix+filinfo_fname-1),a
043C8B C3 94 3C 04 0057*        jp @goodPath
043C8F             0058*    @isDir:
043C8F             0059*    ; set the last byte of filinfo_faltname to 0 to indicate this is a directory for filename sorting
043C8F 3E 30       0060*        ld a,'0'
043C91 DD 77 15    0061*        ld (ix+filinfo_fname-1),a
043C94             0062*        ; fall through to @goodPath
043C94             0063*    @goodPath:
043C94             0064*    ; valid file or directory
043C94 FD 3E 00    0065*        ld (iy),ix ; store pointer to filinfo struct
043C97 2A 01 00 07 0066*        ld hl,(bf_dir_num_files) ; get the current file counter
043C9B 23          0067*        inc hl                  ; increment the counter
043C9C 22 01 00 07 0068*        ld (bf_dir_num_files),hl
043CA0             0069*    ; bump pointers
043CA0 ED 33 03    0070*        lea iy,iy+3
043CA3 11 16 01 00 0071*        ld de,filinfo_struct_size ; length of filinfo record
043CA7 DD 19       0072*        add ix,de
043CA9 C3 3F 3C 04 0073*        jp @readFileInfo         ; loop around to check next entry
043CAD             0074*    @allDone:
043CAD             0075*    ; compute page statistics
043CAD 11 0A 00 00 0076*        ld de,bf_files_per_pg    ; number of files per page
043CB1 2A 01 00 07 0077*        ld hl,(bf_dir_num_files) ; get the number of files
043CB5             0078*        SIGN_UHL ; check for zero
                       M1 Args: none
043CB5 19          0001*M1      add hl,de ; 1 cycle
043CB6 B7          0002*M1      or a ; clear flags ; 1 cycle
043CB7 ED 52       0003*M1      sbc hl,de ; 2 cycles
043CB9             0004*M1      ; 4 cycles total
043CB9 C2 C9 3C 04 0079*        jp nz,@not_zero
043CBD 11 00 00 00 0080*        ld de,0 ; number of pages, will increment by 1 later
043CC1 21 00 00 00 0081*        ld hl,0 ; number of files on last page
043CC5 C3 DA 3C 04 0082*        jp @write_stats
043CC9             0083*    @not_zero:
043CC9 CD F5 03 04 0084*        call udiv24 ; de = hl/bf_files_per_pg, hl = mod(hl,bf_files_per_pg)
043CCD             0085*        SIGN_UHL ; check remainder for zero
                       M1 Args: none
043CCD 19          0001*M1      add hl,de ; 1 cycle
043CCE B7          0002*M1      or a ; clear flags ; 1 cycle
043CCF ED 52       0003*M1      sbc hl,de ; 2 cycles
043CD1             0004*M1      ; 4 cycles total
043CD1 C2 DA 3C 04 0086*        jp nz,@write_stats
043CD5 21 0A 00 00 0087*        ld hl,bf_files_per_pg ; if zero then we have exactly bf_files_per_pg files on the last page ...
043CD9 1B          0088*        dec de ; ... and we don't need an additional page for the remainder
043CDA             0089*    @write_stats:
043CDA 22 07 00 07 0090*        ld (bf_files_last_pg),hl ; save the number of files on the last page
043CDE 13          0091*        inc de ; bump the page count
043CDF ED 53 0D 00 0092*        ld (bf_dir_num_pages),de ; save the number of pages
       07          
043CE4 21 00 00 00 0093*        ld hl,0 ; reset the page number
043CE8 22 0A 00 07 0094*        ld (bf_page_cur),hl
043CEC             0095*    ; sort the filenames
043CEC FD 21 00 03 0096*        ld iy,bf_filinfo_ptrs ; get the pointer to the fileinfo pointer table
       07          
043CF1 3A 01 00 07 0097*        ld a,(bf_dir_num_files) ; get the number of files
043CF5 47          0098*        ld b,a ; loop counter
043CF6 CD 28 6B 04 0099*        call selection_sort_asc_filinfo ; sort the filenames
043CFA             0100*    ; close the directory
043CFA 21 00 02 07 0101*        ld hl,bf_dir_struct      ; load H: with address of the DIR struct
043CFE             0102*        FFSCALL ffs_dclose       ; close dir
                       M1 Args: function=ffs_dclose 
043CFE FD E5       0001*M1  			PUSH IY
043D00 3E 92       0002*M1  			LD	A, function
043D02 5B CF       0003*M1  			RST.LIL	08h
043D04 FD E1       0004*M1  			POP IY

04418D CD 85 23 04 0408*        call FPP ; HLH'L' = seek position from start of file in bytes less .wav header
044191 CD 6A 31 04 0409*        call SWAP
044195 21 4C 00 00 0410*        ld hl,76 ; wav header size
044199 CD B7 31 04 0411*        call hlu2float
04419D 3E 0B       0412*        ld a,fadd
04419F CD 85 23 04 0413*        call FPP ; HLH'L' = seek position from start of file in bytes
0441A3 DD 21 D2 41 0414*        ld ix,@seek_pos

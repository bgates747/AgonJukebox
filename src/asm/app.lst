043D06 2A 0A 00 07 0107*        ld hl,(bf_page_cur)
043D0A ED 5B 0D 00 0108*        ld de,(bf_dir_num_pages)
       07          
043D0F 1B          0109*        dec de ; zero-based
043D10 B7          0110*        or a ; clear carry
043D11 ED 52       0111*        sbc hl,de
043D13 3E 0A       0112*        ld a,bf_files_per_pg ; a = default number of files per page
043D15 C2 1D 3D 04 0113*        jp nz,@F ; not the last page
043D19 3A 07 00 07 0114*        ld a,(bf_files_last_pg) ; get the number of files on the last page

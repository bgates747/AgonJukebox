0470D9             0097     ; must be final include in program so file data does not stomp on program code or other data
0470D9             0098         include "files.inc"
0470D9             0001*    ; THIS MUST BE LAST INCLUDE SO FILE DATA DOES NOT OVERWRITE OTHER CODE OR DATA
0470D9             0002*    
0470D9             0003*    ; buffer for loading files unrelated to audio
0470D9             0004*    ; e.g.: fonts, sprites, etc. (limited to 8k)
0470D9             0005*    filedata: equ 0xB7E000 ; address of onboard 8k sram
0470D9             0006*    
0470D9             0007*    bf_fil_struct: equ 0x06FF00 ;
0470D9             0008*    bf_fil_obj: equ 0x06FF00 ; 15 bytes: Object identifier
0470D9             0009*    bf_fil_flag: equ 0x06FF0F ; 1 bytes: File status flags
0470D9             0010*    bf_fil_err: equ 0x06FF10 ; 1 bytes: Abort flag (error code)
0470D9             0011*    bf_fil_fptr: equ 0x06FF11 ; 4 bytes: File read/write pointer (Zeroed on file open)
0470D9             0012*    bf_fil_clust: equ 0x06FF15 ; 4 bytes: Current cluster of fpter (invalid when fptr is 0)
0470D9             0013*    bf_fil_sect: equ 0x06FF19 ; 4 bytes: Sector number appearing in buf[] (0
0470D9             0014*    bf_fil_dir_sect: equ 0x06FF1D ; 4 bytes: Sector number containing the directory entry
0470D9             0015*    bf_fil_dir_ptr: equ 0x06FF21 ; 3 bytes: Pointer to the directory entry in the win[]
0470D9             0016*    
0470D9             0017*    
0470D9             0018*    bf_struct: equ 0x070000 ; browsing song jukebox info
0470D9             0019*    bf_file_idx: equ 0x070000 ; 1 bytes: Current file index in the directory page
0470D9             0020*    bf_dir_num_files: equ 0x070001 ; 3 bytes: Number of files/directories in the directory (virtually unlimited)
0470D9             0021*    bf_files_cur_pg: equ 0x070004 ; 3 bytes: Number of files/directories of the current directory page
0470D9             0022*    bf_files_last_pg: equ 0x070007 ; 3 bytes: Number of files/directories of the last directory page
0470D9             0023*    bf_page_cur: equ 0x07000A ; 3 bytes: Current directory page number
0470D9             0024*    bf_dir_num_pages: equ 0x07000D ; 3 bytes: Number of pages in the directory (virtually unlimited)
0470D9             0025*    bf_dir_path: equ 0x070010 ; 256 bytes: Path of the current directory
0470D9             0026*    bf_struct_size: equ 512
0470D9             0027*    
0470D9             0028*    bf_dir_struct: equ 0x070200 ; browsing song directory info
0470D9             0029*    bf_dir_obj: equ 0x070200 ; 15 bytes: Object identifier
0470D9             0030*    bf_dir_dptr: equ 0x07020F ; 4 bytes: Current read/write offset
0470D9             0031*    bf_dir_clust: equ 0x070213 ; 4 bytes: Current cluster
0470D9             0032*    bf_dir_sect: equ 0x070217 ; 4 bytes: Current sector (0:Read operation has terminated)

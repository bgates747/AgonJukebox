043F65 32 00 00 07 0163*        ld (bf_file_idx),a ; reset the file index
043F69 CD 06 3D 04 0164*        call bf_get_page_num_files ; get the number of files on the new page and store it
043F6D CD D2 3D 04 0165*        call bf_highlight_file ; highlight the first file
043F71 C3 37 3E 04 0166*        jp get_input
043F75             0167*    ; end bf_prev_page
043F75             0168*    

041AB1             0262*    ; ===============================================
041AB1             0263*    ; Timer functions
041AB1             0264*    ; -----------------------------------------------
041AB1             0265*    ; set a countdown timer
041AB1             0266*    ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041AB1             0267*    ; returns: hl = current time
041AB1             0268*    tmr_set:
041AB1 FD 2F 03    0269*        ld (iy+3),hl            ; set time remaining
041AB4             0270*        MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041AB4 3E 08       0001*M1  			LD	A, function
041AB6 5B CF       0002*M1  			RST.LIL	08h
041AB8 DD 27 00    0271*        ld hl,(ix+sysvar_time)  ; get current time
041ABB FD 2F 00    0272*        ld (iy+0),hl            ; set start time
041ABE C9          0273*        ret
041ABF             0274*    
041ABF             0275*    ; gets time remaining on a countdown timer
041ABF             0276*    ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041ABF             0277*    ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041ABF             0278*    ;          sign flags: pos = time not expired,zero or neg = time expired
041ABF             0279*    tmr_get:
041ABF             0280*        MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041ABF 3E 08       0001*M1  			LD	A, function
041AC1 5B CF       0002*M1  			RST.LIL	08h
041AC3 DD 17 00    0281*        ld de,(ix+sysvar_time)  ; get current time
041AC6 FD 27 00    0282*        ld hl,(iy+0)            ; get start time
041AC9 AF          0283*        xor a                   ; clear carry
041ACA ED 52       0284*        sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041ACC FD 17 03    0285*        ld de,(iy+3)            ; get timer set value
041ACF AF          0286*        xor a                   ; clear carry
041AD0 ED 5A       0287*        adc hl,de               ; hl = time remaining
041AD2             0288*                                ; (we do adc because add hl,rr doesn't set sign or zero flags)
041AD2 C9          0289*        ret
041AD3             0290*    
041AD3             0291*    tmr_test: ds 6 ; example of a buffer to hold timer data
041AD9             0292*    
       FF FF FF FF 
       FF FF 
041AD9 00 00 00    0293*    timestamp_now: dl 0
041ADC 00 00 00    0294*    timestamp_old: dl 0
041ADF 00 00 00    0295*    timestamp_chg: dl 0
041AE2             0296*    
041AE2             0297*    ; update the global timestamp from the system clock
041AE2             0298*    ; inputs: none
041AE2             0299*    ; returns: hl = time elapsed in 1/120ths of a second
041AE2             0300*    ;          de = current time
041AE2             0301*    ;          ix = pointer to syvars table
041AE2             0302*    ; destroys: af,hl,de,ix
041AE2             0303*    timestamp_tick:
041AE2 ED 5B D9 1A 0304*        ld de,(timestamp_now)   ; get previous time
       04          
041AE7 ED 53 DC 1A 0305*        ld (timestamp_old),de   ; save previous time
       04          
041AEC             0306*        MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041AEC 3E 08       0001*M1  			LD	A, function
041AEE 5B CF       0002*M1  			RST.LIL	08h
041AF0 DD 27 00    0307*        ld hl,(ix+sysvar_time)  ; get current time
041AF3 22 D9 1A 04 0308*        ld (timestamp_now),hl   ; save current time
041AF7 AF          0309*        xor a                   ; clear carry
041AF8 ED 52       0310*        sbc hl,de               ; hl = time elapsed
041AFA 22 DF 1A 04 0311*        ld (timestamp_chg),hl   ; save elapsed time
041AFE C9          0312*        ret
041AFF             0313*    
041AFF             0314*    ; set a countdown timer
041AFF             0315*    ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041AFF             0316*    ; requires: timestamp_tick to be called at least once before this function
041AFF             0317*    ; returns: hl = current time
041AFF             0318*    ; destroys: hl
041AFF             0319*    timestamp_tmr_set:
041AFF FD 2F 03    0320*        ld (iy+3),hl            ; set time remaining
041B02 2A D9 1A 04 0321*        ld hl,(timestamp_now)   ; get current timestamp
041B06 FD 2F 00    0322*        ld (iy+0),hl            ; set start time
041B09 C9          0323*        ret
041B0A             0324*    
041B0A             0325*    ; gets time remaining on a countdown timer following the global timestamp
041B0A             0326*    ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041B0A             0327*    ; requires: timestamp_tick to be called at least once before this function
041B0A             0328*    ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041B0A             0329*    ;          sign flags: pos = time not expired,zero or neg = time expired
041B0A             0330*    ; destroys: af,hl,de
041B0A             0331*    timestamp_tmr_get:
041B0A ED 5B D9 1A 0332*        ld de,(timestamp_now)   ; get current timestamp
       04          
041B0F FD 27 00    0333*        ld hl,(iy+0)            ; get start time
041B12 AF          0334*        xor a                   ; clear carry
041B13 ED 52       0335*        sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041B15 FD 17 03    0336*        ld de,(iy+3)            ; get timer set value
041B18 AF          0337*        xor a                   ; clear carry
041B19 ED 5A       0338*        adc hl,de               ; hl = time remaining
041B1B             0339*                                ; (we do adc because add hl,rr doesn't set sign or zero flags)
041B1B C9          0340*        ret
041B1C             0341*    
041B1C             0342*    ; set a stopwatch
041B1C             0343*    ; returns: hl = start time
041B1C             0344*    ; destroys: hl,ix
041B1C             0345*    stopwatch_set:
041B1C             0346*        MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041B1C 3E 08       0001*M1  			LD	A, function
041B1E 5B CF       0002*M1  			RST.LIL	08h
041B20 DD 27 00    0347*        ld hl,(ix+sysvar_time)  ; get current time
041B23 22 38 1B 04 0348*        ld (stopwatch_started),hl            ; set start time
041B27 C9          0349*        ret
041B28             0350*    
041B28             0351*    ; gets time elapsed on a stopwatch
041B28             0352*    ; returns: hl = time elapsed in 1/120ths of a second
041B28             0353*    ; destroys: af,hl,de,ix
041B28             0354*    stopwatch_get:
041B28             0355*        MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041B28 3E 08       0001*M1  			LD	A, function
041B2A 5B CF       0002*M1  			RST.LIL	08h
041B2C DD 27 00    0356*        ld hl,(ix+sysvar_time)  ; get current time
041B2F ED 5B 38 1B 0357*        ld de,(stopwatch_started)            ; get start time
       04          
041B34 AF          0358*        xor a                   ; clear carry
041B35 ED 52       0359*        sbc hl,de               ; hl = time elapsed (will always be zero or positive)
041B37 C9          0360*        ret
041B38             0361*    
041B38             0362*    stopwatch_started: ds 3 ; buffer to hold stopwatch start time
041B3B             0363*    
041B3B             0364*    ; ------------------
041B3B             0365*    ; delay routine
041B3B             0366*    ; Author: Richard Turrnidge
041B3B             0367*    ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.asm
041B3B             0368*    ; routine waits a fixed time,then returns
041B3B             0369*    ; arrive with A =  the delay byte. One bit to be set only.
041B3B             0370*    ; eg. ld A,00000100b
041B3B             0371*    
041B3B             0372*    multiPurposeDelay:
       FF FF FF 
041B3B F5          0373*        push af
041B3C C5          0374*        push bc
041B3D DD E5       0375*        push ix
041B3F 47          0376*        ld b,a
041B40 3E 08       0377*        ld a,$08
041B42 5B CF       0378*        RST.LIL	08h                 ; get IX pointer to sysvars
041B44             0379*    
041B44             0380*    waitLoop:
041B44             0381*    
041B44 DD 7E 00    0382*        ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
041B47             0383*    
041B47             0384*                                    ;   we check if bit set is same as last time we checked.
041B47             0385*                                    ;   bit 0 - don't use
041B47             0386*                                    ;   bit 1 - changes 64 times per second
041B47             0387*                                    ;   bit 2 - changes 32 times per second
041B47             0388*                                    ;   bit 3 - changes 16 times per second
041B47             0389*    
041B47             0390*                                    ;   bit 4 - changes 8 times per second
041B47             0391*                                    ;   bit 5 - changes 4 times per second
041B47             0392*                                    ;   bit 6 - changes 2 times per second
041B47             0393*                                    ;   bit 7 - changes 1 times per second
041B47 A0          0394*        and b
041B48 4F          0395*        ld c,a
041B49 3A 5A 1B 04 0396*        ld a,(oldTimeStamp)
041B4D B9          0397*        cp c                        ; is A same as last value?
041B4E 28 F4       0398*        jr z,waitLoop              ; loop here if it is
041B50 79          0399*        ld a,c
041B51 32 5A 1B 04 0400*        ld (oldTimeStamp),a        ; set new value
041B55             0401*    
041B55 DD E1       0402*        pop ix
041B57 C1          0403*        pop bc
041B58 F1          0404*        pop af
041B59 C9          0405*        ret
041B5A             0406*    
041B5A 00          0407*    oldTimeStamp:   .db 00h

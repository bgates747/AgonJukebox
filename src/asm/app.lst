043D22             0121*    ; print the directory listing for the current directory page
043D22             0122*    ; inputs: none
043D22             0123*    ; prerequisites: bf_get_dir must have been called to populate bf_dir_fil_list
043D22             0124*    ; destroys: everything
043D22             0125*    bf_print_dir_page:
043D22             0126*    ; set text viewport for directory listing
043D22 CD D7 35 04 0127*        call vp_dir
043D26 CD E6 1B 04 0128*        call vdu_cls
043D2A             0129*    ; check for zero files in directory
043D2A 2A 01 00 07 0130*        ld hl,(bf_dir_num_files)
043D2E             0131*        SIGN_UHL
                       M1 Args: none
043D2E 19          0001*M1      add hl,de ; 1 cycle
043D2F B7          0002*M1      or a ; clear flags ; 1 cycle
043D30 ED 52       0003*M1      sbc hl,de ; 2 cycles
043D32             0004*M1      ; 4 cycles total
043D32 CA 70 3D 04 0132*        jp z,@no_files ; no files to display so update ui with page stats and return
043D36             0133*    ; set pointer to the correct index in the fileinfo pointer table
043D36 2A 0A 00 07 0134*        ld hl,(bf_page_cur) ; get the current page
043D3A 11 1E 00 00 0135*        ld de,bf_files_per_pg*3 ; number of files per page * 3 bytes per pointer
043D3E CD DC 03 04 0136*        call umul24 ; hl = page * num_files_per_page
043D42 EB          0137*        ex de,hl ; can't add ix,hl ...
043D43 DD 21 00 03 0138*        ld ix,bf_filinfo_ptrs ; get the pointer to the fileinfo pointer table
       07          
043D48 DD 19       0139*        add ix,de ; ix points to the correct index in the fileinfo pointer table
043D4A             0140*    ; loop through the fileinfo pointer table and print out the filenames
043D4A 3A 04 00 07 0141*        ld a,(bf_files_cur_pg)
043D4E 47          0142*        ld b,a ; loop counter
043D4F AF          0143*        xor a ; song index
043D50             0144*    @loop:
043D50 C5          0145*        push bc ; save loop counter
043D51 F5          0146*        push af ; save song index
043D52 CD 68 6C 04 0147*        call printHexA ; print the song index
043D56 DD 31 00    0148*        ld iy,(ix) ; iy points to filinfo struct
043D59 CD 0B 3E 04 0149*        call bf_print_dir_or_file
043D5D             0150*    @bump_counters:
043D5D ED 32 03    0151*        lea ix,ix+3 ; bump the filename pointer
043D60 F1          0152*        pop af ; restore song index
043D61 3C          0153*        inc a ; increment the song index
043D62 C1          0154*        pop bc ; restore loop counter
043D63 05          0155*        dec b
043D64 CA 83 3D 04 0156*        jp z,@done ; if zero, we're done
043D68 CD 7C 00 04 0157*        call printNewLine
043D6C C3 50 3D 04 0158*        jp @loop
043D70             0159*    @no_files:
043D70 AF          0160*        xor a ; reset the page number to zero
043D71 32 0A 00 07 0161*        ld (bf_page_cur),a
043D75 21 01 00 00 0162*        ld hl,1 ; an empty page is still a page
043D79 22 0D 00 07 0163*        ld (bf_dir_num_pages),hl
043D7D CD B8 3D 04 0164*        call bf_update_pages_ui
043D81 AF          0165*        xor a ; set zero flag indicating there were no files to display
043D82 C9          0166*        ret
043D83             0167*    @done:
043D83             0168*    ; update ui and return to caller
043D83 CD B8 3D 04 0169*        call bf_update_pages_ui
043D87 F6 01       0170*        or a,1 ; reset zero flag indicating there were files to display
043D89 C9          0171*        ret
043D8A             0172*    ; end bf_print_dir_page
043D8A             0173*    
043D8A             0174*    ; print the entire directory (for debugging, not in-app use)
043D8A             0175*    ; inputs: none
043D8A             0176*    ; prerequisites: bf_get_dir must have been called to populate bf_dir_fil_list
043D8A             0177*    ; destroys: everything
043D8A             0178*    bf_print_dir:

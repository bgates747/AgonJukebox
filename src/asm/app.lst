0404B3             0223*    
0404B3             0224*    ;------------------------------------------------------------------------
0404B3             0225*    ; shr_hlu_div: Quick division by powers of two based on log2 of A
0404B3             0226*    ;              Determines the LSB of A and shifts HLU accordingly.
0404B3             0227*    ;              HLU = HLU >> LSB(A)
0404B3             0228*    ; Returns: HLU = HLU >> LSB(A)
0404B3             0229*    ; Destroys: af
0404B3             0230*    ;------------------------------------------------------------------------
0404B3             0231*    shr_hlu_log2a:
0404B3 B7          0232*    	or a    ; check for zero
0404B4 C8          0233*    	ret z   ; nothing to shift so we're done
0404B5 C5          0234*    	push 	bc ; preserve
0404B6 06 00       0235*    	ld		b,0 ; clear b
0404B8             0236*    @find_bit:
0404B8 0F          0237*    	rrca ; bit 0 to carry
0404B9 DA C2 04 04 0238*    	jp c,@found_bit
0404BD 04          0239*    	inc b ; next bit
0404BE C3 B8 04 04 0240*    	jp @find_bit
0404C2             0241*    @found_bit:
0404C2 78          0242*    	ld a,b
0404C3 CD 90 04 04 0243*    	call shr_hlu
0404C7 C1          0244*    	pop 	bc ; restore
0404C8 C9          0245*    	ret
0404C9             0246*    ; end shr_hlu_log2a
0404C9             0247*    
0404C9             0248*    ;------------------------------------------------------------------------
0404C9             0249*    ; shl_hlu_log2a: Quick multiplication by powers of two based on log2 of A
0404C9             0250*    ;                Determines the LSB of A and shifts HLU accordingly.
0404C9             0251*    ;                HLU = HLU << LSB(A)
0404C9             0252*    ; Returns: HLU = HLU << LSB(A)
0404C9             0253*    ; Destroys: af
0404C9             0254*    ;------------------------------------------------------------------------
0404C9             0255*    shl_hlu_log2a:
0404C9 B7          0256*    	or a    ; check for zero
0404CA C8          0257*    	ret z   ; nothing to shift so we're done
0404CB C5          0258*    	push 	bc ; preserve
0404CC 06 00       0259*    	ld		b,0 ; clear b
0404CE             0260*    @find_bit:
0404CE 0F          0261*    	rrca ; bit 0 to carry
0404CF DA D8 04 04 0262*    	jp c,@found_bit
0404D3 04          0263*    	inc b ; next bit
0404D4 C3 CE 04 04 0264*    	jp @find_bit
0404D8             0265*    @found_bit:
0404D8 78          0266*    	ld a,b
0404D9 CD 8A 04 04 0267*    	call shl_hlu
0404DD C1          0268*    	pop 	bc ; restore
0404DE C9          0269*    	ret
0404DF             0270*    ; end shl_hlu_log2a
0404DF             0271*    
0404DF             0272*    
0404DF             0273*    ; UHL / UDE --> UDE (signed), remainder UHL (unsigned)
0404DF F5          0274*    push af ; dummy push to make IDE happy
0404E0             0275*    sdiv24:
0404E0             0276*    ; make everything positive and store sign flags
0404E0 CD 0D 05 04 0277*        call hlu_abs
0404E4 F5          0278*        push af
0404E5 EB          0279*        ex de,hl
0404E6 CD 0D 05 04 0280*        call hlu_abs
0404EA EB          0281*        ex de,hl
0404EB F5          0282*        push af
0404EC             0283*    ; do the division
0404EC CD F5 03 04 0284*        call udiv24 ; de = quotient, hl = remainder
0404F0             0285*    ; adjust sign of result
0404F0 F1          0286*        pop af ; sign de
0404F1 FA FE 04 04 0287*        jp m,@de_neg
0404F5 F1          0288*        pop af ; sign hl
0404F6 F0          0289*        ret p ; both positive, nothing to do
0404F7             0290*    @hl_neg:
0404F7 EB          0291*        ex de,hl ; quotient to hl for sign adjustment
0404F8 CD 1D 05 04 0292*        call neg_hlu ; de pos, hl neg, result is negative
0404FC EB          0293*        ex de,hl ; negated quotient to de
0404FD C9          0294*        ret
0404FE             0295*    @de_neg:
0404FE F1          0296*        pop af
0404FF F8          0297*        ret m ; both negative, nothing to do
040500 EB          0298*        ex de,hl ; quotient to hl for sign adjustment
040501 CD 1D 05 04 0299*        call neg_hlu ; result is negative
040505 EB          0300*        ex de,hl ; negated quotient to de
040506 C9          0301*        ret
040507             0034         include "maths.inc"
040507             0001*    ;------------------------------------------------------------------------
040507             0002*    ; Scratch area for calculations
040507             0003*    ;------------------------------------------------------------------------
040507 00 00 00    0004*    scratch1: dw24 0 ;bit manipulation buffer 1
04050A 00 00 00    0005*    scratch2: dw24 0 ;bit manipulation buffer 2
04050D             0006*    
04050D             0007*    ; absolute value of hlu
04050D             0008*    ; returns: abs(hlu), flags set according to the incoming sign of hlu:
04050D             0009*    ;         s1,z0,pv0,n1,c0 if hlu was negative
04050D             0010*    ;         s0,z1,pv0,n1,c0 if hlu was zero
04050D             0011*    ;         s0,z0,pv0,n1,c0 if hlu was positive
04050D             0012*    ; destroys: a
04050D             0013*    hlu_abs:
04050D 19          0014*        add hl,de
04050E B7          0015*        or a
04050F ED 52       0016*        sbc hl,de
040511 FA 16 05 04 0017*        jp m,@is_neg
040515 C9          0018*        ret ; hlu is positive or zero so we're done
040516             0019*    @is_neg:
040516 F5          0020*        push af ; otherwise, save current flags for return
040517 CD 1D 05 04 0021*        call neg_hlu ; negate hlu
04051B F1          0022*        pop af ; get back flags
04051C C9          0023*        ret
04051D             0024*    
04051D             0025*    ; flip the sign of hlu
04051D             0026*    ; inputs: hlu
04051D             0027*    ; returns: 0-hlu, flags set appropriately for the result:
04051D             0028*    ;         s1,z0,pv0,n1,c1 if result is negative
04051D             0029*    ;         s0,z1,pv0,n1,c0 if result is zero
04051D             0030*    ;         s0,z0,pv0,n1,c1 if result is positive
04051D             0031*    ; destroys a
04051D             0032*    neg_hlu:
04051D D5          0033*        push de ; save de
04051E EB          0034*        ex de,hl ; put hl into de
04051F 21 00 00 00 0035*        ld hl,0 ; clear hl
040523 AF          0036*        xor a ; clear carry
040524 ED 52       0037*        sbc hl,de ; 0-hlu = -hlu
040526 D1          0038*        pop de ; get de back
040527 C9          0039*        ret ; easy peasy
040528             0040*    
040528             0041*    ;------------------------------------------------------------------------
040528             0042*    ; divide hlu by 2, inspired by above
040528             0043*    ;------------------------------------------------------------------------
040528             0044*    hlu_div2:
040528 22 07 05 04 0045*        ld (scratch1),hl
04052C 21 09 05 04 0046*        ld hl,scratch1+2
040530 CB 1E       0047*        rr (hl)
040532 2B          0048*        dec hl
040533 CB 1E       0049*        rr (hl)
040535 2B          0050*        dec hl
040536 CB 1E       0051*        rr (hl)
040538 23          0052*        inc hl
040539 23          0053*        inc hl
04053A 2A 07 05 04 0054*        ld hl,(scratch1)
04053E C9          0055*        ret
04053F             0056*    
04053F             0057*    ; this is my little hack to divide by 16
04053F             0058*    hlu_div16:
04053F AF          0059*        xor a
040540 29          0060*        add hl,hl
040541 17          0061*        rla
040542 29          0062*        add hl,hl
040543 17          0063*        rla
040544 29          0064*        add hl,hl
040545 17          0065*        rla
040546 29          0066*        add hl,hl
040547 17          0067*        rla
040548 22 55 05 04 0068*        ld (@scratch),hl
04054C 32 58 05 04 0069*        ld (@scratch+3),a
040550 2A 56 05 04 0070*        ld hl,(@scratch+1)
040554 C9          0071*        ret
040555             0072*    @scratch: ds 4
040559             0073*    
040559             0074*    ; hlu signed division by 256
040559             0075*    ; returns: hlu / 256
040559             0076*    ; destroys: af
040559             0077*    hlu_sdiv256:
       FF FF FF FF 
040559 AF          0078*        xor a ; assume hl is positive
04055A 22 70 05 04 0079*        ld (@buffer),hl
04055E             0080*        SIGN_UHL
                       M1 Args: none
04055E 19          0001*M1      add hl,de ; 1 cycle
04055F B7          0002*M1      or a ; clear flags ; 1 cycle
040560 ED 52       0003*M1      sbc hl,de ; 2 cycles
040562             0004*M1      ; 4 cycles total
040562 F2 67 05 04 0081*        jp p,@hl_pos
040566 3D          0082*        dec a
040567             0083*    @hl_pos:
040567 32 73 05 04 0084*        ld (@buffer+3),a
04056B 2A 71 05 04 0085*        ld hl,(@buffer+1)
04056F C9          0086*        ret
040570             0087*    @buffer: ds 4
040574             0088*    
040574             0089*    ; hlu 1 byte right shift, unsigned
040574             0090*    ; returns: hlu / 256, fractional portion in a
040574             0091*    ; destroys: af
040574             0092*    hlu_udiv256:
       FF FF FF FF 
040574 AF          0093*        xor a
040575 32 86 05 04 0094*        ld (@buffer+3),a
040579 7D          0095*        ld a,l ; save the fractional portion
04057A 22 83 05 04 0096*        ld (@buffer),hl
04057E 2A 84 05 04 0097*        ld hl,(@buffer+1)
040582 C9          0098*        ret
040583             0099*    @buffer: ds 4
040587             0100*    
040587             0101*    ; floor(value,n)
040587             0102*    ; inputs: hl = value to floor, de = n
040587             0103*    ; outputs: hl = value floored to n
040587             0104*    ; destroys: af, hl, bc, de
040587             0105*    hlu_floor:
       FF FF FF FF 
040587 D5          0106*        push de ; save n
040588 CD F5 03 04 0107*        call udiv24 ; de = quotient, hl = remainder
04058C E1          0108*        pop hl ; get n back (was de)
04058D CD DC 03 04 0109*        call umul24 ; hl = n * quotient
040591 C9          0110*        ret
040592             0111*    ; end hlu_floor
040592             0112*    
040592             0113*    ; ceil(value,n)
040592             0114*    ; inputs: hl = value to ceil, de = n
040592             0115*    ; outputs: hl = value ceiled to n
040592             0116*    ; destroys: af, hl, bc, de
040592             0117*    hlu_ceiling:
040592 D5          0118*        push de ; save n
040593 CD F5 03 04 0119*        call udiv24 ; de = quotient, hl = remainder
040597             0120*        SIGN_UHL ; test remaider for zero
                       M1 Args: none
040597 19          0001*M1      add hl,de ; 1 cycle
040598 B7          0002*M1      or a ; clear flags ; 1 cycle
040599 ED 52       0003*M1      sbc hl,de ; 2 cycles
04059B             0004*M1      ; 4 cycles total
04059B CA A0 05 04 0121*        jp z,@F ; if zero, nothing to add
04059F 13          0122*        inc de ; add 1 to quotient for the ceiling
0405A0             0123*    @@:
0405A0 E1          0124*        pop hl ; get n back (was de)
0405A1 CD DC 03 04 0125*        call umul24 ; hl = n * quotient
0405A5 C9          0126*        ret
0405A6             0127*    ; end hlu_ceiling
0405A6             0128*    
0405A6 C9          0129*        ret
0405A7             0130*    
0405A7 00 00 00 00 0131*    add_bcd_arg1: db #00,#00,#00,#00
0405AB 00 00 00 00 0132*    add_bcd_arg2: db #00,#00,#00,#00
0405AF             0133*    
0405AF             0134*    ; set bcd values in a scratch memory address from registers bcde
0405AF             0135*    ; input: hl; scratch address,bcde; 8-place bcd number
0405AF             0136*    ; destroys ; hl
0405AF             0137*    set_bcd:
0405AF 73          0138*        ld (hl),e
0405B0 23          0139*        inc hl
0405B1 72          0140*        ld (hl),d
0405B2 23          0141*        inc hl
0405B3 71          0142*        ld (hl),c
0405B4 23          0143*        inc hl
0405B5 70          0144*        ld (hl),b
0405B6 C9          0145*        ret
0405B7             0146*    
0405B7             0147*    ; load bcd values from a scratch memory address to bcde
0405B7             0148*    ; input: hl; scratch address
0405B7             0149*    ; output: bcde; 8-place bcd number
0405B7             0150*    ; destroys: hl
0405B7             0151*    get_bcd:
0405B7 5E          0152*        ld e,(hl)
0405B8 23          0153*        inc hl
0405B9 56          0154*        ld d,(hl)
0405BA 23          0155*        inc hl
0405BB 4E          0156*        ld c,(hl)
0405BC 23          0157*        inc hl
0405BD 46          0158*        ld b,(hl)
0405BE C9          0159*        ret
0405BF             0160*    
0405BF             0161*    ; BCD addition
0405BF             0162*    ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
0405BF             0163*    ;       a is the number of bytes holding each number (number of places/2)
0405BF             0164*    ; outputs: (hl) + (de) --> (hl)
0405BF             0165*    ; destroys: a,b,de,hl
0405BF             0166*    add_bcd:
0405BF 47          0167*        ld b,a ; loop counter
0405C0 AF          0168*        xor a ; reset a, clear carry flag
0405C1             0169*    adcec:
0405C1 1A          0170*        ld a,(de) ; addend to acc
0405C2 8E          0171*        adc a,(hl) ; add (hl) to acc
0405C3 27          0172*        daa ; adjust result to bcd
0405C4 77          0173*        ld (hl),a ; store result
0405C5 23          0174*        inc hl ; advance memory pointers
0405C6 13          0175*        inc de
0405C7 10 F8       0176*        djnz adcec ; loop until b == 0
0405C9 C9          0177*        ret
0405CA             0178*    
0405CA             0179*    ; BCD subtraction
0405CA             0180*    ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
0405CA             0181*    ;       a is the number of bytes holding each number (number of places/2)
0405CA             0182*    ; outputs: (hl) - (de) --> (hl)
0405CA             0183*    ; destroys: a,b,de,hl
0405CA             0184*    sub_bcd:
0405CA 47          0185*        ld b,a ; loop counter
0405CB AF          0186*        xor a ; reset a,clear carry flag
0405CC             0187*    subdec:
0405CC 1A          0188*        ld a,(de) ; subtrahend to acc
0405CD 9E          0189*        sbc a,(hl) ; subtract (hl) from acc
0405CE 27          0190*        daa ; adjust result to bcd
0405CF 77          0191*        ld (hl),a ; store result
0405D0 23          0192*        inc hl ; advance memory pointers
0405D1 13          0193*        inc de
0405D2 10 F8       0194*        djnz subdec ; loop until b == 0
0405D4 C9          0195*        ret
0405D5             0196*    
0405D5             0197*    ; http://www.z80.info/pseudo-random.txt
0405D5             0198*    rand_8:
0405D5 C5          0199*        push bc
0405D6 3A E9 05 04 0200*        ld a,(r_seed)
0405DA 4F          0201*        ld c,a
0405DB             0202*    
0405DB 0F          0203*        rrca ; multiply by 32
0405DC 0F          0204*        rrca
0405DD 0F          0205*        rrca
0405DE EE 1F       0206*        xor 0x1f
0405E0             0207*    
0405E0 81          0208*        add a,c
0405E1 DE FF       0209*        sbc a,255 ; carry
0405E3             0210*    
0405E3 32 E9 05 04 0211*        ld (r_seed),a
0405E7 C1          0212*        pop bc
0405E8 C9          0213*        ret
0405E9 50          0214*    r_seed: defb $50
0405EA             0215*    
0405EA             0216*    ; https://www.omnimaga.org/asm-language/ez80-optimized-routines/msg399325/#msg399325
0405EA             0217*    prng24:
0405EA             0218*    ;;Expects ADL mode.
0405EA             0219*    ;;Output: HL
0405EA             0220*    ;;50cc
0405EA             0221*    ;;33 bytes
0405EA             0222*    ;;cycle length: 281,474,959,933,440 (about 2.8 trillion)
0405EA ED 5B 0B 06 0223*        ld de,(seed1)
       04          
0405EF B7          0224*        or a
0405F0 ED 62       0225*        sbc hl,hl
0405F2 19          0226*        add hl,de
0405F3 29          0227*        add hl,hl
0405F4 29          0228*        add hl,hl
0405F5 2C          0229*        inc l
0405F6 19          0230*        add hl,de
0405F7 22 0B 06 04 0231*        ld (seed1),hl
0405FB 2A 0E 06 04 0232*        ld hl,(seed2)
0405FF 29          0233*        add hl,hl
040600 9F          0234*        sbc a,a
040601 E6 1B       0235*        and %00011011
040603 AD          0236*        xor l
040604 6F          0237*        ld l,a
040605 22 0E 06 04 0238*        ld (seed2),hl
040609 19          0239*        add hl,de
04060A C9          0240*        ret
04060B 00 00 00    0241*    seed1: dl 0
04060E 00 00 00    0242*    seed2: dl 0
040611             0243*    
040611             0244*    
040611             0245*    ; https://map.grauw.nl/sources/external/z80bits.html#2.1
040611             0246*    ; h / l -> h, remain a
040611             0247*    ; 2.1 Restoring 8-bit / 8-bit Unsigned
040611             0248*    ; Input: H = Dividend, L = Divisor, A = 0
040611             0249*    ; Output: H = Quotient, A = Remainder, L = Divisor (unchanged)
040611             0250*    udiv8:
040611 AF          0251*        xor a
040612 06 08       0252*        ld b,8
040614             0253*    @loop:
040614 CB 24       0254*        sla h
040616 17          0255*        rla
040617 BD          0256*        cp l
040618 38 02       0257*        jr c,$+4
04061A 95          0258*        sub l
04061B 24          0259*        inc h
04061C 10 F6       0260*        djnz @loop
04061E C9          0261*        ret
04061F             0262*    
04061F             0263*    ; https://www.omnimaga.org/asm-language/(z80)-32-bit-by-16-bits-division-and-32-bit-square-root/msg406903/#msg406903
04061F             0264*    ; This divides HLIX by BC
04061F             0265*    ; The result is stored in HLIX, the remainder in DE
04061F             0266*    ; BC is unmodified
04061F             0267*    ; A is 0
04061F             0268*    udiv3216:
04061F 11 00 00 00 0269*        ld de,0		; 10
040623 3E 20       0270*        ld a,32		; 7
040625             0271*    @loop:
040625 52 DD 29    0272*        add.s ix,ix		; 15
040628 52 ED 6A    0273*        adc.s hl,hl		; 15
04062B EB          0274*        ex de,hl		; 4
04062C 52 ED 6A    0275*        adc.s hl,hl		; 15
04062F B7          0276*        or a			; 4
040630 52 ED 42    0277*        sbc.s hl,bc		; 15
040633 52 DD 23    0278*        inc.s ix		; 10
040636 30 05       0279*        jr nc,@cansub		; 12/7
040638 52 09       0280*        add.s hl,bc		; 11
04063A 52 DD 2B    0281*        dec.s ix		; 10
04063D             0282*    @cansub:
04063D EB          0283*        ex de,hl		; 4
04063E 3D          0284*        dec a		; 4
04063F 20 E4       0285*        jr nz,@loop	; 12/7
040641 C9          0286*        ret			; 10
040642             0287*    ; end udiv3216
040642             0288*    
040642             0289*    ; https://discord.com/channels/1158535358624039014/1282290921815408681/1329274504022720512
040642             0290*    ; calc84maniac's 32-bit by 23-bit division routine
040642             0291*    ; This divides AUIX by UDE (maximum 23 bits)
040642             0292*    ; The result is stored in AUIX, the remainder in UHL
040642             0293*    ; UDE, C are unmodified
040642             0294*    ; B is 0
040642             0295*    udiv3223:
040642 B7          0296*        or a,a         ; 1
040643 ED 62       0297*        sbc hl,hl      ; 2
040645 06 20       0298*        ld b,32        ; 2
040647             0299*    @loop:
040647 DD 29       0300*        add ix,ix      ; 2
040649 8F          0301*        adc a,a        ; 1
04064A ED 6A       0302*        adc hl,hl      ; 2
04064C ED 52       0303*        sbc hl,de      ; 2
04064E DD 23       0304*        inc ix         ; 2
040650 30 03       0305*        jr nc,@cansub  ; 2/4
040652 19          0306*        add hl,de      ; 1
040653 DD 2B       0307*        dec ix         ; 2
040655             0308*    @cansub:
040655 10 F0       0309*        djnz @loop     ; 2/4
040657 C9          0310*        ret            ; 10
040658             0311*    ; end udiv3223
040658             0312*    
040658             0313*    ; calc84maniac https://discord.com/channels/1158535358624039014/1282290921815408681/1330991583369101322
040658             0314*    ; add uhl to signed integer a
040658             0315*    add_uhl_a_signed:
040658 D5          0316*        push de    ; 4 cycles
040659 EB          0317*        ex de, hl  ; 1 cycle  UDE = UHL
04065A 07          0318*        rlca       ; 1 cycle  CF = signbit(A)
04065B ED 62       0319*        sbc hl, hl ; 2 cycles UHL = -signbit(A)
04065D 0F          0320*        rrca       ; 1 cycle  Restore A
04065E 6F          0321*        ld l, a    ; 1 cycle  UHL = signext(A)
04065F 19          0322*        add hl, de ; 1 cycle  UHL = UDE + signext(A)
040660 D1          0323*        pop de     ; 4 cycles
040661             0324*                   ; 15 cycles total
040661 C9          0325*        ret
040662             0326*    ; end hlu_add_a_signed

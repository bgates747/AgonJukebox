043FA9 21 00 FF 06 0197*        ld hl,bf_fil_struct ; hl = pointer to fil struct
043FAD ED 13 16    0198*        lea de,iy+filinfo_fname ; de = pointer to filename
043FB0 CD BD 6B 04 0199*        call bf_verify_wav
043FB4 ED 23 16    0200*        lea hl,iy+filinfo_fname ; hl = pointer to filename
043FB7 CA 7C 3F 04 0201*        jp z,bf_change_dir ; not a .wav file, so must be a directory
043FBB             0202*    ; play the .wav file

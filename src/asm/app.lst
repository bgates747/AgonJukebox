0402E3             0479*    
0402E3             0480*    ; print the binary representation of the 8-bit value in a
0402E3             0481*    ; destroys a, hl, bc
0402E3             0482*    printBin8:
0402E3 06 08       0483*        ld b,8 ; loop counter for 8 bits
0402E5 21 00 03 04 0484*        ld hl,@cmd ; set hl to the low byte of the output string
0402E9             0485*        ; (which will be the high bit of the value in a)
0402E9             0486*    @loop:
0402E9 07          0487*        rlca ; put the next highest bit into carry
0402EA 38 04       0488*        jr c,@one
0402EC 36 30       0489*        ld (hl),'0'
0402EE 18 02       0490*        jr @next_bit
0402F0             0491*    @one:
0402F0 36 31       0492*        ld (hl),'1'
0402F2             0493*    @next_bit:
0402F2 23          0494*        inc hl
0402F3 10 F4       0495*        djnz @loop
0402F5             0496*    ; print it
0402F5 21 00 03 04 0497*        ld hl,@cmd
0402F9 01 08 00 00 0498*        ld bc,@end-@cmd
0402FD 5B DF       0499*        rst.lil $18
0402FF C9          0500*        ret
040300             0501*    @cmd: ds 8 ; eight bytes for eight bits
040308             0502*    @end:
040308             0503*    
040308             0504*    ; print the binary representation of the 8-bit value in a
040308             0505*    ; in reverse order (lsb first)
040308             0506*    ; destroys a, hl, bc
040308             0507*    printBin8Rev:
       FF FF FF FF 
       FF FF FF FF 
040308 06 08       0508*        ld b,8 ; loop counter for 8 bits
04030A 21 25 03 04 0509*        ld hl,@cmd ; set hl to the low byte of the output string
04030E             0510*        ; (which will be the high bit of the value in a)
04030E             0511*    @loop:
04030E 0F          0512*        rrca ; put the next lowest bit into carry
04030F 38 04       0513*        jr c,@one
040311 36 30       0514*        ld (hl),'0'
040313 18 02       0515*        jr @next_bit
040315             0516*    @one:
040315 36 31       0517*        ld (hl),'1'
040317             0518*    @next_bit:
040317 23          0519*        inc hl
040318 10 F4       0520*        djnz @loop
04031A             0521*    ; print it
04031A 21 25 03 04 0522*        ld hl,@cmd
04031E 01 08 00 00 0523*        ld bc,@end-@cmd
040322 5B DF       0524*        rst.lil $18
040324 C9          0525*        ret
040325             0526*    @cmd: ds 8 ; eight bytes for eight bits
04032D             0527*    @end:

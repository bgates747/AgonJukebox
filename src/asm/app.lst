041BEF 01 03 00 00 0156*    	ld bc,@end-@cmd
041BF3 5B DF       0157*    	rst.lil $18
041BF5 C9          0158*    	ret
041BF6 17 00 C3    0159*    @cmd: db 23,0,0xC3
041BF9             0160*    @end:
041BF9             0161*    
041BF9             0162*    ; VDU 16: Clear graphics area (CLG)
041BF9             0163*    vdu_clg:
041BF9 3E 10       0164*        ld a,16
041BFB 5B D7       0165*    	rst.lil $10
041BFD C9          0166*    	ret
041BFE             0167*    
041BFE             0168*    ; https://github.com/breakintoprogram/agon-docs/wiki/VDP
041BFE             0169*    ; VDU 23, 7: Scrolling
041BFE             0170*    ;     VDU 23, 7, extent, direction, speed: Scroll the screen
041BFE             0171*    ; inputs: a, extent; l, direction; h; speed
041BFE             0172*    vdu_scroll_down:
041BFE 32 13 1C 04 0173*    	ld (@extent),a
041C02 22 14 1C 04 0174*    	ld (@dir),hl ; implicitly populates @speed
041C06 21 11 1C 04 0175*    	ld hl,@cmd
041C0A 01 05 00 00 0176*    	ld bc,@end-@cmd
041C0E 5B DF       0177*    	rst.lil $18     ;; Sending command to VDP
041C10 C9          0178*    	ret
041C11 17 07       0179*    @cmd:       db 23,7
041C13 00          0180*    @extent:    db 0x00 ; 0 current text window, 1 entire screen, 2 curr gfx viewport
041C14 00          0181*    @dir:       db 0x00 ; 0 right, 1 left, 2 down, 3 up
041C15 00          0182*    @speed:     db 0x00 ; pixels
041C16 00          0183*    @end:		db 0x00 ; padding
041C17             0184*    
041C17             0185*    ; COLOUR MODES
041C17             0186*    ; Mode	Effect
041C17             0187*    ; 0	Set on-screen pixel to target colour value
041C17             0188*    ; 1	OR value with the on-screen pixel
041C17             0189*    ; 2	AND value with the on-screen pixel
041C17             0190*    ; 3	XOR value with the on-screen pixel
041C17             0191*    ; 4	Invert the on-screen pixel
041C17             0192*    ; 5	No operation
041C17             0193*    ; 6	AND the inverse of the specified colour with the on-screen pixel
041C17             0194*    ; 7	OR the inverse of the specified colour with the on-screen pixel
041C17             0195*    
041C17             0196*    ; VDU 17, colour: Define text colour (COLOUR)
041C17             0197*    vdu_colour_text:
041C17 32 27 1C 04 0198*    	ld (@arg),a
041C1B 21 26 1C 04 0199*    	ld hl,@cmd
041C1F 01 02 00 00 0200*    	ld bc,@end-@cmd
041C23 5B DF       0201*    	rst.lil $18
041C25 C9          0202*    	ret
041C26 11          0203*    @cmd: db 17
041C27 00          0204*    @arg: db 0
041C28             0205*    @end:
041C28             0206*    
041C28             0207*    ; VDU 18, mode, colour: Set graphics colour (GCOL mode, colour)
041C28             0208*    ; inputs: a=mode, c=colour (add 128 to set background colour)
041C28             0209*    vdu_gcol:
041C28 32 3D 1C 04 0210*    	ld (@mode),a
041C2C 79          0211*        ld a,c
041C2D 32 3E 1C 04 0212*        ld (@col),a
041C31 21 3C 1C 04 0213*    	ld hl,@cmd
041C35 01 03 00 00 0214*    	ld bc,@end-@cmd
041C39 5B DF       0215*    	rst.lil $18
041C3B C9          0216*    	ret
041C3C 12          0217*    @cmd:  db 18
041C3D 00          0218*    @mode: db 0
041C3E 00          0219*    @col:  db 0
041C3F             0220*    @end:
041C3F             0221*    
041C3F             0222*    
041C3F             0223*    ; VDU 28, left, bottom, right, top: Set text viewport **
041C3F             0224*    ; MIND THE LITTLE-ENDIANESS
041C3F             0225*    ; inputs: c=left,b=bottom,e=right,d=top
041C3F             0226*    ; outputs; nothing
041C3F             0227*    ; destroys: af, hl, bc, de
041C3F             0228*    vdu_set_txt_viewport:
041C3F ED 43 55 1C 0229*        ld (@lb),bc
       04          
041C44 ED 53 57 1C 0230*    	ld (@rt),de
       04          
041C49 21 54 1C 04 0231*    	ld hl,@cmd
041C4D 01 05 00 00 0232*    	ld bc,@end-@cmd
041C51 5B DF       0233*    	rst.lil $18
041C53 C9          0234*    	ret
041C54 1C          0235*    @cmd:   db 28 ; set text viewport command
041C55 00 00       0236*    @lb: 	dw 0x0000 ; set by bc
041C57 00 00       0237*    @rt: 	dw 0x0000 ; set by de
041C59 00          0238*    @end:   db 0x00	  ; padding
041C5A             0239*    
041C5A             0240*    ; Wait for VBLANK interrupt
041C5A             0241*    vdu_vblank:
041C5A DD E5       0242*        PUSH 	IX
041C5C             0243*    	MOSCALL	mos_sysvars
                       M1 Args: function=mos_sysvars 
041C5C 3E 08       0001*M1  			LD	A, function
041C5E 5B CF       0002*M1  			RST.LIL	08h
041C60 DD 7E 00    0244*    	LD	A, (IX + sysvar_time + 0)
041C63             0245*    @wait:
041C63 DD BE 00    0246*        CP 	A, (IX + sysvar_time + 0)
041C66 28 FB       0247*        JR	Z, @wait
041C68 DD E1       0248*        POP	IX
041C6A C9          0249*        RET
041C6B             0250*    
041C6B             0251*    ; VDU 29, x; y;: Set graphics origin
041C6B             0252*    ; This command sets the graphics origin.
041C6B             0253*    ; The origin is the point on the screen where the coordinates (0,0) are located.
041C6B             0254*    ; inputs: bc=x0,de=y0
041C6B             0255*    ; outputs; nothing
041C6B             0256*    ; destroys: a might make it out alive
041C6B             0257*    vdu_set_gfx_origin:
041C6B ED 43 81 1C 0258*        ld (@x0),bc
       04          
041C70 ED 53 83 1C 0259*        ld (@y0),de
       04          
041C75 21 80 1C 04 0260*        ld hl,@cmd
041C79 01 05 00 00 0261*        ld bc,@end-@cmd
041C7D 5B DF       0262*        rst.lil $18
041C7F C9          0263*        ret
041C80 1D          0264*    @cmd:   db 29 ; set graphics origin command
041C81 00 00       0265*    @x0: 	dw 0x0000 ; set by bc
041C83 00 00       0266*    @y0: 	dw 0x0000 ; set by de
041C85 00          0267*    @end:   db 0x00	  ; padding
041C86             0268*    
041C86             0269*    ; VDU 24, left; bottom; right; top;: Set graphics viewport
041C86             0270*    ; NOTE: the order of the y-coordinate parameters are inverted
041C86             0271*    ; 	because we have turned off logical screen scaling
041C86             0272*    ; NOTE: coordinates are relative to current gfx origin
041C86             0273*    ; inputs: bc=x0,de=y0,ix=x1,iy=y1
041C86             0274*    ; outputs; nothing
041C86             0275*    ; destroys: a might make it out alive
041C86             0276*    vdu_set_gfx_viewport:
041C86 ED 43 A6 1C 0277*        ld (@x0),bc
       04          
041C8B FD 22 A8 1C 0278*        ld (@y1),iy
       04          
041C90 DD 22 AA 1C 0279*    	ld (@x1),ix
       04          
041C95 ED 53 AC 1C 0280*    	ld (@y0),de
       04          
041C9A 21 A5 1C 04 0281*    	ld hl,@cmd
041C9E 01 09 00 00 0282*    	ld bc,@end-@cmd
041CA2 5B DF       0283*    	rst.lil $18
041CA4 C9          0284*    	ret
041CA5 18          0285*    @cmd:   db 24 ; set graphics viewport command
041CA6 00 00       0286*    @x0: 	dw 0x0000 ; set by bc
041CA8 00 00       0287*    @y1: 	dw 0x0000 ; set by iy
041CAA 00 00       0288*    @x1: 	dw 0x0000 ; set by ix
041CAC 00 00       0289*    @y0: 	dw 0x0000 ; set by de
041CAE 00          0290*    @end:   db 0x00	  ; padding
041CAF             0291*    
041CAF             0292*    ; VDU 26: Reset graphics and text viewports
041CAF             0293*    vdu_reset_viewports:
041CAF 3E 1A       0294*        ld a,26
041CB1 5B D7       0295*        rst.lil $10
041CB3 C9          0296*        ret
041CB4             0297*    
041CB4             0298*    ; SCREEN MODES
041CB4             0299*    ; ===============================
041CB4             0300*    ; Mode  Horz  Vert  Cols  Refresh
041CB4             0301*    ; ---   ----  ----  ----  -------
041CB4             0302*    ; 11    320   240   2     60hz
041CB4             0303*    ; 139   320   240   2     60hz
041CB4             0304*    ; 23    512   384   2     60hz
041CB4             0305*    ; 151   512   384   2     60hz
041CB4             0306*    ; 6     640   240   2     60hz
041CB4             0307*    ; 134   640   240   2     60hz
041CB4             0308*    ; 2     640   480   2     60hz
041CB4             0309*    ; 130   640   480   2     60hz
041CB4             0310*    ; 17    800   600   2     60hz
041CB4             0311*    ; 145   800   600   2     60hz
041CB4             0312*    ; 18    1024  768   2     60hz
041CB4             0313*    ; 146   1024  768   2     60hz
041CB4             0314*    ; ---   ----  ----  ----  -------
041CB4             0315*    ; 10    320   240   4     60hz
041CB4             0316*    ; 138   320   240   4     60hz
041CB4             0317*    ; 22    512   384   4     60hz
041CB4             0318*    ; 150   512   384   4     60hz
041CB4             0319*    ; 5     640   240   4     60hz
041CB4             0320*    ; 133   640   240   4     60hz
041CB4             0321*    ; 1     640   480   4     60hz
041CB4             0322*    ; 129   640   480   4     60hz
041CB4             0323*    ; 16    800   600   4     60hz
041CB4             0324*    ; 19    1024  768   4     60hz
041CB4             0325*    ; ---   ----  ----  ----  -------
041CB4             0326*    ; 9     320   240   16    60hz
041CB4             0327*    ; 137   320   240   16    60hz
041CB4             0328*    ; 21    512   384   16    60hz
041CB4             0329*    ; 149   512   384   16    60hz
041CB4             0330*    ; 4     640   240   16    60hz
041CB4             0331*    ; 132   640   240   16    60hz
041CB4             0332*    ; 0     640   480   16    60hz
041CB4             0333*    ; 7     n/a   n/a   16    60hz
041CB4             0334*    ; ---   ----  ----  ----  -------
041CB4             0335*    ; 8     320   240   64    60hz
041CB4             0336*    ; 136   320   240   64    60hz
041CB4             0337*    ; 20    512   384   64    60hz
041CB4             0338*    ; 3     640   240   64    60hz
041CB4             0339*    ; ---   ----  ----  ----  -------
041CB4             0340*    vdu_set_screen_mode:
041CB4 32 C4 1C 04 0341*    	ld (@arg),a
041CB8 21 C3 1C 04 0342*    	ld hl,@cmd
041CBC 01 02 00 00 0343*    	ld bc,@end-@cmd
041CC0 5B DF       0344*    	rst.lil $18
041CC2 C9          0345*    	ret
041CC3 16          0346*    @cmd: db 22 ; set screen mode
041CC4 00          0347*    @arg: db 0  ; screen mode parameter
041CC5             0348*    @end:
041CC5             0349*    
041CC5             0350*    ; get the current screen mode
041CC5             0351*    ; inputs: none
041CC5             0352*    ; outputs: a=screen mode
041CC5             0353*    ; destroys: af, ix
041CC5             0354*    vdu_get_screen_mode:
041CC5             0355*        MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
041CC5 3E 08       0001*M1  			LD	A, function
041CC7 5B CF       0002*M1  			RST.LIL	08h
041CC9 DD 7E 27    0356*        ld a,(IX+sysvar_scrMode)
041CCC C9          0357*        ret
041CCD             0358*    ; end vdu_get_screen_mode
041CCD             0359*    
041CCD             0360*    ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
041CCD             0361*    ; inputs: a is scaling mode, 1=on, 0=off
041CCD             0362*    ; note: default setting on boot is scaling ON
041CCD             0363*    vdu_set_scaling:
041CCD 32 DF 1C 04 0364*    	ld (@arg),a
041CD1 21 DC 1C 04 0365*    	ld hl,@cmd
041CD5 01 04 00 00 0366*    	ld bc,@end-@cmd
041CD9 5B DF       0367*    	rst.lil $18
041CDB C9          0368*    	ret
041CDC 17 00 C0    0369*    @cmd: db 23,0,0xC0
041CDF 00          0370*    @arg: db 0  ; scaling on/off
041CE0             0371*    @end:
041CE0             0372*    
041CE0             0373*    ; VDU 23, 27, &20, bufferId; : Select bitmap (using a buffer ID)
041CE0             0374*    ; inputs: hl=bufferId
041CE0             0375*    vdu_buff_select:
041CE0 22 F2 1C 04 0376*    	ld (@bufferId),hl
041CE4 21 EF 1C 04 0377*    	ld hl,@cmd
041CE8 01 05 00 00 0378*    	ld bc,@end-@cmd
041CEC 5B DF       0379*    	rst.lil $18
041CEE C9          0380*    	ret
041CEF 17 1B 20    0381*    @cmd: db 23,27,0x20
041CF2 00 00       0382*    @bufferId: dw 0x0000
041CF4 00          0383*    @end: db 0x00 ; padding
041CF5             0384*    
041CF5             0385*    ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
041CF5             0386*    ; inputs: a=format; bc=width; de=height
041CF5             0387*    ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
041CF5             0388*    ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
041CF5             0389*    ; 0 	RGBA8888 (4-bytes per pixel)
041CF5             0390*    ; 1 	RGBA2222 (1-bytes per pixel)
041CF5             0391*    ; 2 	Mono/Mask (1-bit per pixel)
041CF5             0392*    ; 3 	Reserved for internal use by VDP (“native” format)
041CF5             0393*    vdu_bmp_create:
041CF5 ED 43 11 1D 0394*        ld (@width),bc
       04          
041CFA ED 53 13 1D 0395*        ld (@height),de
       04          
041CFF 32 15 1D 04 0396*        ld (@fmt),a
041D03 21 0E 1D 04 0397*    	ld hl,@cmd
041D07 01 08 00 00 0398*    	ld bc,@end-@cmd
041D0B 5B DF       0399*    	rst.lil $18
041D0D C9          0400*    	ret
041D0E 17 1B 21    0401*    @cmd:       db 23,27,0x21
041D11 00 00       0402*    @width:     dw 0x0000
041D13 00 00       0403*    @height:    dw 0x0000
041D15 00          0404*    @fmt:       db 0x00
041D16             0405*    @end:
041D16             0406*    
041D16             0407*    ; load an rgba2222 image file to a working buffer and make it an rgba8888 bitmap in a target buffer
041D16             0408*    ; inputs: bc,de image width,height ; hl = targetBufferId ; ix = file size ; iy = pointer to filename
041D16             0409*    vdu_load_img_rgba2_to_8:
041D16             0410*    ; backup the target buffer id and image dimensions
041D16 E5          0411*        push hl
041D17 D5          0412*        push de
041D18 C5          0413*        push bc
041D19             0414*    ; load the rgba2 image to working buffer 65534
041D19 21 FE FF 00 0415*        ld hl,65534 ; temporary working buffer id
041D1D CD F4 1D 04 0416*    	call vdu_load_buffer_from_file
041D21             0417*    ; restore the image dimensions and target buffer id
041D21 C1          0418*        pop bc
041D22 D1          0419*        pop de
041D23 E1          0420*        pop hl
041D24             0421*    ; fall through to vdu_rgba2_to_8
041D24             0422*    
041D24             0423*    ; https://discord.com/channels/1158535358624039014/1158536711148675072/1257757461729771771
041D24             0424*    ; ok, so the "expand bitmap" can be used, when coupled with a "reverse" - the expanded bitmap _doesn't_ come out "right" otherwise, cos of endian-ness
041D24             0425*    ; the "expand bitmap" command is:
041D24             0426*    ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
041D24             0427*    ; and then to reverse the byte order to fix endian-ness:
041D24             0428*    ; VDU 23,0,&A0,targetBufferID%;24,4,4;
041D24             0429*    ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
041D24             0430*    ; VDU 23,27,&20,targetBufferID%;
041D24             0431*    ; VDU 23,27,&21,width%;height%;0
041D24             0432*    ; -------------------------------------------------------------------
041D24             0433*    ; inputs: bc,de image width,height ; hl = targetBufferId
041D24             0434*    ; prerequisites: rgba2 image data loaded into workingBufferId 65534
041D24             0435*    vdu_rgba2_to_8:
041D24             0436*    ; load the image dimensions and buffer id parameters
041D24 ED 43 80 1D 0437*        ld (@width),bc
       04          
041D29 ED 53 82 1D 0438*        ld (@height),de
       04          
041D2E 22 65 1D 04 0439*        ld (@bufferId0),hl
041D32 22 72 1D 04 0440*        ld (@bufferId2),hl
041D36 22 7B 1D 04 0441*        ld (@bufferId1),hl
041D3A             0442*    ; clean up bytes that got stomped on by the ID loads
041D3A 3E 48       0443*        ld a,0x48
041D3C 32 67 1D 04 0444*        ld (@bufferId0+2),a
041D40 3E 17       0445*        ld a,23
041D42 32 7D 1D 04 0446*        ld (@bufferId1+2),a
041D46 3E 18       0447*        ld a,24
041D48 32 74 1D 04 0448*        ld (@bufferId2+2),a
041D4C AF          0449*        xor a
041D4D 32 84 1D 04 0450*        ld (@height+2),a
041D51             0451*    ; send the vdu command strings
041D51 21 5C 1D 04 0452*        ld hl,@beg
041D55 01 29 00 00 0453*        ld bc,@end-@beg
041D59 5B DF       0454*        rst.lil $18
041D5B C9          0455*        ret
041D5C             0456*    @beg:
041D5C             0457*    ; Command 14: Consolidate blocks in a buffer
041D5C             0458*    ; VDU 23, 0, &A0, bufferId; 14
041D5C 17 00 A0    0459*        db 23,0,0xA0
041D5F FE FF       0460*        dw 65534 ; workingBufferId
041D61 0E          0461*        db 14 ; consolidate blocks
041D62             0462*    ; the "expand bitmap" command is:
041D62             0463*    ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
041D62 17 00 A0    0464*        db 23,0,0xA0
041D65 00 00       0465*    @bufferId0: dw 0x0000 ; targetBufferId
041D67 48          0466*        db 0x48 ; given as decimal command 72 in the docs
041D68 02          0467*        db 2 ; options mask: %00000011 is the number of bits per pixel in the source bitmap
041D69 FE FF       0468*        dw 65534 ; sourceBufferId
041D6B 00 7F BF FF 0469*        db 0x00,0x7F,0xBF,0xFF ; expanding to bytes by bit-shifting?
041D6F             0470*    ; reverse the byte order to fix endian-ness:
041D6F             0471*    ; Command 24: Reverse the order of data of blocks within a buffer
041D6F             0472*    ; VDU 23, 0, &A0, bufferId; 24, options, [valueSize;] [chunkSize;]
041D6F             0473*    ; VDU 23,0,&A0,targetBufferID%;24,4,4;
041D6F 17 00 A0    0474*        db 23,0,0xA0
041D72 00 00       0475*    @bufferId2:    dw 0x0000 ; targetBufferId
041D74 18          0476*        db 24 ; reverse byte order
041D75 04          0477*        db 4 ; option: Reverse data of the value size within chunk of data of the specified size
041D76 04 00       0478*        dw 4 ; size (4 bytes)
041D78             0479*    ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
041D78             0480*    ; VDU 23,27,&20,targetBufferID%;
041D78 17 1B 20    0481*        db 23,27,0x20 ; select bitmap
041D7B 00 00       0482*    @bufferId1: dw 0x0000 ; targetBufferId
041D7D             0483*    ; VDU 23,27,&21,width%;height%;0
041D7D 17 1B 21    0484*        db 23,27,0x21 ; create bitmap from buffer
041D80 00 00       0485*    @width: dw 0x0000
041D82 00 00       0486*    @height: dw 0x0000
041D84 00          0487*        db 0x00 ; rgba8888 format
041D85             0488*    @end:
041D85             0489*    
041D85             0490*    ; scratch variables
041D85 00 00 00    0491*    bufferId0: dl 0x000000
041D88 00 00 00    0492*    bufferId1: dl 0x000000
041D8B             0493*    
041D8B             0494*    ; load a vdu buffer from local memory
041D8B             0495*    ; inputs: hl = bufferId ; bc = length ; de = pointer to data
041D8B             0496*    vdu_load_buffer:
041D8B ED 43 B4 1D 0497*        ld (@length),bc
       04          
041D90 D5          0498*        push de ; save data pointer
041D91             0499*    ; send the vdu command string
041D91 7D          0500*        ld a,l
041D92 32 B1 1D 04 0501*        ld (@bufferId),a
041D96 7C          0502*        ld a,h
041D97 32 B2 1D 04 0503*        ld (@bufferId+1),a
041D9B 21 AE 1D 04 0504*        ld hl,@cmd
041D9F 01 08 00 00 0505*        ld bc,@end-@cmd
041DA3 5B DF       0506*        rst.lil $18
041DA5             0507*    ; send the buffer data
041DA5 E1          0508*        pop hl ; pointer to data
041DA6 ED 4B B4 1D 0509*        ld bc,(@length)
       04          
041DAB 5B DF       0510*        rst.lil $18 ; send it
041DAD C9          0511*        ret
041DAE             0512*    ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
041DAE 17 00 A0    0513*    @cmd:       db 23,0,0xA0
041DB1 00 00       0514*    @bufferId:	dw 0x0000
041DB3 00          0515*    		    db 0 ; load buffer
041DB4 00 00       0516*    @length:	dw 0x0000
041DB6 00          0517*    @end: db 0 ; padding
041DB7             0518*    
041DB7             0519*    ; Command 14: Consolidate blocks in a buffer
041DB7             0520*    vdu_consolidate_buffer:
041DB7             0521*    ; set parameters for vdu call
041DB7 7D          0522*        ld a,l
041DB8 32 CF 1D 04 0523*        ld (@bufferId),a
041DBC 7C          0524*        ld a,h
041DBD 32 D0 1D 04 0525*        ld (@bufferId+1),a
041DC1 21 CC 1D 04 0526*        ld hl,@beg
041DC5 01 06 00 00 0527*        ld bc,@end-@beg
041DC9 5B DF       0528*        rst.lil $18
041DCB C9          0529*        ret
041DCC             0530*    ; VDU 23, 0, &A0, bufferId; 14
041DCC 17 00 A0    0531*    @beg: db 23,0,0xA0
041DCF 00 00       0532*    @bufferId: dw 0x0000
041DD1 0E          0533*               db 14
041DD2             0534*    @end:
041DD2             0535*    
041DD2             0536*    ; load an image file to a buffer and make it a bitmap
041DD2             0537*    ; inputs: a = image format ; bc,de image width,height ; hl = bufferId ; iy = pointer to filename
041DD2             0538*    ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
041DD2             0539*    ; 0 	RGBA8888 (4-bytes per pixel)
041DD2             0540*    ; 1 	RGBA2222 (1-bytes per pixel)
041DD2             0541*    ; 2 	Mono/Mask (1-bit per pixel)
041DD2             0542*    ; 3 	Reserved for internal use by VDP (“native” format)
041DD2             0543*    vdu_load_img:
041DD2             0544*    ; back up image type and dimension parameters
041DD2 22 85 1D 04 0545*        ld (bufferId0),hl
041DD6 F5          0546*        push af
041DD7 C5          0547*    	push bc
041DD8 D5          0548*    	push de
041DD9             0549*    ; load the image
041DD9 CD F4 1D 04 0550*    	call vdu_load_buffer_from_file
041DDD             0551*    ; now make it a bitmap
041DDD 2A 85 1D 04 0552*        ld hl,(bufferId0)
041DE1 CD B7 1D 04 0553*        call vdu_consolidate_buffer
041DE5 2A 85 1D 04 0554*        ld hl,(bufferId0)
041DE9 CD E0 1C 04 0555*        call vdu_buff_select
041DED D1          0556*    	pop de ; image height
041DEE C1          0557*    	pop bc ; image width
041DEF F1          0558*    	pop af ; image type
041DF0 C3 F5 1C 04 0559*    	jp vdu_bmp_create ; will return to caller from there
041DF4             0560*    
041DF4             0561*    ; inputs: hl = bufferId; iy = pointer to filename
041DF4             0562*    vdu_load_buffer_from_file:
041DF4 22 85 1D 04 0563*        ld (bufferId0),hl
041DF8             0564*    
041DF8             0565*    ; clear target buffer
041DF8 CD A0 1F 04 0566*        call vdu_clear_buffer
041DFC             0567*    
041DFC             0568*    ; open the file in read mode
041DFC             0569*    ; Open a file
041DFC             0570*    ; HLU: Filename
041DFC             0571*    ;   C: Mode
041DFC             0572*    ; Returns:
041DFC             0573*    ;   A: Filehandle, or 0 if couldn't open
041DFC FD E5       0574*    	push iy ; pointer to filename
041DFE E1          0575*    	pop hl
041DFF 0E 01       0576*    	ld c,fa_read
041E01             0577*        MOSCALL mos_fopen
                       M1 Args: function=mos_fopen 
041E01 3E 0A       0001*M1  			LD	A, function
041E03 5B CF       0002*M1  			RST.LIL	08h
041E05 32 40 1E 04 0578*        ld (@filehandle),a
041E09             0579*    
041E09             0580*    @read_file:
041E09             0581*    ; Read a block of data from a file
041E09             0582*    ;   C: Filehandle
041E09             0583*    ; HLU: Pointer to where to write the data to
041E09             0584*    ; DEU: Number of bytes to read
041E09             0585*    ; Returns:
041E09             0586*    ; DEU: Number of bytes read
041E09 3A 40 1E 04 0587*        ld a,(@filehandle)
041E0D 4F          0588*        ld c,a
041E0E 21 00 E0 B7 0589*        ld hl,filedata
041E12 11 00 20 00 0590*        ld de,8192 ; max we can read into onboard sram at one time
041E16             0591*        MOSCALL mos_fread
                       M1 Args: function=mos_fread 
041E16 3E 1A       0001*M1  			LD	A, function
041E18 5B CF       0002*M1  			RST.LIL	08h
041E1A             0592*    
041E1A             0593*    ; test de for zero bytes read
041E1A 21 00 00 00 0594*        ld hl,0
041E1E AF          0595*        xor a ; clear carry
041E1F ED 52       0596*        sbc hl,de
041E21 CA 37 1E 04 0597*        jp z,@close_file
041E25             0598*    
041E25             0599*    ; load a vdu buffer from local memory
041E25             0600*    ; inputs: hl = bufferId ; bc = length ; de = pointer to data
041E25 2A 85 1D 04 0601*        ld hl,(bufferId0)
041E29 D5          0602*        push de ; chunksize
041E2A C1          0603*        pop bc
041E2B 11 00 E0 B7 0604*        ld de,filedata
041E2F CD 8B 1D 04 0605*        call vdu_load_buffer
041E33             0606*    
041E33             0607*    ; read the next block
041E33 C3 09 1E 04 0608*        jp @read_file
041E37             0609*    
041E37             0610*    ; close the file
041E37             0611*    @close_file:
041E37 3A 40 1E 04 0612*        ld a,(@filehandle)
041E3B             0613*        MOSCALL mos_fclose
                       M1 Args: function=mos_fclose 
041E3B 3E 0B       0001*M1  			LD	A, function
041E3D 5B CF       0002*M1  			RST.LIL	08h
041E3F C9          0614*        ret ; vdu_load_buffer_from_file
041E40             0615*    
041E40 00          0616*    @filehandle: db 0 ; file handle
041E41 00 00 00    0617*    @fil: dl 0 ; pointer to FIL struct
041E44             0618*    
041E44 00 00 00    0619*    @chunkpointer: dl 0 ; pointer to current chunk
041E47             0620*    
041E47             0621*    ; File information structure (FILINFO)
041E47             0622*    @filinfo:
041E47 00 00 00 00 0623*    @filinfo_fsize:    blkb 4, 0   ; File size (4 bytes)
041E4B 00 00       0624*    @filinfo_fdate:    blkb 2, 0   ; Modified date (2 bytes)
041E4D 00 00       0625*    @filinfo_ftime:    blkb 2, 0   ; Modified time (2 bytes)
041E4F 00          0626*    @filinfo_fattrib:  blkb 1, 0   ; File attribute (1 byte)
041E50 00 00 00 00 0627*    @filinfo_altname:  blkb 13, 0  ; Alternative file name (13 bytes)
       00 00 00 00 
       00 00 00 00 

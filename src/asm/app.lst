0404AD             0215*    ; Scratch area for calculations
0404AD             0216*    ;------------------------------------------------------------------------
0404AD 00 00 00    0217*    bitbuf1:	dw24	0	;bit manipulation buffer 1
0404B0 00 00 00    0218*    bitbuf2:	dw24	0	;bit manipulation buffer 2

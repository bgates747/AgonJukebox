0440FB             0343*    ps_set_seek_rate:
0440FB E6 07       0344*        and 7 ; mod 8
0440FD 32 9D 67 04 0345*        ld (ps_seek_rate_idx),a
044101 21 9E 67 04 0346*        ld hl,ps_seek_rate_idx+1
044105 11 00 00 00 0347*        ld de,0
044109 5F          0348*        ld e,a
04410A 19          0349*        add hl,de
04410B 7E          0350*        ld a,(hl)
04410C 32 99 67 04 0351*        ld (ps_seek_rate),a
044110 CD 32 36 04 0352*        call vp_seek_rate
044114 CD E6 1B 04 0353*        call vdu_cls
044118 3A 99 67 04 0354*        ld a,(ps_seek_rate)
04411C CD 44 01 04 0355*        call printDec8
044120 C3 37 3E 04 0356*        jp get_input

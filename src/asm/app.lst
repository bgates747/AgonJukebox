041BBE             0118*    
041BBE             0119*    ; VDU 31, x, y: Move text cursor to x, y text position (TAB(x, y))
041BBE             0120*    ; inputs: c=x, b=y 8-bit unsigned integers
041BBE             0121*    vdu_move_cursor:
041BBE ED 43 CF 1B 0122*        ld (@x0),bc
       04          
041BC3 21 CE 1B 04 0123*    	ld hl,@cmd
041BC7 01 03 00 00 0124*    	ld bc,@end-@cmd
041BCB 5B DF       0125*    	rst.lil $18
041BCD C9          0126*    	ret
041BCE 1F          0127*    @cmd: 	db 31
041BCF 00          0128*    @x0:	db 0
041BD0 00          0129*    @y0: 	db 0
041BD1 00          0130*    @end: 	db 0 ; padding
041BD2             0131*    
041BD2             0132*    ; https://agonconsole8.github.io/agon-docs/vdp/VDU-Commands/#vdu-23-1-n-cursor-control
041BD2             0133*    ; VDU 23, 16, setting, mask: Define cursor movement behaviour
041BD2             0134*    ; inputs: l = setting, h = mask
041BD2             0135*    ; new_setting = (current_setting AND mask) EOR setting
041BD2             0136*    ; in English: mask controls which bit to turn on or off, setting is the value of the bits to set or reset
041BD2             0137*    vdu_cursor_behaviour:
041BD2 22 E3 1B 04 0138*        ld (@setting),hl ; little-endian!
041BD6 21 E1 1B 04 0139*        ld hl,@cmd
041BDA 01 04 00 00 0140*        ld bc,@end-@cmd
041BDE 5B DF       0141*        rst.lil $18
041BE0 C9          0142*        ret
041BE1 17 10       0143*    @cmd: db 23,16
041BE3 00          0144*    @setting: db 0
041BE4 00          0145*    @mask: db 0
041BE5 00          0146*    @end: db 0 ; padding
041BE6             0147*    
041BE6             0148*    ; VDU 12: Clear text area (CLS)
041BE6             0149*    vdu_cls:

047078             0060     ; --- MAIN PROGRAM FILE ---
047078             0061     init:
047078 CD 0C 3C 04 0062         call bf_get_dir
04707C CD 8C 36 04 0063         call ui_init
047080 CD 59 6A 04 0064         call ps_load_audio_cmd_buffers ; TODO: figure out why it is insufficient to do this here
047084             0065                                      ; even though play_song rebuilds them for each WAV
047084 CD 7F 6B 04 0066         call ps_prt_irq_init
047088 C9          0067         ret
047089             0068     ; end init
047089             0069     main:
047089             0070     ; call the change directory routine and jp to user input
047089 CD 37 3E 04 0071         call get_input
04708D             0072     
04708D             0073     ; we come back here when user wants to quit app
04708D             0074     ; shut down everytyhing and gracefully exit to MOS
04708D CD 8A 69 04 0075         call ps_close_file ; close any playing file and stop the PRT timer
047091 CD 69 69 04 0076         call ps_clear_audio_buffers ; release only the four buffers owned by the WAV player
047095 FB          0077         ei ; interrupts were disabled by get_input
047096             0078     ; restore original screen mode
047096 3A 06 35 04 0079         ld a,(original_screen_mode)
04709A CD B4 1C 04 0080         call vdu_set_screen_mode
04709E CD AF 1C 04 0081         call vdu_reset_viewports
0470A2 CD E6 1B 04 0082         call vdu_cls
0470A6             0083     ; print thanks for playing message
0470A6 CD 60 00 04 0084         call printInline
0470AA 54 68 61 6E 0085         asciz "Thank you for using\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 75 73 
       69 6E 67 0D 
       0A 00       
0470C0 21 D1 38 04 0086         ld hl,agon_jukebox_ascii
0470C4 CD 67 00 04 0087         call printString
0470C8             0088     ; set cursor behaviuor
0470C8 CD 60 1B 04 0089         call vdu_cursor_on
0470CC 26 10       0090         ld h,%00010000 ; bit 4 controls cursor scroll at bottom of screen
0470CE 2E 00       0091         ld l,%00000000 ; bit 4 reset means cursor scrolls screen
0470D0 CD D2 1B 04 0092         call vdu_cursor_behaviour
0470D4 CD 73 36 04 0093         call ui_clear_buffers ; release only the font and logo resources owned by the UI
0470D8 C9          0094         ret ; back to MOS
0470D9             0095     ; end main

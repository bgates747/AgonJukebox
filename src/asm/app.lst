                       M1 Args: function=mos_cd 
043F7C 3E 03       0001*M1  			LD	A, function
043F7E 5B CF       0002*M1  			RST.LIL	08h
043F80             0178*    ; stop the PRT timer and disable interrupts
043F80 CD 79 6B 04 0179*        call ps_prt_stop ; stop the PRT timer
043F84             0180*     ; get directory listing
043F84 CD 0C 3C 04 0181*        call bf_get_dir
043F88 21 00 00 00 0182*        ld hl,0
043F8C 22 0A 00 07 0183*        ld (bf_page_cur),hl ; reset the page number
043F90 AF          0184*        xor a

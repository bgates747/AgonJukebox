046784             0023*    F_UI_logo_end:
046784             0053         include "play.inc"
046784             0001*    ; stream a song from the SD card
046784             0002*    ; inputs: hl = pointer to filename
046784             0003*    ; requirements: the file must be 8-bit unsigned PCM mono
046784             0004*    ; uses: sound channels 0 and 1, buffers 0x3000 through 0x3003
046784             0005*    ; play_song constants
046784             0006*    
046784             0007*    ps_wav_cmd_bufferId0: equ 0x003000
046784             0008*    ps_wav_cmd_bufferId1: equ 0x003001
046784             0009*    ps_wav_data_bufferId0: equ 0x003002
046784             0010*    ps_wav_data_bufferId1: equ 0x003003
046784             0011*    
046784             0012*    
046784             0013*    ; ps_mode bits
046784             0014*    ps_mode_playing: equ 0 ; 0 = paused 1 = playing, p key toggles
046784             0015*    ps_mode_loop:    equ 1 ; 0 = no loop 1 = loop (overrides ps_mode_shuffle if on), l key toggles
046784             0016*    ps_mode_shuffle: equ 2 ; 0 = shuffle off 1 = on, s key toggles
046784             0017*    
046784             0018*    ; play_song state variables
046784             0019*    ; current active channel and bufferId's
046784 0B          0020*    ps_volume: db 11 ; master volume 0-11
046785 00          0021*    ps_mode: db 0 ; playback mode bitmask
046786 00          0022*    ps_channel: db 0 ; channel number
046787 00 30 00    0023*    ps_wav_cmd_buffer: dl ps_wav_cmd_bufferId0 ; current command buffer
04678A 02 30 00    0024*    ps_wav_data_buffer: dl ps_wav_data_bufferId0 ; current sample-data buffer
04678D 00 00 00    0025*    ps_chunkpointer: dl 0 ; pointer to current chunk
046790 00 00 00 00 0026*    ps_playhead: dw32 0 ; current playhead position in seconds from the start (32-bit integer)
046794 00 00 00 00 0027*    ps_song_duration: blkb 5,0 ; duration of the current song in seconds (32-bit integer plus a padding byte)
       00          
046799 01 00 00 00 0028*    ps_seek_rate: dw32 1 ; seek rate in seconds per keypress (32-bit integer)
04679D 00          0029*    ps_seek_rate_idx: db 0 ; seek rate indexs
04679E 01 05 0A 0F 0030*        db 1,5,10,15,30,60,120,240 ; seek rates in seconds per keypress
       1E 3C 78 F0 
0467A6             0031*    
0467A6             0032*    ps_chunks_per_second: equ 60 ; number of chunks to load per second
0467A6 00 00 00    0033*    ps_wav_chunk_size: dl 0 ; size of audio chunks to load (sample rate / 60)
0467A9 00          0034*    ps_wav_chunk_counter: db 0 ; init to audio chunks/sec, when hits zero play the loaded audio buffer
0467AA             0035*    
0467AA             0036*    play_song:
0467AA             0037*    ; stop the PRT timer and close any currently playing file
0467AA CD 8A 69 04 0038*        call ps_close_file ; also stops prt timer
0467AE             0039*    
0467AE             0040*    ; reset the chunk counter to chunks / second
0467AE 3E 3C       0041*        ld a,ps_chunks_per_second
0467B0 32 A9 67 04 0042*        ld (ps_wav_chunk_counter),a
0467B4             0043*    
0467B4             0044*    ; clear now playing viewport
0467B4 CD 89 35 04 0045*        call vp_now_playing
0467B8 CD E6 1B 04 0046*        call vdu_cls
0467BC             0047*    
0467BC             0048*    ; open the file and verify it's a playable .wav file
0467BC CD D5 6B 04 0049*        call ps_open_wav
0467C0 C2 F3 67 04 0050*        jp nz,@F ; valid .wav file so continue
0467C4 CD 60 00 04 0051*        call printInline
0467C8 49 6E 76 61 0052*        asciz "Invalid .wav file selected, try again."
       6C 69 64 20 
       2E 77 61 76 
       20 66 69 6C 
       65 20 73 65 
       6C 65 63 74 
       65 64 2C 20 
       74 72 79 20 
       61 67 61 69 
       6E 2E 00    
0467EF C3 37 3E 04 0053*        jp get_input ; return to user input loop
0467F3             0054*    
0467F3             0055*    @@:
0467F3             0056*    ; copy the directory filinfo struct to ps_filinfo_struct
0467F3 ED 23 00    0057*        lea hl,iy ; ps_open_wav set iy to the directory's filinfo struct
0467F6 11 00 01 09 0058*        ld de,ps_filinfo_struct ; destination address
0467FA 01 16 01 00 0059*        ld bc,filinfo_struct_size
0467FE ED B0       0060*        ldir
046800             0061*    
046800             0062*    ; tell the user what they've won
046800 CD 60 00 04 0063*        call printInline
046804 28 50 29 6C 0064*        asciz "(P)laying "
       61 79 69 6E 
       67 20 00    
04680F 21 16 01 09 0065*        ld hl,ps_filinfo_fname
046813 CD 67 00 04 0066*        call printString ; print the song filename
046817             0067*    
046817             0068*    ; display the song sample rate; each VDP sample receives this rate explicitly
046817             0069*    ; when ps_load_audio_cmd_buffers builds its create-sample command
046817 CD 3F 36 04 0070*        call vp_messages
04681B CD 60 00 04 0071*        call printInline
04681F 41 75 64 69 0072*        asciz "Audio sample rate:"
       6F 20 73 61 
       6D 70 6C 65 
       20 72 61 74 
       65 3A 00    
046832 2A 18 03 09 0073*        ld hl,(ps_wav_header+wav_sample_rate)
046836 CD CC 00 04 0074*        call printDec
04683A             0075*    
04683A             0076*    ; apply the user's stored master volume
04683A 3A 84 67 04 0077*        ld a,(ps_volume)
04683E CD 12 40 04 0078*        call ps_adjust_volume
046842             0079*    
046842             0080*    ; compute the song duration from the file size and sample rate and print it
046842             0081*    ; technically we should account for the .wav header, but at 76 bytes it's negligible
046842 CD A3 35 04 0082*        call vp_duration ; set viewport to duration window
046846 3A 07 03 09 0083*        ld a,(ps_wav_header+wav_file_size+3) ; upper byte
04684A DD 2A 04 03 0084*        ld ix,(ps_wav_header+wav_file_size+0) ; lower word
       09          
04684F ED 5B 18 03 0085*        ld de,(ps_wav_header+wav_sample_rate)
       09          
046854 CD 42 06 04 0086*        call udiv3223 ; auix = duration in seconds
046858 DD 22 94 67 0087*        ld (ps_song_duration),ix ; duration low word
       04          
04685D 32 97 67 04 0088*        ld (ps_song_duration+3),a ; duration high byte
046861 2A 94 67 04 0089*        ld hl,(ps_song_duration) ; ls 24 bits of duration is sufficient and all we're prepared for
046865 CD D2 18 04 0090*        call seconds_to_hhmmss ; hl pointer to string representation of HH:MM:SS
046869 CD 67 00 04 0091*        call printString ; print the duration
04686D             0092*    
04686D             0093*    ; compute the chunksize
04686D 2A 18 03 09 0094*        ld hl,(ps_wav_header+wav_sample_rate)
046871 11 3C 00 00 0095*        ld de,ps_chunks_per_second
046875 CD F5 03 04 0096*        call udiv24 ; de = sample_rate / ps_chunks_per_second
046879 ED 53 A6 67 0097*        ld (ps_wav_chunk_size),de ; save the chunk size
       04          
04687E             0098*    
04687E             0099*    ; flip the command and sample buffers and read the first block of data
04687E CD 59 6A 04 0100*        call ps_load_audio_cmd_buffers ; TODO: we should only have to do this on app init,
046882             0101*                                     ; but if we don't do it here, only one audio buffer
046882             0102*                                     ; is loaded or/and played
046882             0103*    ; reset the chunk counter
046882 3E 3C       0104*        ld a,ps_chunks_per_second
046884 32 A9 67 04 0105*        ld (ps_wav_chunk_counter),a
046888             0106*    ; reset the playbar counter to zero
046888 21 00 00 00 0107*        ld hl,0
04688C 22 90 67 04 0108*        ld (ps_playhead),hl
046890             0109*     ; this is crucial so that the next sound played is at new position
046890 CD 4A 69 04 0110*        call ps_set_audio_buffers
046894             0111*    ; set ps_mode_playing
046894 21 85 67 04 0112*        ld hl,ps_mode
046898 CB C6       0113*        set ps_mode_playing,(hl)
04689A             0114*    ; enable interrupts and start the PRT timer
04689A 21 B0 04 00 0115*        ld hl,72000/ps_chunks_per_second
04689E 22 B0 04 00 0116*        ld (ps_prt_reload),hl
0468A2 CD 64 6B 04 0117*        call ps_prt_start
0468A6             0118*    ; jump to user input loop (enables interrupts)
0468A6             0119*    ; the play sample interrupt will return to there
0468A6             0120*    ; and exit app will return to main from there as well
0468A6 C3 37 3E 04 0121*        jp get_input
0468AA             0122*    ; end play_song
0468AA             0123*    
0468AA             0124*    ; read the next chunk of sound data from the file
0468AA             0125*    ; and upload it to the sample buffer
0468AA             0126*    ps_read_sample:
0468AA             0127*    ; 0x82: ffs_fread
0468AA             0128*    ; Read from a file (Requires MOS 1.03 or above)
0468AA             0129*    ; Parameters:
0468AA             0130*    ; HL(U): Pointer to a FIL structure
0468AA             0131*    ; DE(U): Pointer to a buffer to store the data in
0468AA             0132*    ; BC(U): Number of bytes to read (typically the size of the buffer)
0468AA             0133*    ; Preserves: HL(U), DE(U)
0468AA             0134*    ; Returns:
0468AA             0135*    ; BC(U): Number of bytes read
0468AA             0136*    ; A: FRESULT
0468AA 21 00 00 09 0137*        ld hl,ps_fil_struct
0468AE 11 4C 03 09 0138*        ld de,ps_wav_data
0468B2             0139*        ; ld bc,(ps_wav_header+wav_sample_rate)
0468B2 ED 4B A6 67 0140*        ld bc,(ps_wav_chunk_size)
       04          
0468B7             0141*        FFSCALL ffs_fread
                       M1 Args: function=ffs_fread 
0468B7 FD E5       0001*M1  			PUSH IY
0468B9 3E 82       0002*M1  			LD	A, function
0468BB 5B CF       0003*M1  			RST.LIL	08h
0468BD FD E1       0004*M1  			POP IY
0468BF             0142*    ; test bc for zero bytes read
0468BF 21 00 00 00 0143*        ld hl,0
0468C3 AF          0144*        xor a ; clear carry
0468C4 ED 42       0145*        sbc hl,bc ; hl = 0-chunksize
0468C6 C2 D2 68 04 0146*        jp nz,@load ; we read some data
0468CA             0147*    ; no data read so close file and play next song
0468CA CD 8A 69 04 0148*        call ps_close_file
0468CE C3 A7 69 04 0149*        jp ps_song_over
0468D2             0150*    ; load a vdu buffer from local memory
0468D2             0151*    ; inputs: hl = bufferId ; bc = length ; de = pointer to data
0468D2             0152*    @load:
0468D2             0153*    ; load the chunk to the current sample buffer
0468D2 2A 8A 67 04 0154*        ld hl,(ps_wav_data_buffer)
0468D6 11 4C 03 09 0155*        ld de,ps_wav_data ; pointer to data
0468DA CD 8B 1D 04 0156*        call vdu_load_buffer
0468DE             0157*    ; decrement the chunk counter
0468DE 3A A9 67 04 0158*        ld a,(ps_wav_chunk_counter)
0468E2 3D          0159*        dec a
0468E3 32 A9 67 04 0160*        ld (ps_wav_chunk_counter),a
0468E7 C0          0161*        ret nz ; not time to play sample, so back to interrupt handler
0468E8             0162*    ; reset the chunk counter and play the buffer
0468E8 3E 3C       0163*        ld a,ps_chunks_per_second
0468EA 32 A9 67 04 0164*        ld (ps_wav_chunk_counter),a
0468EE C3 39 69 04 0165*        jp ps_play_sample
0468F2             0166*    ; end ps_read_sample
0468F2             0167*    
0468F2             0168*    ps_update_playbar:
0468F2             0169*    ; set viewport to playbar
0468F2 CD 96 35 04 0170*        call vp_elapsed
0468F6             0171*    ; increment the playbar counter
0468F6 2A 90 67 04 0172*        ld hl,(ps_playhead)
0468FA 23          0173*        inc hl
0468FB 22 90 67 04 0174*        ld (ps_playhead),hl
0468FF             0175*    ; convert the playbar counter to HH:MM:SS and print it
0468FF CD D2 18 04 0176*        call seconds_to_hhmmss ; hl pointer to string representation of HH:MM:SS
046903 CD 67 00 04 0177*        call printString ; print the playhead position
046907             0178*    ; print breadcrumbs and playhead marker
046907 CD B0 35 04 0179*        call vp_playbar
04690B CD E6 1B 04 0180*        call vdu_cls
04690F 21 00 2B 00 0181*        ld hl,[vp_playbar_right-vp_playbar_left]*256 ; leave room for cursor
046913 ED 5B 94 67 0182*        ld de,(ps_song_duration) ; ls 24-bits is sufficient and all we're prepared for
       04          
046918 CD 65 0F 04 0183*        call udiv168 ; de = breadcrumbs / second in 8.16 fixed point
04691C 2A 90 67 04 0184*        ld hl,(ps_playhead)
046920 CD DC 03 04 0185*        call umul24 ; uhl is the breadcrumb position
046924             0186*        HLU_TO_A ; a = breadcrumb position
                       M1 Args: none
046924 3B          0001*M1      dec sp ; 1 cycle
046925 E5          0002*M1      push hl ; 4 cycles
046926 33          0003*M1      inc sp ; 1 cycle
046927 F1          0004*M1      pop af ; 4 cycles
046928             0005*M1      ; 10 cycles total
046928 A7          0187*        and a
046929 CA 34 69 04 0188*        jp z,@done ; if zero, we're done
04692D 47          0189*        ld b,a
04692E             0190*    @loop:
04692E 3E 2E       0191*        ld a,'.'
046930 5B D7       0192*        rst.lil 10h
046932 10 FA       0193*        djnz @loop
046934             0194*    @done:
046934 3E DB       0195*        ld a,219 ; cursor
046936 5B D7       0196*        rst.lil 10h
046938 C9          0197*        ret
046939             0198*    ; end ps_update_playbar
046939             0199*    
046939             0200*    ps_play_sample:
046939             0201*    ; update the playbar counter and display the time elapsed
046939 CD F2 68 04 0202*        call ps_update_playbar
04693D             0203*    ; call the command buffer to play the sound
04693D 2A 87 67 04 0204*        ld hl,(ps_wav_cmd_buffer)
046941 CD 85 1F 04 0205*        call vdu_call_buffer
046945             0206*    ; flip the sample and command buffers
046945 CD 4A 69 04 0207*        call ps_set_audio_buffers
046949 C9          0208*        ret ; back to interrupt handler
04694A             0209*    ; end ps_play_sample
04694A             0210*    
04694A             0211*    ps_set_audio_buffers:
04694A             0212*    ; flip the command and sample buffers and clear the new sample buffer
04694A 3A 86 67 04 0213*        ld a,(ps_channel)
04694E 3C          0214*        inc a
04694F E6 01       0215*        and 1
046951 32 86 67 04 0216*        ld (ps_channel),a
046955 21 00 30 00 0217*        ld hl,ps_wav_cmd_bufferId0
046959 6F          0218*        ld l,a
04695A 22 87 67 04 0219*        ld (ps_wav_cmd_buffer),hl
04695E 2C          0220*        inc l
04695F 2C          0221*        inc l
046960 22 8A 67 04 0222*        ld (ps_wav_data_buffer),hl
046964 CD A0 1F 04 0223*        call vdu_clear_buffer
046968 C9          0224*        ret
046969             0225*    ; end ps_set_audio_buffers
046969             0226*    
046969             0227*    ; clear only the VDP buffers owned by WAV playback
046969             0228*    ps_clear_audio_buffers:
046969 21 00 30 00 0229*        ld hl,ps_wav_cmd_bufferId0
04696D CD A0 1F 04 0230*        call vdu_clear_buffer
046971 21 01 30 00 0231*        ld hl,ps_wav_cmd_bufferId1
046975 CD A0 1F 04 0232*        call vdu_clear_buffer
046979 21 02 30 00 0233*        ld hl,ps_wav_data_bufferId0
04697D CD A0 1F 04 0234*        call vdu_clear_buffer
046981 21 03 30 00 0235*        ld hl,ps_wav_data_bufferId1
046985 CD A0 1F 04 0236*        call vdu_clear_buffer
046989 C9          0237*        ret
04698A             0238*    ; end ps_clear_audio_buffers
04698A             0239*    
04698A             0240*    ; close the file
04698A             0241*    ps_close_file:
04698A CD 79 6B 04 0242*        call ps_prt_stop ; stop the PRT timer
04698E             0243*    ; stop samples on the two stock channels owned by the WAV player
04698E 0E 00       0244*        ld c,0
046990 CD 63 22 04 0245*        call vdu_reset_channel
046994 0E 01       0246*        ld c,1
046996 CD 63 22 04 0247*        call vdu_reset_channel
04699A             0248*    ; 0x81: ffs_fclose
04699A             0249*    ; Close a file (Requires MOS 1.03 or above)
04699A             0250*    ; Parameters:
04699A             0251*    ; HL(U): Pointer to a FIL structure
04699A             0252*    ; Preserves: HL(U)
04699A             0253*    ; Returns:
04699A             0254*    ; A: FRESULT
04699A 21 00 00 09 0255*        ld hl,ps_fil_struct
04699E             0256*        FFSCALL ffs_fclose
                       M1 Args: function=ffs_fclose 
04699E FD E5       0001*M1  			PUSH IY
0469A0 3E 81       0002*M1  			LD	A, function
0469A2 5B CF       0003*M1  			RST.LIL	08h
0469A4 FD E1       0004*M1  			POP IY
0469A6 C9          0257*        ret
0469A7             0258*    ; end ps_close_file
0469A7             0259*    
0469A7             0260*    ps_song_over:
0469A7             0261*    ; get playback mode
0469A7 21 85 67 04 0262*        ld hl,ps_mode
0469AB             0263*    
0469AB             0264*    ; are we in loop mode?
0469AB CB 4E       0265*        bit ps_mode_loop,(hl)
0469AD CA B9 69 04 0266*        jp z,@F ; no so check next mode
0469B1 21 16 01 09 0267*        ld hl,ps_filinfo_fname ; get current song filename
0469B5 C3 AA 67 04 0268*        jp play_song ; and play it again, Sam
0469B9             0269*    
0469B9             0270*    @@: ; are we in shuffle mode?
0469B9 CB 56       0271*        bit ps_mode_shuffle,(hl)
0469BB C2 17 6A 04 0272*        jp nz,ps_play_random ; yes so play a random song
0469BF             0273*    
0469BF             0274*    ; loop and shuffle are off so play next song
0469BF C3 C3 69 04 0275*        jp ps_play_next_song
0469C3             0276*    ; end ps_song_over
0469C3             0277*    
0469C3             0278*    ps_play_next_song:
0469C3 3A 04 00 07 0279*        ld a,(bf_files_cur_pg)
0469C7 B7          0280*        or a ; check for zero files
0469C8 CA 37 3E 04 0281*        jp z,get_input ; no files to play so return to user input loop
0469CC 47          0282*        ld b,a ; loop counter
0469CD             0283*    @next_file:
0469CD C5          0284*        push bc ; save loop counter
0469CE CD 01 3F 04 0285*        call get_next_file_idx ; (bf_file_idx)++ with wraparound
0469D2 CD C3 3F 04 0286*        call bf_get_filinfo_from_pg_idx ; iy points to filinfo struct
0469D6 CD 05 3E 04 0287*        call bf_check_dir_or_file ; if zero then it's a song
0469DA C1          0288*        pop bc ; restore loop counter
0469DB CA E5 69 04 0289*        jp z,@play_song ; is a file so play song
0469DF 10 EC       0290*        djnz @next_file ; try the next file
0469E1 C3 37 3E 04 0291*        jp get_input ; no files in this directory so return to user input loop
0469E5             0292*    @play_song:
0469E5 CD D2 3D 04 0293*        call bf_highlight_file ; highlight the selected file
0469E9 C3 AA 67 04 0294*        jp play_song
0469ED             0295*    ; end ps_play_next_song
0469ED             0296*    
0469ED             0297*    ps_play_prev_song:
0469ED 3A 04 00 07 0298*        ld a,(bf_files_cur_pg)
0469F1 B7          0299*        or a ; check for zero files
0469F2 CA 37 3E 04 0300*        jp z,get_input ; no files to play so return to user input loop
0469F6 47          0301*        ld b,a ; loop counter
0469F7             0302*    @next_file:
0469F7 C5          0303*        push bc ; save loop counter
0469F8 CD 01 3F 04 0304*        call get_next_file_idx ; (bf_file_idx)++ with wraparound
0469FC CD C3 3F 04 0305*        call bf_get_filinfo_from_pg_idx ; iy points to filinfo struct
046A00 CD 05 3E 04 0306*        call bf_check_dir_or_file ; if zero then it's a song
046A04 C1          0307*        pop bc ; restore loop counter
046A05 CA 0F 6A 04 0308*        jp z,@play_song ; is a file so play song
046A09 10 EC       0309*        djnz @next_file ; try the next file
046A0B C3 37 3E 04 0310*        jp get_input ; no files in this directory so return to user input loop
046A0F             0311*    @play_song:
046A0F CD D2 3D 04 0312*        call bf_highlight_file ; highlight the selected file
046A13 C3 AA 67 04 0313*        jp play_song
046A17             0314*    ; end ps_play_prev_song
046A17             0315*    
046A17             0316*    ; queue a random song on the current page to play next
046A17             0317*    ps_play_random:
046A17 3A 04 00 07 0318*        ld a,(bf_files_cur_pg)
046A1B B7          0319*        or a ; check for zero files
046A1C CA 37 3E 04 0320*        jp z,get_input ; no files to play so return to user input loop
046A20 47          0321*        ld b,a ; loop counter
046A21 3A 00 00 07 0322*        ld a,(bf_file_idx) ; save current song index
046A25 32 58 6A 04 0323*        ld (@file_idx),a
046A29             0324*    @next_file:
046A29 C5          0325*        push bc ; save loop counter
046A2A CD CA 3E 04 0326*        call get_rand_file_idx ; a->(bf_file_idx)
046A2E 21 58 6A 04 0327*        ld hl,@file_idx
046A32 BE          0328*        cp (hl) ; check for same song
046A33 CA 4A 6A 04 0329*        jp z,@same ; same song so try again
046A37 CD C3 3F 04 0330*        call bf_get_filinfo_from_pg_idx ; iy points to filinfo struct
046A3B CD 05 3E 04 0331*        call bf_check_dir_or_file ; if zero then it's a song
046A3F             0332*    @bump_counter:
046A3F C1          0333*        pop bc ; restore loop counter
046A40 CA 50 6A 04 0334*        jp z,@play_song ; is a file so play song
046A44 10 E3       0335*        djnz @next_file ; try the next file
046A46 C3 37 3E 04 0336*        jp get_input ; no files in this directory so return to user input loop
046A4A             0337*    @same:
046A4A F6 01       0338*        or a,1 ; reset zero flag
046A4C C3 3F 6A 04 0339*        jp @bump_counter
046A50             0340*    @play_song:
046A50 CD D2 3D 04 0341*        call bf_highlight_file ; highlight the selected file
046A54 C3 AA 67 04 0342*        jp play_song
046A58 00          0343*    @file_idx: db 0
046A59             0344*    ; end ps_play_random
046A59             0345*    
046A59             0346*    ps_load_audio_cmd_buffers:
046A59 21 00 30 00 0347*        ld hl,ps_wav_cmd_bufferId0
046A5D CD A0 1F 04 0348*        call vdu_clear_buffer
046A61 2A 18 03 09 0349*        ld hl,(ps_wav_header+wav_sample_rate)
046A65             0350*        ; ld hl,(ps_wav_chunk_size)
046A65 22 B5 6A 04 0351*        ld (ps_sr0),hl
046A69 3E 17       0352*        ld a,23
046A6B 32 B7 6A 04 0353*        ld (ps_sr0+2),a
046A6F 21 00 30 00 0354*        ld hl,ps_wav_cmd_bufferId0
046A73 01 23 00 00 0355*        ld bc,ps_cmd0_end-ps_cmd0
046A77 11 A6 6A 04 0356*        ld de,ps_cmd0
046A7B CD 5D 1F 04 0357*        call vdu_write_block_to_buffer
046A7F             0358*    
046A7F 21 01 30 00 0359*        ld hl,ps_wav_cmd_bufferId1
046A83 CD A0 1F 04 0360*        call vdu_clear_buffer
046A87 2A 18 03 09 0361*        ld hl,(ps_wav_header+wav_sample_rate)
046A8B             0362*        ; ld hl,(ps_wav_chunk_size)
046A8B 22 D8 6A 04 0363*        ld (ps_sr1),hl
046A8F 3E 17       0364*        ld a,23
046A91 32 DA 6A 04 0365*        ld (ps_sr1+2),a
046A95 21 01 30 00 0366*        ld hl,ps_wav_cmd_bufferId1
046A99 01 23 00 00 0367*        ld bc,ps_cmd1_end-ps_cmd1
046A9D 11 C9 6A 04 0368*        ld de,ps_cmd1
046AA1 CD 5D 1F 04 0369*        call vdu_write_block_to_buffer
046AA5 C9          0370*        ret
046AA6             0371*    ps_cmd0:
046AA6             0372*    ; Command 14: Consolidate blocks in a buffer
046AA6             0373*    ; VDU 23, 0, &A0, bufferId; 14
046AA6 17 00 A0    0374*        db 23,0,0xA0 ; vdu buffered api command header
046AA9 02 30       0375*        dw ps_wav_data_bufferId0
046AAB 0E          0376*        db 14 ; consolidate blocks command
046AAC             0377*    ; vdu_buffer_to_sound command string
046AAC             0378*    ; Command 2: Buffer to sound
046AAC             0379*    ; VDU 23, 0, &85, channel (ignored), 5, 2, bufferId; format, [sampleRate;]
046AAC 17 00 85    0380*        db 23,0,0x85 ; vdu sound command header
046AAF 00          0381*        db 0x00 ; channel (ignored)
046AB0 05          0382*        db 0x05 ; buffer to sound command
046AB1 02          0383*        db 0x02 ; command 2 create sample
046AB2 02 30       0384*        dw ps_wav_data_bufferId0
046AB4 09          0385*        db 1+8 ; 8-bit unsigned PCM mono, 8 = sample rate argument follows
046AB5             0386*    ps_sr0:
046AB5 00 00       0387*        dw 0x0000 ; sample rate Hz
046AB7             0388*    ; vdu_play_sfx command string
046AB7             0389*    ; Command 4: Set waveform
046AB7             0390*    ; VDU 23, 0, &85, channel, 4, waveformOrSample, [bufferId;]
046AB7 17 00 85    0391*        db 23,0,$85 ; vdu sound command header
046ABA 00          0392*        db 0 ; channel
046ABB 04          0393*        db 4 ; set waveform command
046ABC 08          0394*        db 8 ; waveform 8 = sample
046ABD 02 30       0395*        dw ps_wav_data_bufferId0 ; sample bufferId
046ABF             0396*    ; Command 0: Play note
046ABF             0397*    ; VDU 23, 0, &85, channel, 0, volume, frequency; duration;
046ABF 17 00 85    0398*        db 23,0,$85 ; vdu sound command header
046AC2 00          0399*        db 0 ; channel
046AC3 00          0400*        db 0 ; play note command
046AC4 7F          0401*        db 127  ; volume 127 = max
046AC5 00 00       0402*        dw 0 ; frequency (relevant only for tuneable samples)
046AC7 00 00       0403*        dw 0 ; duration (ms), zero means play one time in full
046AC9             0404*    ps_cmd0_end:
046AC9             0405*    
046AC9             0406*    ps_cmd1:
046AC9             0407*    ; Command 14: Consolidate blocks in a buffer
046AC9             0408*    ; VDU 23, 0, &A0, bufferId; 14
046AC9 17 00 A0    0409*        db 23,0,0xA0 ; vdu buffered api command header
046ACC 03 30       0410*        dw ps_wav_data_bufferId1
046ACE 0E          0411*        db 14 ; consolidate blocks command
046ACF             0412*    ; vdu_buffer_to_sound command string
046ACF             0413*    ; Command 2: Buffer to sound
046ACF             0414*    ; VDU 23, 0, &85, channel (ignored), 5, 2, bufferId; format, [sampleRate;]
046ACF 17 00 85    0415*        db 23,0,0x85 ; vdu sound command header
046AD2 00          0416*        db 0x00 ; channel (ignored)
046AD3 05          0417*        db 0x05 ; buffer to sound command
046AD4 02          0418*        db 0x02 ; command 2 create sample
046AD5 03 30       0419*        dw ps_wav_data_bufferId1
046AD7 09          0420*        db 1+8 ; 8-bit unsigned PCM mono, 8 = sample rate argument follows
046AD8             0421*    ps_sr1:
046AD8 00 00       0422*        dw 0x0000 ; sample rate Hz
046ADA             0423*    ; vdu_play_sfx command string
046ADA             0424*    ; Command 4: Set waveform
046ADA             0425*    ; VDU 23, 0, &85, channel, 4, waveformOrSample, [bufferId;]
046ADA 17 00 85    0426*        db 23,0,$85 ; vdu sound command header
046ADD 01          0427*        db 1 ; channel
046ADE 04          0428*        db 4 ; set waveform command
046ADF 08          0429*        db 8 ; waveform 8 = sample
046AE0 03 30       0430*        dw ps_wav_data_bufferId1 ; sample bufferId
046AE2             0431*    ; Command 0: Play note
046AE2             0432*    ; VDU 23, 0, &85, channel, 0, volume, frequency; duration;
046AE2 17 00 85    0433*        db 23,0,$85 ; vdu sound command header
046AE5 01          0434*        db 1 ; channel
046AE6 00          0435*        db 0 ; play note command
046AE7 7F          0436*        db 127  ; volume 127 = max
046AE8 00 00       0437*        dw 0 ; frequency (relevant only for tuneable samples)
046AEA 00 00       0438*        dw 0 ; duration (ms), zero means play one time in full
046AEC             0439*    ps_cmd1_end:
046AEC             0440*    ; end ps_load_audio_cmd_buffers
046AEC             0054         include "sort.inc"
046AEC             0001*    ; Determines the ascending lexical order of two zero-terminated strings
046AEC             0002*    ; Inputs: HL, DE = pointers to strings
046AEC             0003*    ; Returns:
046AEC             0004*    ;   - HL points to the lexically smaller string, DE to the larger (swapped if HL > DE).
046AEC             0005*    ; Flags:
046AEC             0006*    ;   - Z set,   C reset: Strings are equal.
046AEC             0007*    ;   - Z reset, C reset: DE is lexically larger than HL.
046AEC             0008*    ;   - Z reset, C set: DE is lexically smaller than HL.
046AEC             0009*    ; Destroys: A
046AEC             0010*    ; Notes:
046AEC             0011*    ;   - Comparisons are based on ASCII values: punctuation/numbers < uppercase < lowercase.
046AEC             0012*    alpha_asc:
046AEC E5          0013*        push hl
046AED D5          0014*        push de
046AEE             0015*    @loop:
046AEE 1A          0016*        ld a,(de)
046AEF BE          0017*        cp a,(hl)
046AF0 20 05       0018*        jr nz,@done
046AF2 13          0019*        inc de
046AF3 23          0020*        inc hl
046AF4 B7          0021*        or a,a
046AF5 20 F7       0022*        jr nz,@loop
046AF7             0023*    @done:
046AF7 D1          0024*        pop de
046AF8 E1          0025*        pop hl
046AF9 D0          0026*        ret nc
046AFA EB          0027*        ex de,hl
046AFB C9          0028*        ret
046AFC             0029*    ; end alpha_asc
046AFC             0030*    
046AFC             0031*    ; Sorts a list of pointers to zero-terminated strings in ascending lexical order
046AFC             0032*    ; using the selection sort algorithm, which is in-place and stable.
046AFC             0033*    ; Inputs:
046AFC             0034*    ;   - IY: Pointer to the list of string pointers.
046AFC             0035*    ;   - B: Number of items in the list (max 255).
046AFC             0036*    ; Outputs:
046AFC             0037*    ;   - Sorted list of pointers in ascending lexical order.
046AFC             0038*    ; Destroys:
046AFC             0039*    ;   - A, BC, DE, HL, IX.
046AFC             0040*    ; Notes:
046AFC             0041*    ;   - Strings are compared using an unsigned comparison (ASCII-based).
046AFC             0042*    ;   - The algorithm assumes all strings are properly null-terminated.
046AFC             0043*    ;   - The sorting is performed in-place by swapping pointers in the list.
046AFC             0044*    selection_sort_asc:
046AFC A0          0045*        and a,b                  ; Check if B is zero
046AFD C8          0046*        ret z                    ; No need to sort an empty list
046AFE 05          0047*        dec b                    ; We only need to do n-1 loops
046AFF C8          0048*        ret z                    ; No need to sort a single item
046B00 FD E5       0049*        push iy                  ; Save pointer to the list of pointers
046B02             0050*    @outer_loop:
046B02 ED 54 03    0051*        lea ix,iy+3              ; IX = pointer to the next string in the list
046B05 C5          0052*        push bc                  ; Save the outer loop counter
046B06             0053*    @inner_loop:
046B06 C5          0054*        push bc                  ; Save the inner loop counter
046B07 FD 27 00    0055*        ld hl,(iy)               ; HL = address of the current string
046B0A DD 17 00    0056*        ld de,(ix)               ; DE = address of the next string to compare
046B0D CD EC 6A 04 0057*        call alpha_asc           ; Compare (HL) and (DE)
046B11 30 06       0058*        jr nc,@skip_swap         ; If (HL) <= (DE), skip swapping the strings
046B13 FD 2F 00    0059*        ld (iy),hl               ; alpha_asc already did the swap ...
046B16 DD 1F 00    0060*        ld (ix),de               ; ... so we just load as is
046B19             0061*    @skip_swap:
046B19 ED 32 03    0062*        lea ix,ix+3              ; Move to the next pointer
046B1C C1          0063*        pop bc                   ; Restore the inner loop counter
046B1D 10 E7       0064*        djnz @inner_loop         ; Continue the inner loop
046B1F ED 33 03    0065*        lea iy,iy+3              ; Move to the next pointer in the list
046B22 C1          0066*        pop bc                   ; Restore the outer loop counter
046B23 10 DD       0067*        djnz @outer_loop         ; Continue the outer loop
046B25 FD E1       0068*        pop iy                   ; Restore pointer to the list of pointers
046B27 C9          0069*        ret
046B28             0070*    ; end selection_sort_asc
046B28             0071*    
046B28             0072*    ; same as selection_sort_asc, but for sorting fileinfo structs by filename
046B28             0073*    selection_sort_asc_filinfo:
046B28 A0          0074*        and a,b                  ; Check if B is zero
046B29 C8          0075*        ret z                    ; No need to sort an empty list
046B2A 05          0076*        dec b                    ; We only need to do n-1 loops
046B2B C8          0077*        ret z                    ; No need to sort a single item
046B2C FD E5       0078*        push iy                  ; Save pointer to the list of pointers
046B2E             0079*    @outer_loop:
046B2E ED 54 03    0080*        lea ix,iy+3              ; IX = pointer to the next string in the list
046B31 C5          0081*        push bc                  ; Save the outer loop counter
046B32             0082*    @inner_loop:
046B32 C5          0083*        push bc                  ; Save the inner loop counter
046B33 FD 27 00    0084*        ld hl,(iy)               ; HL = address of the current string
046B36 11 15 00 00 0085*        ld de,filinfo_fname-1      ; offset to the filename in the FILINFO struct
046B3A 19          0086*        add hl,de                ; HL = address of the filename
046B3B E5          0087*        push hl                  ; Save the address of the filename
046B3C DD 27 00    0088*        ld hl,(ix)               ; HL = address of the next string to compare
046B3F 19          0089*        add hl,de                ; HL = address of the filename (DE already has the offset)
046B40 EB          0090*        ex de,hl                 ; DE = address of the filename
046B41 E1          0091*        pop hl                   ; HL = address of the current filename
046B42 CD EC 6A 04 0092*        call alpha_asc           ; Compare (HL) and (DE)
046B46 30 0D       0093*        jr nc,@skip_swap         ; If (HL) <= (DE), skip swapping the strings
046B48 01 EB FF FF 0094*        ld bc,-filinfo_fname+1     ; -offset to the filename in the FILINFO struct
046B4C 09          0095*        add hl,bc                ; HL = address of the FILINFO struct
046B4D FD 2F 00    0096*        ld (iy),hl
046B50 EB          0097*        ex de,hl                 ; HL = address of the filename
046B51 09          0098*        add hl,bc                ; HL = address of the FILINFO struct
046B52 DD 2F 00    0099*        ld (ix),hl
046B55             0100*    @skip_swap:
046B55 ED 32 03    0101*        lea ix,ix+3              ; Move to the next pointer
046B58 C1          0102*        pop bc                   ; Restore the inner loop counter
046B59 10 D7       0103*        djnz @inner_loop         ; Continue the inner loop
046B5B ED 33 03    0104*        lea iy,iy+3              ; Move to the next pointer in the list
046B5E C1          0105*        pop bc                   ; Restore the outer loop counter
046B5F 10 CD       0106*        djnz @outer_loop         ; Continue the outer loop
046B61 FD E1       0107*        pop iy                   ; Restore pointer to the list of pointers
046B63 C9          0108*        ret
046B64             0109*    ; end selection_sort_asc_filinfo
046B64             0055         include "timer_jukebox.inc"
046B64             0001*    ; 72000 = 1 tick per second at 18.432 MHz with a 256 clock divider
046B64             0002*    ; but since max is 65536, intervals > 65536/72000 = 0.91 seconds require an additional counter
046B64             0003*    ps_prt_reload: equ 72000/ps_chunks_per_second
046B64             0004*    ; ps_prt_reload: equ 72000/ps_chunks_per_second * 16 ; DEBUG
046B64             0005*    
046B64             0006*    ; start PRT timer
046B64             0007*    ps_prt_start:
046B64 21 B0 04 00 0008*        ld hl,ps_prt_reload
046B68 ED 29 84    0009*        out0 (TMR1_CTL+TMR_RES_LOW),l
046B6B ED 21 85    0010*    	out0 (TMR1_CTL+TMR_RES_HIGH),h
046B6E             0011*    ; disable timer (in effect, reset it)
046B6E 3E 0E       0012*        ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_256 | RST_EN_1 | PRT_EN_0
046B70 ED 39 83    0013*    	out0 (TMR1_CTL+TMR_REG_CTL),a
046B73             0014*    ; enable timer,with interrupt and CONTINUOUS mode,clock divider 256
046B73 3E 5F       0015*        ld a,PRT_IRQ_0 | IRQ_EN_1 | PRT_MODE_1 | CLK_DIV_256 | RST_EN_1 | PRT_EN_1
046B75 ED 39 83    0016*    	out0 (TMR1_CTL+TMR_REG_CTL),a
046B78 C9          0017*        ret
046B79             0018*    
046B79             0019*    ; stop PRT timer
046B79             0020*    ps_prt_stop:
046B79 3E 0E       0021*        ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_256 | RST_EN_1 | PRT_EN_0
046B7B ED 39 83    0022*    	out0 (TMR1_CTL+TMR_REG_CTL),a
046B7E C9          0023*        ret
046B7F             0024*    
046B7F             0025*    ; ===============================================
046B7F             0026*    ; PRT Timer Interrupt Handling
046B7F             0027*    ; https://github.com/tomm/agon-cpu-emulator/blob/main/sdcard/regression_suite/timerirq.asm
046B7F             0028*    ; -----------------------------------------------
046B7F             0029*    ps_prt_irq_init:
046B7F             0030*        ; set up interrupt vector table 2
046B7F 21 00 00 00 0031*    	ld hl,0
046B83 3A 0C 01 00 0032*    	ld a,($10c)
046B87 6F          0033*    	ld l,a
046B88 3A 0D 01 00 0034*    	ld a,($10d)
046B8C 67          0035*    	ld h,a
046B8D             0036*    
046B8D             0037*    	; skip over CALL ($c3)
046B8D 23          0038*    	inc hl
046B8E             0039*    	; load address of jump into vector table 2 (in ram)
046B8E ED 27       0040*    	ld hl,(hl)
046B90             0041*    
046B90             0042*    	; write CALL ps_prt_irq_handler to vector table 2
046B90 3E C3       0043*    	ld a,$c3
046B92 77          0044*    	ld (hl),a
046B93 23          0045*    	inc hl
046B94 11 9B 6B 04 0046*    	ld de,ps_prt_irq_handler
046B98 ED 1F       0047*    	ld (hl),de
046B9A             0048*    
046B9A C9          0049*        ret
046B9B             0050*    ; end ps_prt_irq_init
046B9B             0051*    
046B9B             0052*    ; interrupt routine for playing the next sample
046B9B             0053*    ps_prt_irq_handler:
046B9B F3          0054*        di
046B9C 08          0055*        ex af,af'
046B9D D9          0056*        exx
046B9E             0057*    ; clear sysvar_keyascii
046B9E             0058*    	MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
046B9E 3E 08       0001*M1  			LD	A, function
046BA0 5B CF       0002*M1  			RST.LIL	08h
046BA2 AF          0059*    	xor a
046BA3 DD 77 05    0060*    	ld (IX+sysvar_keyascii),a
046BA6             0061*    ; read the timer interrupt and call the handler
046BA6 ED 38 83    0062*        in0 a,(TMR1_CTL+TMR_REG_CTL)
046BA9 21 85 67 04 0063*        ld hl,ps_mode
046BAD CB 46       0064*        bit ps_mode_playing,(hl)
046BAF CA B7 6B 04 0065*    	jp z,@done ; playback not active so return without doing anything
046BB3 CD AA 68 04 0066*        call ps_read_sample
046BB7             0067*    @done:
046BB7 D9          0068*        exx
046BB8 08          0069*        ex af,af'
046BB9 FB          0070*        ei
046BBA 5B ED 4D    0071*        reti.l
046BBD             0072*    ; end ps_prt_irq_handler
046BBD             0056         include "wav.inc"
046BBD             0001*    ; Fixed WAV offsets assumed by streaming/seeking; this is not a RIFF chunk parser
046BBD             0002*    wav_riff:          EQU 0    ; 4 bytes: "RIFF" identifier
046BBD             0003*    wav_file_size:     EQU 4    ; 4 bytes: Total file size minus 8 bytes for RIFF header
046BBD             0004*    wav_wave:          EQU 8    ; 4 bytes: "WAVE" identifier
046BBD             0005*    wav_fmt_marker:    EQU 12   ; 4 bytes: "fmt " subchunk marker
046BBD             0006*    wav_fmt_size:      EQU 16   ; 4 bytes: Format chunk size (16 for PCM)
046BBD             0007*    wav_audio_format:  EQU 20   ; 2 bytes: Audio format (1 = PCM)
046BBD             0008*    wav_num_channels:  EQU 22   ; 2 bytes: Number of channels (1 = mono, 2 = stereo)
046BBD             0009*    wav_sample_rate:   EQU 24   ; 4 bytes: Sample rate in Hz (e.g., 32768)
046BBD             0010*    wav_byte_rate:     EQU 28   ; 4 bytes: Bytes per second (SampleRate * NumChannels * BitsPerSample / 8)
046BBD             0011*    wav_block_align:   EQU 32   ; 2 bytes: Bytes per sample block (NumChannels * BitsPerSample / 8)
046BBD             0012*    wav_bits_per_sample: EQU 34 ; 2 bytes: Bits per sample (e.g., 8 or 16)
046BBD             0013*    
046BBD             0014*    ; Assumed LIST chunk (extra metadata)
046BBD             0015*    wav_list_marker:   EQU 36   ; 4 bytes: "LIST" marker
046BBD             0016*    wav_list_size:     EQU 40   ; 4 bytes: Size of the LIST chunk (e.g., 26)
046BBD             0017*    wav_info_marker:   EQU 44   ; 4 bytes: "INFO" marker
046BBD             0018*    wav_isft_marker:   EQU 48   ; 4 bytes: "ISFT" marker (software identifier)
046BBD             0019*    wav_isft_size:     EQU 52   ; 4 bytes: Size of the ISFT metadata payload
046BBD             0020*    wav_isft_data:     EQU 56   ; 12-byte assumed span for metadata and RIFF padding
046BBD             0021*    
046BBD             0022*    ; Assumed data chunk
046BBD             0023*    wav_data_marker:   EQU 68   ; 4 bytes: "data" subchunk marker
046BBD             0024*    wav_data_size:     EQU 72   ; 4 bytes: Size of the audio data in bytes
046BBD             0025*    wav_data_start:    EQU 76   ; Start of audio data
046BBD             0026*    wav_header_size:   EQU wav_data_start ; Total Header Size: 76 bytes
046BBD             0027*    
046BBD             0028*    bf_verify_wav:
046BBD FD E5       0029*        push iy ; callers want iy back unmolested
046BBF FD 21 00 1C 0030*        ld iy,bf_wav_header
       08          
046BC4 CD FC 6B 04 0031*        call verify_wav
046BC8 F5          0032*        push af ; save zero flag and a
046BC9             0033*        FFSCALL ffs_fclose ; close the file
                       M1 Args: function=ffs_fclose 
046BC9 FD E5       0001*M1  			PUSH IY
046BCB 3E 81       0002*M1  			LD	A, function
046BCD 5B CF       0003*M1  			RST.LIL	08h
046BCF FD E1       0004*M1  			POP IY
046BD1 F1          0034*        pop af ; restore zero flag and a for return
046BD2 FD E1       0035*        pop iy ; send her home how she came in
046BD4 C9          0036*        ret
046BD5             0037*    ; end bf_verify_wav
046BD5             0038*    
046BD5             0039*    ps_open_wav:
046BD5             0040*    ; get filinfo and fil struct pointers to currently selected file
046BD5 CD C3 3F 04 0041*        call bf_get_filinfo_from_pg_idx ; iy = pointer to filinfo struct
046BD9 ED 13 16    0042*        lea de,iy+filinfo_fname ; de = pointer to filename
046BDC 21 00 00 09 0043*        ld hl,ps_fil_struct
046BE0             0044*    
046BE0             0045*    ; verify a valid .wav file
046BE0 FD E5       0046*        push iy
046BE2 FD 21 00 03 0047*        ld iy,ps_wav_header
       09          
046BE7 CD FC 6B 04 0048*        call verify_wav
046BEB C2 F9 6B 04 0049*        jp nz,@done ; is good file so return without closing
046BEF             0050*    
046BEF             0051*    ; not a good file so close it and return failure
046BEF F5          0052*        push af ; save zero flag and a
046BF0             0053*        FFSCALL ffs_fclose ; close the file
                       M1 Args: function=ffs_fclose 
046BF0 FD E5       0001*M1  			PUSH IY
046BF2 3E 81       0002*M1  			LD	A, function
046BF4 5B CF       0003*M1  			RST.LIL	08h
046BF6 FD E1       0004*M1  			POP IY
046BF8 F1          0054*        pop af ; restore zero flag and a for return
046BF9             0055*    @done:
046BF9 FD E1       0056*        pop iy
046BFB C9          0057*        ret
046BFC             0058*    ; end ps_open_wav
046BFC             0059*    
046BFC             0060*    ; verify that a file is a .wav file
046BFC             0061*    ; inputs: hl = pointer to fil struct, de = pointer to filename
046BFC             0062*    ; returns: a = 0 and zero flag set if not a file we can read
046BFC             0063*    ;          zero flag reset and a = 1 if a valid .wav file
046BFC             0064*    ; destroys: af
046BFC             0065*    verify_wav:
046BFC             0066*    ; back up registers
046BFC C5          0067*        push bc
046BFD DD E5       0068*        push ix
046BFF             0069*    
046BFF             0070*    ; callers need the file structure pointer preserved for fclose
046BFF E5          0071*        push hl
046C00 D5          0072*        push de
046C01             0073*    
046C01             0074*    ; clear the .wav header buffer
046C01 E5          0075*        push hl
046C02 D5          0076*        push de
046C03 01 4C 00 00 0077*        ld bc,wav_header_size
046C07 ED 23 00    0078*        lea hl,iy+0 ; bf or ps wav_header
046C0A CD D4 03 04 0079*        call clear_mem
046C0E D1          0080*        pop de
046C0F E1          0081*        pop hl
046C10             0082*    
046C10             0083*    ; open the file
046C10 0E 01       0084*        ld c,fa_read
046C12             0085*        FFSCALL ffs_fopen
                       M1 Args: function=ffs_fopen 
046C12 FD E5       0001*M1  			PUSH IY
046C14 3E 80       0002*M1  			LD	A, function
046C16 5B CF       0003*M1  			RST.LIL	08h
046C18 FD E1       0004*M1  			POP IY
046C1A             0086*    
046C1A             0087*    ; read the header
046C1A 01 4C 00 00 0088*        ld bc,wav_header_size
046C1E ED 13 00    0089*        lea de,iy+0 ; bf or ps wav_header
046C21             0090*        FFSCALL ffs_fread
                       M1 Args: function=ffs_fread 
046C21 FD E5       0001*M1  			PUSH IY
046C23 3E 82       0002*M1  			LD	A, function
046C25 5B CF       0003*M1  			RST.LIL	08h
046C27 FD E1       0004*M1  			POP IY
046C29             0091*    
046C29             0092*    ; verify the .wav header
046C29             0093*    
046C29 FD 27 00    0094*        ld hl,(iy+wav_riff)
046C2C 11 52 49 46 0095*        ld de,0x464952  ; ascii for "RIF" in little-endian order
046C30 B7          0096*        or a ; clear carry
046C31 ED 52       0097*        sbc hl,de
046C33 20 30       0098*        jr nz,@not_wav
046C35             0099*    
046C35 FD 27 08    0100*        ld hl,(iy+wav_wave)
046C38 11 57 41 56 0101*        ld de,0x564157  ; ascii for "WAV" in little-endian order
046C3C B7          0102*        or a ; clear carry
046C3D ED 52       0103*        sbc hl,de
046C3F 20 24       0104*        jr nz,@not_wav
046C41             0105*    
046C41 FD 27 14    0106*        ld hl,(iy+wav_audio_format)
046C44 11 01 00 01 0107*        ld de,0x010001  ; PCM format, 1-channel
046C48 B7          0108*        or a ; clear carry
046C49 ED 52       0109*        sbc hl,de
046C4B 20 18       0110*        jr nz,@not_wav
046C4D             0111*    
046C4D FD 27 0C    0112*        ld hl,(iy+wav_fmt_marker)
046C50 11 66 6D 74 0113*        ld de,0x746D66  ; ascii for "fmt" in little-endian order
046C54 B7          0114*        or a ; clear carry
046C55 ED 52       0115*        sbc hl,de
046C57 28 08       0116*        jr z,@is_wav
046C59 18 0A       0117*        jr @not_wav
046C5B             0118*    @done:
046C5B             0119*    ; restore registers and return
046C5B D1          0120*        pop de
046C5C E1          0121*        pop hl
046C5D DD E1       0122*        pop ix
046C5F C1          0123*        pop bc
046C60 C9          0124*        ret
046C61             0125*    @is_wav:
046C61 AF          0126*        xor a
046C62 3C          0127*        inc a ; reset zero flag and a = 1 indicating .wav file
046C63 18 F6       0128*        jr @done
046C65             0129*    @not_wav:
046C65 AF          0130*        xor a ; set zero flag and a = 0 indicating unreadable file
046C66 18 F3       0131*        jr @done
046C68             0132*    ; end verify_wav

040E7C CD 8D 20 04 0018*        call vdu_font_create
040E80             0019*    ; all done
040E80 C9          0020*        ret
040E81             0036         include "fixed168.inc"
040E81             0001*    ; multiply a signed 24-bit number by an unsigned 8-bit number giving a signed 24-bit result
040E81             0002*    ; uses EZ80 MLT instruction for speed
040E81             0003*    ; operation: UHL * A --> UHL
040E81             0004*    ; destroys: AF, HL
040E81             0005*    smul24x8:
040E81             0006*    ; make hl positive and store sign flag
040E81 CD 0D 05 04 0007*        call hlu_abs
040E85 F5          0008*        push af
040E86             0009*    ; do the division
040E86 CD 91 0E 04 0010*        call mul24x8 ; hl = product
040E8A             0011*    ; adjust sign of result
040E8A F1          0012*        pop af ; sign de
040E8B F0          0013*        ret p ; hl was positive, nothing to do
040E8C CD 1D 05 04 0014*        call neg_hlu ; result is negative
040E90 C9          0015*        ret
040E91             0016*    
040E91             0017*    ; unsigned multiplication of a 24-bit and 8-bit number giving a 32-bit result
040E91             0018*    ; uses EZ80 MLT instruction for speed
040E91             0019*    ; operation: UHL * A --> AUHL
040E91             0020*    ; destroys: AF, HL
040E91             0021*    mul24x8:
040E91 D5          0022*        push de ; preserve de
040E92             0023*    ; low byte
040E92 5D          0024*        ld e,l
040E93 57          0025*        ld d,a
040E94 ED 5C       0026*        mlt de
040E96 6B          0027*        ld l,e ; product low byte
040E97 08          0028*        ex af,af' ; save multiplier
040E98 7A          0029*        ld a,d ; carry
040E99 08          0030*        ex af,af' ; save carry, restore multiplier
040E9A             0031*    ; high byte
040E9A 5C          0032*        ld e,h
040E9B 57          0033*        ld d,a
040E9C ED 5C       0034*        mlt de
040E9E 08          0035*        ex af,af' ; save multiplier, restore carry
040E9F 83          0036*        add a,e ; add carry
040EA0 67          0037*        ld h,a ; product middle byte
040EA1 7A          0038*        ld a,d ; carry
040EA2 08          0039*        ex af,af' ; save carry, restore multiplier
040EA3             0040*    ; upper byte
040EA3 22 BE 0E 04 0041*        ld (@scratch),hl ; 7 cycles
040EA7 5F          0042*        ld e,a
040EA8 3A C0 0E 04 0043*        ld a,(@scratch+2)
040EAC 57          0044*        ld d,a
040EAD ED 5C       0045*        mlt de
040EAF 08          0046*        ex af,af' ; restore carry
040EB0 8B          0047*        adc a,e ; add carry
040EB1 32 C0 0E 04 0048*        ld (@scratch+2),a ; 5 cycles
040EB5 2A BE 0E 04 0049*        ld hl,(@scratch) ; 7 cycles
040EB9             0050*    ; highest byte
040EB9 3E 00       0051*        ld a,0 ; preserve carry flag
040EBB 8A          0052*        adc a,d ; product highest byte
040EBC D1          0053*        pop de ; restore de
040EBD C9          0054*        ret
040EBE             0055*    @scratch: ds 3
040EC1             0056*    
       FF FF FF 
040EC1 00 00 00 00 0057*    mul24out: blkb 6,0
       00 00       
040EC7             0058*    
040EC7             0059*    ; unsigned multiplication of two 24-bit numbers giving a 48-bit result
040EC7             0060*    ; operation: UHL * UDE --> mul24out
040EC7             0061*    mul24:
040EC7 DD E5       0062*        push ix ; preserve
040EC9             0063*    ; point to output buffer and clear it
040EC9 DD 21 C1 0E 0064*        ld ix,mul24out
       04          
040ECE C5          0065*        push bc
040ECF 01 00 00 00 0066*        ld bc,0
040ED3 DD 0F 00    0067*        ld (ix),bc
040ED6 DD 0F 03    0068*        ld (ix+3),bc
040ED9 C1          0069*        pop bc
040EDA             0070*    ; STEP 1: UHL * E
040EDA 7B          0071*        ld a,e
040EDB E5          0072*        push hl
040EDC CD 91 0E 04 0073*        call mul24x8
040EE0 DD 2F 00    0074*        ld (ix+0),hl
040EE3 DD 77 03    0075*        ld (ix+3),a
040EE6             0076*    ; STEP 2: UHL * D
040EE6 E1          0077*        pop hl
040EE7 E5          0078*        push hl
040EE8 7A          0079*        ld a,d
040EE9 CD 91 0E 04 0080*        call mul24x8
040EED CD 06 0F 04 0081*        call @accumulate
040EF1             0082*    ; STEP 3: UHL * DEU
040EF1 E1          0083*        pop hl
040EF2 ED 53 36 0F 0084*        ld (@de),de
       04          
040EF7 3A 38 0F 04 0085*        ld a,(@de+2)
040EFB CD 91 0E 04 0086*        call mul24x8
040EFF CD 06 0F 04 0087*        call @accumulate
040F03             0088*    ; all done
040F03 DD E1       0089*        pop ix ; restore
040F05 C9          0090*        ret
040F06             0091*    @accumulate:
040F06 DD 23       0092*        inc ix
040F08             0093*    ; highest byte of product to carry
040F08 DD 77 03    0094*        ld (ix+3),a
040F0B             0095*    ; low byte of product
040F0B 7D          0096*        ld a,l
040F0C DD 86 00    0097*        add a,(ix+0)
040F0F DD 77 00    0098*        ld (ix+0),a
040F12             0099*    ; high byte of product
040F12 7C          0100*        ld a,h
040F13 DD 8E 01    0101*        adc a,(ix+1)
040F16 DD 77 01    0102*        ld (ix+1),a
040F19             0103*    ; uppper byte of product
040F19 22 33 0F 04 0104*        ld (@hl),hl
040F1D 3A 35 0F 04 0105*        ld a,(@hl+2)
040F21 DD 8E 02    0106*        adc a,(ix+2)
040F24 DD 77 02    0107*        ld (ix+2),a
040F27             0108*    ; carry
040F27 3E 00       0109*        ld a,0 ; preserve flags
040F29 DD 8E 03    0110*        adc a,(ix+3)
040F2C DD 77 03    0111*        ld (ix+3),a
040F2F C9          0112*        ret
040F30             0113*    
040F30 00 00 00    0114*    @ix: dl 0
040F33 00 00 00    0115*    @hl: dl 0
040F36 00 00 00    0116*    @de: dl 0
040F39             0117*    
040F39             0118*    ; ; UHL * UDE --> UHL (unsigned)
040F39             0119*    ; umul24:
040F39             0120*    ;     call mul24
040F39             0121*    ;     ld hl,(mul24out)
040F39             0122*    ;     ret
040F39             0123*    
040F39             0124*    ; UH.L = UH.L*UD.E (unsigned)
040F39             0125*    umul168:
040F39 CD C7 0E 04 0126*        call mul24
040F3D 2A C2 0E 04 0127*        ld hl,(mul24out+1)
040F41 C9          0128*        ret
040F42             0129*    
040F42             0130*    ; UH.L * UD.E --> UH.L (signed)
040F42             0131*    smul168:
040F42             0132*    ; make everything positive and store sign flags
040F42 CD 0D 05 04 0133*        call hlu_abs
040F46 F5          0134*        push af
040F47 EB          0135*        ex de,hl
040F48 CD 0D 05 04 0136*        call hlu_abs
040F4C EB          0137*        ex de,hl
040F4D F5          0138*        push af
040F4E             0139*    ; do the division
040F4E CD 39 0F 04 0140*        call umul168 ; hl = product
040F52             0141*    ; adjust sign of result
040F52 F1          0142*        pop af ; sign de
040F53 FA 5E 0F 04 0143*        jp m,@de_neg
040F57 F1          0144*        pop af ; sign hl
040F58 F0          0145*        ret p ; both positive, nothing to do
040F59             0146*    @hl_neg:
040F59 CD 1D 05 04 0147*        call neg_hlu ; de pos, hl neg, result is negative
040F5D C9          0148*        ret
040F5E             0149*    @de_neg:
040F5E F1          0150*        pop af

04335A C9          0415*        ret
04335B             0416*    
04335B             0417*    ; print a floating point number in decimal format
04335B             0418*    ; inputs: HL'H'L'C is the number to print
04335B             0419*    ; outputs: number printed to screen
04335B             0420*    ;          ACCS null-terminated string representation of the number
04335B             0421*    ; destroys: everything except ix
04335B             0422*    print_float_dec:
04335B             0423*    print_float_dec_nor:
04335B DD E5       0424*        push ix             ; preserve
04335D             0425*    
04335D             0426*    ; back up floats in normal and alternate registers
04335D DD 21 9E 33 0427*        ld ix,@float_nor
       04          
043362 CD C7 31 04 0428*        call store_float_nor
043366 DD 21 A3 33 0429*        ld ix,@float_alt
       04          
04336B CD EB 31 04 0430*        call store_float_alt
04336F             0431*    
04336F             0432*    ; convert the number to a string
04336F 11 00 34 04 0433*        ld de,ACCS          ; point to the string accumulator
043373 DD 21 9B 33 0434*        ld ix,@G9-1         ; get the format code for the number
       04          
043378 CD 84 2B 04 0435*        call STR_FP         ; convert the number to a string
04337C EB          0436*        ex de,hl            ; point to end of the string
04337D 36 00       0437*        ld (hl),0           ; null-terminate the string
04337F 21 00 34 04 0438*        ld hl,ACCS          ; point to the string accumulator
043383 CD 67 00 04 0439*        call printString
043387             0440*    
043387             0441*    ; restore floats in normal and alternate registers
043387 DD 21 9E 33 0442*        ld ix,@float_nor
       04          
04338C CD D9 31 04 0443*        call fetch_float_nor
043390 DD 21 A3 33 0444*        ld ix,@float_alt
       04          
043395 CD FD 31 04 0445*        call fetch_float_alt
043399             0446*    
043399             0447*    ; cleanup and go home
043399 DD E1       0448*        pop ix              ; restore
04339B C9          0449*        ret
04339C 09 00       0450*    @G9:			DW    9
04339E             0451*    @float_nor: ds 5
0433A3             0452*    @float_alt: ds 5
0433A8             0453*    
0433A8             0454*    print_float_dec_alt:
       FF FF FF FF 
       FF FF FF FF 
       FF FF 
0433A8 CD 6A 31 04 0455*        CALL SWAP
0433AC CD 5B 33 04 0456*        CALL print_float_dec_nor
0433B0 CD 6A 31 04 0457*        CALL SWAP
0433B4 C9          0458*        ret

041B7C             0029*    
041B7C             0030*    ; VDU 4: Write text at text cursor
041B7C             0031*    ; This causes text to be written at th current text cursor position. This is the default mode for text display.
041B7C             0032*    ; inputs: none
041B7C             0033*    ; prerequisites: the text cursor at the intended position on screen
041B7C             0034*    ; outputs: none
041B7C             0035*    ; destroys: af
041B7C             0036*    vdu_text_to_text_cursor:
041B7C 3E 04       0037*        ld a,4
041B7E 5B D7       0038*        rst.lil $10
041B80 C9          0039*        ret
041B81             0040*    ; end vdu_text_to_text_cursor
041B81             0041*    
041B81             0042*    ; set the text cursor to a specified location and print a string there
041B81             0043*    ; inputs: hl = address of string to print, c,b = x,y text coordinates
041B81             0044*    ; outputs: text
041B81             0045*    ; destroys: af, bc, hl
041B81             0046*    ; affects: moves text cursor to position after final char printed by default
041B81             0047*    ;          unless overridden by VDU 23, 16 cursor control command settings
041B81             0048*    ;          all subsequent print commands (rst.lil $10 or $18) will go to the text cursor
041B81             0049*    vdu_print_to_text_location:
041B81 E5          0050*        push hl ; preserve string pointer
041B82 3E 04       0051*        ld a,4 ; VDU 4 char to text cursor
041B84 5B D7       0052*        rst.lil $10
041B86 CD BE 1B 04 0053*        call vdu_move_cursor
041B8A E1          0054*        pop hl ; restore string pointer
041B8B CD 67 00 04 0055*        call printString
041B8F C9          0056*        ret
041B90             0057*    ; end vdu_print_at_text_location
041B90             0058*    
041B90             0059*    ; VDU 5: Write text at graphics cursor
041B90             0060*    ; inputs: none
041B90             0061*    ; prerequisites: the graphics cursor at the intended position on screen
041B90             0062*    ; outputs: none
041B90             0063*    ; destroys: af
041B90             0064*    vdu_text_to_gfx_cursor:
041B90 3E 05       0065*        ld a,5
041B92 5B D7       0066*    	rst.lil $10
041B94 C9          0067*    	ret
041B95             0068*    ; end vdu_char_to_gfx_cursor
041B95             0069*    
041B95             0070*    ; set the graphics cursor to a specified location and print a string there
041B95             0071*    ; inputs: hl = address of string to print, bc,de = x,y graphics coordinates
041B95             0072*    ; outputs: text
041B95             0073*    ; destroys: af, bc, de, hl
041B95             0074*    ; affects: moves graphics cursor to position after final char printed by default
041B95             0075*    ;          unless overridden by setting bit 6 of the cursor control register (VDU 23, 16)
041B95             0076*    ;          all subsequent print commands (rst.lil $10 or $18) will go to the graphics cursor
041B95             0077*    vdu_print_to_gfx_location:
041B95 E5          0078*        push hl ; preserve string pointer
041B96 3E 44       0079*        ld a,plot_pt+mv_abs
041B98 CD 06 21 04 0080*        call vdu_plot ; moves the graphics cursor to the specified location
041B9C 3E 05       0081*        ld a,5 ; VDU 5 char to gfx cursor
041B9E 5B D7       0082*        rst.lil $10
041BA0 E1          0083*        pop hl ; restore string pointer
041BA1 01 00 00 00 0084*        ld bc,0
041BA5 3E 00       0085*        ld a,0
041BA7 5B DF       0086*        rst.lil $18 ; print the string
041BA9 C9          0087*        ret
041BAA             0088*    ; end vdu_print_at_gfx_location
041BAA             0089*    

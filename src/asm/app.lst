04017D             0253*    ; This routine converts the unsigned 24-bit value in HLU into its ASCII representation,
04017D             0254*    ; starting to memory location pointing by DE, in decimal form and with leading zeroes
04017D             0255*    ; so it will allways be 8 characters length
04017D             0256*    ; HL : Value to convert to string
04017D             0257*    ; DE : pointer to buffer, at least 8 byte + 0
04017D             0258*    u24_to_ascii:
04017D 01 80 69 67 0259*        LD BC,-10000000
040181 CD B4 01 04 0260*        CALL one_digit
040185 01 C0 BD F0 0261*        LD BC,-1000000
040189 CD B4 01 04 0262*        CALL one_digit
04018D 01 60 79 FE 0263*        LD BC,-100000
040191 CD B4 01 04 0264*        CALL one_digit
040195 01 F0 D8 FF 0265*        LD BC,-10000
040199 CD B4 01 04 0266*        CALL one_digit
04019D             0267*    u8_to_ascii: ; same arguments but hl <= 255, uhl and h = 0
04019D 01 18 FC FF 0268*        LD BC,-1000
0401A1 CD B4 01 04 0269*        CALL one_digit

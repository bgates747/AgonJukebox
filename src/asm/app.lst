042385             0045         include "fpp.inc"
042385             0001*    ;
042385             0002*    ; Title:	BBC Basic Interpreter - Z80 version
042385             0003*    ;		Z80 Floating Point Package
042385             0004*    ; Author:	(C) Copyright  R.T.Russell  1986
042385             0005*    ; Modified By:	Dean Belfield
042385             0006*    ; Created:	03/05/2022
042385             0007*    ; Last Updated:	07/06/2023
042385             0008*    ;
042385             0009*    ; Modinfo:
042385             0010*    ; 26/10/1986:	Version 0.0
042385             0011*    ; 14/12/1988:	Vesion 0.1 (Bug Fix)
042385             0012*    ; 12/05/2023:	Modified by Dean Belfield
042385             0013*    ; 07/06/2023:	Modified to run in ADL mode
042385             0014*    
042385             0015*    			; .ASSUME	ADL = 1
042385             0016*    
042385             0017*    			; SEGMENT CODE
042385             0018*    
042385             0019*    			; XDEF	FPP
042385             0020*    			; XDEF	DLOAD5
042385             0021*    			; XDEF	DLOAD5_SPL
042385             0022*    ;
042385             0023*    ;BINARY FLOATING POINT REPRESENTATION:
042385             0024*    ;   32 BIT SIGN-MAGNITUDE NORMALIZED MANTISSA
042385             0025*    ;    8 BIT EXCESS-128 SIGNED EXPONENT
042385             0026*    ;   SIGN BIT REPLACES MANTISSA MSB (IMPLIED "1")
042385             0027*    ;   MANTISSA=0 & EXPONENT=0 IMPLIES VALUE IS ZERO.
042385             0028*    ;
042385             0029*    ;BINARY INTEGER REPRESENTATION:
042385             0030*    ;   32 BIT 2'S-COMPLEMENT SIGNED INTEGER
042385             0031*    ;    "EXPONENT" BYTE = 0 (WHEN PRESENT)
042385             0032*    ;
042385             0033*    ;NORMAL REGISTER ALLOCATION: MANTISSA - HLH'L'
042385             0034*    ;                            EXPONENT - C
042385             0035*    ;ALTERNATE REGISTER ALLOCATION: MANTISSA - DED'E'
042385             0036*    ;                               EXPONENT - B
042385             0037*    
042385             0038*    ;
042385             0039*    ;Error codes:
042385             0040*    ;
042385             0041*    
042385             0042*    BADOP:			EQU     1               ;Bad operation code
042385             0043*    DIVBY0:			EQU     18              ;Division by zero
042385             0044*    TOOBIG_FP:			EQU     20              ;Too big
042385             0045*    NGROOT:			EQU     21              ;Negative root
042385             0046*    LOGRNG:			EQU     22              ;Log range
042385             0047*    ACLOST:			EQU     23              ;Accuracy lost
042385             0048*    EXPRNG:			EQU     24              ;Exp range
042385             0049*    ;
042385             0050*    ;Call entry and despatch code:
042385             0051*    ;
042385 FD E5       0052*    FPP:			PUSH    IY              ;Save IY
042387 FD 21 00 00 0053*            		LD      IY,0
       00          
04238C FD 39       0054*            		ADD     IY,SP           ;Save SP in IY
04238E CD 9E 23 04 0055*            		CALL    OP              ;Perform operation
042392 BF          0056*            		CP      A               ;Good return (Z, NC)
042393 FD E1       0057*    EXIT_FP_:			POP     IY              ;Restore IY
042395 C9          0058*            		RET                     ;Return to caller
042396             0059*    ;
042396             0060*    ;Error exit:
042396             0061*    ;
042396 3E 01       0062*    BAD_FP:			LD      A,BADOP         ;"Bad operation code"
042398 FD F9       0063*    ERROR_FP_:			LD      SP,IY           ;Restore SP from IY
04239A B7          0064*            		OR      A               ;Set NZ
04239B 37          0065*            		SCF                     ;Set C
04239C 18 F5       0066*            		JR      EXIT_FP_
04239E             0067*    ;
04239E             0068*    ;Perform operation or function:
04239E             0069*    ;
04239E             0070*    ; OP:			CP      (RTABLE-DTABLE)/3
04239E FE 2A       0071*    OP:				CP      RTABLE-DTABLE/3 ; ez80asm doesn't do nested expressions
0423A0             0072*    
0423A0 30 F4       0073*            		JR      NC,BAD_FP
0423A2             0074*            		; CP      (FTABLE-DTABLE)/3
0423A2 FE 10       0075*    				CP      FTABLE-DTABLE/3 ; ditto
0423A4 30 08       0076*            		JR      NC,DISPAT_FP
0423A6 08          0077*            		EX      AF,AF'
0423A7 78          0078*            		LD      A,B
0423A8 B1          0079*            		OR      C               ;Both integer?
0423A9 C4 B1 2E 04 0080*            		CALL    NZ,FLOATA       ;No, so float both
0423AD 08          0081*            		EX      AF,AF'
0423AE E5          0082*    DISPAT_FP:			PUSH    HL
0423AF 21 C1 23 04 0083*            		LD      HL,DTABLE
0423B3 C5          0084*            		PUSH    BC
0423B4 01 03 00 00 0085*    			LD	BC, 3		; C = 3
0423B8 47          0086*    			LD	B, A 		; B = op-code
0423B9 ED 4C       0087*    			MLT 	BC 		;BC = op-code * 3
0423BB 09          0088*    			ADD	HL, BC 		;Add to table base
0423BC ED 27       0089*    			LD	HL, (HL)	;Get the routine address (24-bit)
0423BE             0090*    
0423BE             0091*    ;        		ADD     A, A            ;A = op-code * 2
0423BE             0092*    ;        		LD      C,A
0423BE             0093*    ;        		LD      B,0             ;BC = op-code * 2
0423BE             0094*    ;        		ADD     HL,BC
0423BE             0095*    ;        		LD      A,(HL)          ;Get low byte
0423BE             0096*    ;        		INC     HL
0423BE             0097*    ;        		LD      H,(HL)          ;Get high byte
0423BE             0098*    ;        		LD      L,A
0423BE             0099*    
0423BE C1          0100*            		POP     BC
0423BF E3          0101*            		EX      (SP),HL
0423C0 C9          0102*            		RET                     ;Off to routine
0423C1             0103*    ;
0423C1             0104*    ;Despatch table:
0423C1             0105*    ;
0423C1 73 24 04    0106*    DTABLE:			DW24  IAND            ;AND (INTEGER)
0423C4 E1 24 04    0107*            		DW24  IBDIV           ;DIV
0423C7 86 24 04    0108*            		DW24  IEOR            ;EOR
0423CA AC 24 04    0109*            		DW24  IMOD            ;MOD
0423CD 99 24 04    0110*            		DW24  IOR             ;OR
0423D0 67 27 04    0111*            		DW24  ILE             ;<=
0423D3 76 27 04    0112*            		DW24  INE             ;<>
0423D6 5A 27 04    0113*            		DW24  IGE             ;>=
0423D9 3F 27 04    0114*            		DW24  ILT             ;<
0423DC 83 27 04    0115*            		DW24  IEQ             ;=
0423DF CF 25 04    0116*            		DW24  IMUL            ;*
0423E2 0A 25 04    0117*            		DW24  IADD            ;+
0423E5 4C 27 04    0118*            		DW24  IGT             ;>
0423E8 F1 24 04    0119*            		DW24  ISUB            ;-
0423EB 86 26 04    0120*            		DW24  IPOW            ;^
0423EE 7C 25 04    0121*            		DW24  IDIV            ;/
0423F1             0122*    ;
0423F1             0123*    FTABLE:
0423F1 95 27 04    0124*    				DW24  ABSV_FP            ;ABS
0423F4 7B 2B 04    0125*            		DW24  ACS_FP             ;ACS
0423F7 B9 2A 04    0126*            		DW24  ASN_FP             ;ASN
0423FA E9 2A 04    0127*            		DW24  ATN_FP             ;ATN
0423FD B4 28 04    0128*            		DW24  COS_FP             ;COS
042400 C3 27 04    0129*            		DW24  DEG_FP             ;DEG
042403 70 29 04    0130*            		DW24  EXP_FP             ;EXP
042406 17 28 04    0131*            		DW24  INT_FP_            ;INT
042409 0E 2A 04    0132*            		DW24  LN_FP              ;LN
04240C A3 2A 04    0133*            		DW24  LOG_FP             ;LOG
04240F A1 27 04    0134*            		DW24  NOTK_FP            ;NOT
042412 CD 27 04    0135*            		DW24  RAD_FP             ;RAD
042415 E8 27 04    0136*            		DW24  SGN_FP             ;SGN
042418 C1 28 04    0137*            		DW24  SIN_FP             ;SIN
04241B 30 28 04    0138*            		DW24  SQR_FP             ;SQR
04241E 8E 28 04    0139*            		DW24  TAN_FP             ;TAN
042421             0140*    ;
042421 3E 2F 04    0141*    		        DW24  ZERO_FP            ;ZERO
042424 49 29 04    0142*            		DW24  FONE_FP            ;FONE
042427 88 27 04    0143*            		DW24  TRUE_FP            ;TRUE
04242A B5 27 04    0144*            		DW24  PI_FP              ;PI
04242D             0145*    ;
04242D FC 27 04    0146*    		        DW24  VAL_FP             ;VAL
042430 84 2B 04    0147*            		DW24  STR_FP             ;STR$
042433             0148*    ;
042433 E5 2D 04    0149*            		DW24  SFIX_FP            ;FIX
042436 C1 2E 04    0150*            		DW24  SFLOAT_FP          ;FLOAT
042439             0151*    ;
042439 0F 2F 04    0152*    		        DW24  FTEST_FP           ;TEST
04243C 21 2F 04    0153*            		DW24  FCOMP_FP           ;COMPARE
04243F             0154*    ;
04243F 6F 24 04    0155*    RTABLE:			DW24  FAND            ;AND (FLOATING-POINT)
042442 DD 24 04    0156*            		DW24  FBDIV           ;DIV
042445 82 24 04    0157*            		DW24  FEOR            ;EOR
042448 A8 24 04    0158*            		DW24  FMOD            ;MOD
04244B 95 24 04    0159*            		DW24  FFOR             ;OR
04244E 61 27 04    0160*            		DW24  FLE             ;<=
042451 70 27 04    0161*            		DW24  FNE             ;<>
042454 54 27 04    0162*            		DW24  FGE             ;>=
042457 39 27 04    0163*            		DW24  FLT             ;<
04245A 7D 27 04    0164*            		DW24  FEQ             ;=
04245D 29 26 04    0165*            		DW24  FMUL            ;*
042460 17 25 04    0166*            		DW24  FADD            ;+
042463 46 27 04    0167*            		DW24  FGT             ;>
042466 FE 24 04    0168*            		DW24  FSUB            ;-
042469 06 27 04    0169*            		DW24  FPOW            ;^
04246C 80 25 04    0170*            		DW24  FDIV            ;/
04246F             0171*    ;
04246F             0172*    ;       PAGE
04246F             0173*    ;
04246F             0174*    ;ARITHMETIC AND LOGICAL OPERATORS:
04246F             0175*    ;All take two arguments, in HLH'L'C & DED'E'B.
04246F             0176*    ;Output in HLH'L'C
04246F             0177*    ;All registers except IX, IY destroyed.
04246F             0178*    ; (N.B. FPOW destroys IX).
04246F             0179*    ;
04246F             0180*    ;FAND - Floating-point AND.
04246F             0181*    ;IAND - Integer AND.
04246F             0182*    ;
04246F CD D9 2D 04 0183*    FAND:			CALL    FIX2
042473 7C          0184*    IAND:			LD      A,H
042474 A2          0185*            		AND     D
042475 67          0186*            		LD      H,A
042476 7D          0187*            		LD      A,L
042477 A3          0188*            		AND     E
042478 6F          0189*            		LD      L,A
042479 D9          0190*            		EXX
04247A 7C          0191*            		LD      A,H
04247B A2          0192*            		AND     D
04247C 67          0193*            		LD      H,A
04247D 7D          0194*            		LD      A,L
04247E A3          0195*            		AND     E
04247F 6F          0196*            		LD      L,A
042480 D9          0197*            		EXX
042481 C9          0198*            		RET
042482             0199*    ;
042482             0200*    ;FEOR - Floating-point exclusive-OR.
042482             0201*    ;IEOR - Integer exclusive-OR.
042482             0202*    ;
042482 CD D9 2D 04 0203*    FEOR:			CALL    FIX2
042486 7C          0204*    IEOR:			LD      A,H
042487 AA          0205*            		XOR     D
042488 67          0206*            		LD      H,A
042489 7D          0207*            		LD      A,L
04248A AB          0208*            		XOR     E
04248B 6F          0209*            		LD      L,A
04248C D9          0210*            		EXX
04248D 7C          0211*            		LD      A,H
04248E AA          0212*            		XOR     D
04248F 67          0213*            		LD      H,A
042490 7D          0214*            		LD      A,L
042491 AB          0215*            		XOR     E
042492 6F          0216*            		LD      L,A
042493 D9          0217*            		EXX
042494 C9          0218*            		RET

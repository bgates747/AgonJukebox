04111D CD 0D 05 04 0474*        call hlu_abs ; if x was negative this also sets the sign flag
041121 E5          0475*        push hl ; store abs(x)
041122 C1          0476*        pop bc ; bc = abs(x)
041123 F5          0477*        push af ; store sign of x
041124             0478*    ; get abs(y) and store its original sign
041124 EB          0479*        ex de,hl ; hl = y
041125 CD 0D 05 04 0480*        call hlu_abs ; if y was negative this also sets the sign flag
041129 EB          0481*        ex de,hl ; de = abs(y)

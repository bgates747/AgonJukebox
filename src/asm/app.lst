044124             0359*    ps_seek_back:
044124             0360*    ; stop the PRT timer and disable interrupts
044124 CD 79 6B 04 0361*        call ps_prt_stop ; stop the PRT timer
044128             0362*    ; negate seek rate
044128 ED 5B 99 67 0363*        ld de,(ps_seek_rate)
       04          
04412D 21 00 00 00 0364*        ld hl,0
044131 B7          0365*        or a ; clear carry
044132 ED 52       0366*        sbc hl,de ; hl -seek_rate
044134 C3 40 41 04 0367*        jp ps_seek

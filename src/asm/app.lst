0433B5             0460*    ;PI - Return PI (3.14159265)
0433B5             0461*    ;Result is floating-point numeric.
0433B5             0462*    ;
0433B5 11 0F 49 00 0463*    pi_alt:			LD      DE,0x490F
0433B9 D9          0464*            		EXX
0433BA 11 A2 DA 00 0465*            		LD      DE,0xDAA2
0433BE D9          0466*            		EXX
0433BF 06 81       0467*            		LD      B,0x81
0433C1 AF          0468*            		XOR     A               ;NUMERIC MARKER
0433C2 C9          0469*            		RET
0433C3             0470*    
0433C3             0471*    ;PI - Return PI * 2 (6.28318531)

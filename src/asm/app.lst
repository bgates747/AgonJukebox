0418D2             0037         include "time.inc"
0418D2             0001*    ; Convert seconds to HH:MM:SS format.
0418D2             0002*    ; inputs: hl = seconds
0418D2             0003*    ; outputs: hl = pointer to zero-terminated string representation of HH:MM:SS
0418D2             0004*    ; destroys: a,bc,de
0418D2             0005*    seconds_to_hhmmss:
0418D2             0006*    ; Divide the total seconds into hours, minutes, and seconds.
0418D2             0007*    ; Hours = Total seconds ÷ 3600.
0418D2 11 10 0E 00 0008*        ld de,3600
0418D6 CD F5 03 04 0009*        call udiv24 ; de = hours, hl = remaining seconds
0418DA E5          0010*        push hl ; save remainder
0418DB EB          0011*        ex de,hl ; hl = hours
0418DC 11 35 19 04 0012*        ld de,@bin2asc
0418E0 CD 9D 01 04 0013*        call u8_to_ascii ; answer in @bin2asc
0418E4 3A 37 19 04 0014*        ld a,(@bin2asc+2)
0418E8 32 3F 19 04 0015*        ld (hhmmss+0),a
0418EC 3A 38 19 04 0016*        ld a,(@bin2asc+3)
0418F0 32 40 19 04 0017*        ld (hhmmss+1),a
0418F4             0018*    ; Minutes = Remaining seconds ÷ 60.
0418F4 E1          0019*        pop hl ; restore remainder
0418F5 11 3C 00 00 0020*        ld de,60
0418F9 CD F5 03 04 0021*        call udiv24 ; de = minutes, hl = remaining seconds
0418FD E5          0022*        push hl ; save remainder
0418FE EB          0023*        ex de,hl ; hl = minutes
0418FF 11 35 19 04 0024*        ld de,@bin2asc
041903 CD 9D 01 04 0025*        call u8_to_ascii ; answer in @bin2asc
041907 3A 37 19 04 0026*        ld a,(@bin2asc+2)
04190B 32 42 19 04 0027*        ld (hhmmss+3),a
04190F 3A 38 19 04 0028*        ld a,(@bin2asc+3)
041913 32 43 19 04 0029*        ld (hhmmss+4),a
041917             0030*    ; Seconds = Remaining seconds.
041917 E1          0031*        pop hl ; restore remainder
041918 11 35 19 04 0032*        ld de,@bin2asc
04191C CD 9D 01 04 0033*        call u8_to_ascii ; answer in @bin2asc
041920 3A 37 19 04 0034*        ld a,(@bin2asc+2)
041924 32 45 19 04 0035*        ld (hhmmss+6),a
041928 3A 38 19 04 0036*        ld a,(@bin2asc+3)
04192C 32 46 19 04 0037*        ld (hhmmss+7),a
041930 21 3F 19 04 0038*        ld hl,hhmmss
041934 C9          0039*        ret
041935 00 00 00 00 0040*    @bin2asc: blkw 5,0 ; scratch space for binary to ascii decimal conversion
       00 00 00 00 
       00 00       
04193F 30 30 3A 30 0041*    hhmmss: asciz "00:00:00" ; buffer for output string
       30 3A 30 30 
       00          
041948             0042*    ; end seconds_to_hhmmss
041948             0038         include "timer.inc"
041948             0001*    ; Table 32. Timer Control Registers
041948             0002*    TMR0_CTL: equ 80h
041948             0003*    TMR1_CTL: equ 83h
041948             0004*    TMR2_CTL: equ 86h
041948             0005*    TMR3_CTL: equ 89h
041948             0006*    TMR4_CTL: equ 8Ch
041948             0007*    TMR5_CTL: equ 8Fh
041948             0008*    
041948             0009*    ; each timer register takes three bytes:
041948             0010*    ;   0: control register
041948             0011*    ;   1: low byte of timer reset value
041948             0012*    ;   2: high byte of timer reset value
041948             0013*    ; note that the value is only 8-bits,so we use in0/out0 i/o calls,
041948             0014*    ; which correctly force the high and upper bytes of the address bus to zero
041948             0015*    
041948             0016*    TMR_REG_CTL: equ 0
041948             0017*    TMR_RES_LOW: equ 1
041948             0018*    TMR_RES_HIGH: equ 2
041948             0019*    
041948             0020*    ; Timer Control Register Bit Definitions
041948             0021*    PRT_IRQ_0:    equ %00000000 ; The timer does not reach its end-of-count value.
041948             0022*                                ; This bit is reset to 0 every time the TMRx_CTL register is read.
041948             0023*    PRT_IRQ_1:    equ %10000000 ; The timer reaches its end-of-count value. If IRQ_EN is set to 1,
041948             0024*                                ; an interrupt signal is sent to the CPU. This bit remains 1 until
041948             0025*                                ; the TMRx_CTL register is read.
041948             0026*    
041948             0027*    IRQ_EN_0:     equ %00000000 ; Timer interrupt requests are disabled.
041948             0028*    IRQ_EN_1:     equ %01000000 ; Timer interrupt requests are enabled.
041948             0029*    
041948             0030*    PRT_MODE_0:   equ %00000000 ; The timer operates in SINGLE PASS mode. PRT_EN (bit 0) is reset to
041948             0031*                                ;  0,and counting stops when the end-of-count value is reached.
041948             0032*    PRT_MODE_1:   equ %00010000 ; The timer operates in CONTINUOUS mode. The timer reload value is
041948             0033*                                ; written to the counter when the end-of-count value is reached.
041948             0034*    
041948             0035*    ; CLK_DIV is a 2-bit mask that sets the timer input source clock divider
041948             0036*    CLK_DIV_256:  equ %00001100 ;
041948             0037*    CLK_DIV_64:   equ %00001000 ;
041948             0038*    CLK_DIV_16:   equ %00000100 ;
041948             0039*    CLK_DIV_4:    equ %00000000 ;
041948             0040*    
041948             0041*    RST_EN_0:     equ %00000000 ; The reload and restart function is disabled.
041948             0042*    RST_EN_1:     equ %00000010 ; The reload and restart function is enabled.
041948             0043*                                ; When a 1 is written to this bit,the values in the reload registers
041948             0044*                                ;  are loaded into the downcounter when the timer restarts. The
041948             0045*                                ; programmer must ensure that this bit is set to 1 each time
041948             0046*                                ; SINGLE-PASS mode is used.
041948             0047*    
041948             0048*    ; disable/enable the programmable reload timer
041948             0049*    PRT_EN_0:     equ %00000000 ;
041948             0050*    PRT_EN_1:     equ %00000001 ;
041948             0051*    
041948             0052*    ; Table 37. Timer Input Source Select Register
041948             0053*    ; Each of the 4 timers are allocated two bits of the 8-bit register
041948             0054*    ; in little-endian order,with TMR0 using bits 0 and 1,TMR1 using bits 2 and 3,etc.
041948             0055*    ;   00: System clock / CLK_DIV
041948             0056*    ;   01: RTC / CLK_DIV
041948             0057*    ;   NOTE: these are the values given in the manual,but it may be a typo
041948             0058*    ;   10: GPIO port B pin 1.
041948             0059*    ;   11: GPIO port B pin 1.
041948             0060*    TMR_ISS:   equ 92h ; register address
041948             0061*    
041948             0062*    ; Table 51. Real-Time Clock Control Register
041948             0063*    RTC_CTRL: equ EDh ; register address
041948             0064*    
041948             0065*    ; alarm interrupt disable/enable
041948             0066*    RTC_ALARM_0:    equ %00000000
041948             0067*    RTC_ALARM_1:    equ %10000000
041948             0068*    
041948             0069*    ; interrupt on alarm disable/enable
041948             0070*    RTC_INT_ENT_0:  equ %00000000
041948             0071*    RTC_INT_ENT_1:  equ %01000000
041948             0072*    
041948             0073*    RTC_BCD_EN_0:   equ %00000000   ; RTC count and alarm registers are binary
041948             0074*    RTC_BCD_EN_1:   equ %00100000   ; RTC count and alarm registers are BCD
041948             0075*    
041948             0076*    RTC_CLK_SEL_0:  equ %00000000   ; RTC clock source is crystal oscillator output (32768 Hz).
041948             0077*                                    ; On-chip 32768 Hz oscillator is enabled.
041948             0078*    RTC_CLK_SEL_1:  equ %00010000   ; RTC clock source is power line frequency input as set by FREQ_SEL.
041948             0079*                                    ; On-chip 32768 Hz oscillator is disabled.
041948             0080*    
041948             0081*    RTC_FREQ_SEL_0: equ %00000000   ; 60 Hz power line frequency.
041948             0082*    RTC_FREQ_SEL_1: equ %00001000   ; 50 Hz power line frequency.
041948             0083*    
041948             0084*    RTC_SLP_WAKE_0: equ %00000000   ; RTC does not generate a sleep-mode recovery reset.
041948             0085*    RTC_SLP_WAKE_1: equ %00000010   ; RTC generates a sleep-mode recovery reset.
041948             0086*    
041948             0087*    RTC_UNLOCK_0:   equ %00000000   ; RTC count registers are locked to prevent Write access.
041948             0088*                                    ; RTC counter is enabled.
041948             0089*    RTC_UNLOCK_1:   equ %00000001   ; RTC count registers are unlocked to allow Write access.
041948             0090*                                    ; RTC counter is disabled.
041948             0091*    
041948             0092*    ; prt_reload_emulator: equ 11234 ; 1/102.4 seconds on emulator with 16 clock divider
041948             0093*    
041948             0094*    prt_reload_emulator: equ 11519 ; 1 centisecond on emulator with 16 clock divider
041948             0095*    prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
041948 00 00 00    0096*    prt_reload: dl 0x000000
04194B             0097*    
04194B             0098*    ; returns: a = 0 if running on hardware,1 if running on emulator
04194B             0099*    ;          de = number PRT interrupts during test interval
04194B             0100*    prt_calibrate:
04194B CD 5A 1C 04 0101*        call vdu_vblank
04194F             0102*    ; set a MOS timer
04194F 21 78 00 00 0103*        ld hl,120*1 ; 1 second
041953 FD 21 D3 1A 0104*        ld iy,tmr_test
       04          
041958 CD B1 1A 04 0105*        call tmr_set
04195C             0106*    ; set a PRT timer
04195C             0107*        ; ld hl,prt_reload_hardware
04195C             0108*        ; ld hl,prt_reload_emulator
04195C 21 05 2D 00 0109*        ld hl,prt_reload_emulator + prt_reload_hardware / 2
041960 22 48 19 04 0110*        ld (prt_reload),hl
041964 CD EC 19 04 0111*        call prt_set
041968             0112*    @loop:
041968             0113*    ; check time remaining on MOS timer
041968 CD BF 1A 04 0114*        call tmr_get
04196C CA 76 19 04 0115*        jp z,@done ; time expired,so quit
041970 FA 76 19 04 0116*        jp m,@done ; time past expiration (negative),so quit
041974 18 F2       0117*        jr @loop
041976             0118*    @done:
041976 ED 5B 3A 1A 0119*        ld de,(prt_irq_counter)
       04          
04197B 01 0C 2D 00 0120*        ld bc,prt_reload_hardware ; default value for running on hardware
04197F ED 43 48 19 0121*        ld (prt_reload),bc
       04          
041984 21 64 00 00 0122*        ld hl,100 ; halfway between 101 for real hardware and 99 for emulator
041988 AF          0123*        xor a ; clear carry,zero is default value for running on hardware
041989 32 AB 19 04 0124*        ld (is_emulator),a
04198D ED 52       0125*        sbc hl,de
04198F 21 AC 19 04 0126*        ld hl,on_hardware ; default message for running on hardware
041993 CA 4B 19 04 0127*        jp z,prt_calibrate ; zero result is indeterminate so we try again
041997 F8          0128*        ret m ; negative result means we're on hardware
041998 3C          0129*        inc a ; we're on emulator
041999 32 AB 19 04 0130*        ld (is_emulator),a
04199D 01 FF 2C 00 0131*        ld bc,prt_reload_emulator
0419A1 ED 43 48 19 0132*        ld (prt_reload),bc
       04          
0419A6 21 C2 19 04 0133*        ld hl,on_emulator
0419AA C9          0134*        ret
0419AB 00          0135*    is_emulator: db 0
0419AC 52 75 6E 6E 0136*    on_hardware: defb "Running on hardware\r\n",0
       69 6E 67 20 
       6F 6E 20 68 
       61 72 64 77 
       61 72 65 0D 
       0A 00       
0419C2 52 75 6E 6E 0137*    on_emulator: defb "Running on emulator\r\n",0
       69 6E 67 20 
       6F 6E 20 65 
       6D 75 6C 61 
       74 6F 72 0D 
       0A 00       
0419D8             0138*    
0419D8 43 61 6C 69 0139*    calibrating_timer: defb "Calibrating timer\r\n",0
       62 72 61 74 
       69 6E 67 20 
       74 69 6D 65 
       72 0D 0A 00 
0419EC             0140*    
0419EC             0141*    ; set PRT timer
0419EC             0142*    prt_set:
0419EC 21 00 00 00 0143*        ld hl,0
0419F0 22 3A 1A 04 0144*        ld (prt_irq_counter),hl
0419F4 2A 48 19 04 0145*        ld hl,(prt_reload)
0419F8 ED 29 84    0146*        out0 (TMR1_CTL+TMR_RES_LOW),l
0419FB ED 21 85    0147*    	out0 (TMR1_CTL+TMR_RES_HIGH),h
0419FE             0148*    ; disable timer
0419FE 3E 06       0149*        ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_16 | RST_EN_1 | PRT_EN_0
041A00 ED 39 83    0150*    	out0 (TMR1_CTL+TMR_REG_CTL),a
041A03             0151*    ; enable timer,with interrupt and CONTINUOUS mode,clock divider 16
041A03 3E 57       0152*        ld a,PRT_IRQ_0 | IRQ_EN_1 | PRT_MODE_1 | CLK_DIV_16 | RST_EN_1 | PRT_EN_1
041A05 ED 39 83    0153*    	out0 (TMR1_CTL+TMR_REG_CTL),a
041A08 C9          0154*        ret
041A09             0155*    
041A09             0156*    ; ===============================================
041A09             0157*    ; PRT Timer Interrupt Handling
041A09             0158*    ; https://github.com/tomm/agon-cpu-emulator/blob/main/sdcard/regression_suite/timerirq.asm
041A09             0159*    ; -----------------------------------------------
041A09             0160*    prt_irq_init:
041A09             0161*        ; set up interrupt vector table 2

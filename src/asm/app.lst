                       M1 Args: none
04414C 19          0001*M1      add hl,de ; 1 cycle
04414D B7          0002*M1      or a ; clear flags ; 1 cycle
04414E ED 52       0003*M1      sbc hl,de ; 2 cycles
044150             0004*M1      ; 4 cycles total
044150 CA 6B 41 04 0386*        jp z,@print
044154 F2 67 41 04 0387*        jp p,@mod
044158 B7          0388*        or a ; clear carry for adc because
044159 ED 5A       0389*        adc hl,de ; add doesn't set sign flag
04415B F2 6B 41 04 0390*        jp p,@print
04415F CD 1D 05 04 0391*        call neg_hlu
044163 C3 6B 41 04 0392*        jp @print

0403BF             0583*    
0403BF             0584*    ; set all the bits in the flag register
0403BF             0585*    ; more of an academic exercise than anything useful
0403BF             0586*    ; inputs; none
0403BF             0587*    ; outputs; a=0,f=255
0403BF             0588*    ; destroys: flags, hl
0403BF             0589*    ; preserves: a, because why not
0403BF             0590*    setAllFlags:
0403BF 21 FF 00 00 0591*        ld hl,255
0403C3 67          0592*        ld h,a ; four cycles to preserve a is cheap
0403C4 E5          0593*        push hl
0403C5 F1          0594*        pop af
0403C6 C9          0595*        ret
0403C7             0596*    
0403C7             0597*    ; reset all the bits in the flag register
0403C7             0598*    ; unlike its inverse counterpart, this may actually be useful
0403C7             0599*    ; inputs; none
0403C7             0600*    ; outputs; a=0,f=0
0403C7             0601*    ; destroys: flags, hl
0403C7             0602*    ; preserves: a, because why not
0403C7             0603*    resetAllFlags:
0403C7 21 00 00 00 0604*        ld hl,0
0403CB 67          0605*        ld h,a ; four cycles to preserve a is cheap
0403CC E5          0606*        push hl
0403CD F1          0607*        pop af
0403CE C9          0608*        ret

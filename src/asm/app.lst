043F95 CD D2 3D 04 0186*        call bf_highlight_file ; highlight the first file
043F99 CD 26 3E 04 0187*        call bf_print_dir_name ; print the directory name
043F9D             0188*    ; restart the PRT timer
043F9D CD 64 6B 04 0189*        call ps_prt_start ; start the PRT timer
043FA1 C3 37 3E 04 0190*        jp get_input ; back to main loop (will re-enable interrupts)
043FA5             0191*    ; end bf_change_dir
043FA5             0192*    ; end bf_up_dir

0403CF             0614*    waitKeypress:
0403CF             0615*        MOSCALL mos_getkey
                       M1 Args: function=mos_getkey 
0403CF 3E 00       0001*M1  			LD	A, function
0403D1 5B CF       0002*M1  			RST.LIL	08h
0403D3 C9          0616*        ret
0403D4             0617*    
0403D4             0618*    ; clear a block of memory by writing a prescribed value to each byte in the range
0403D4             0619*    ; inputs: a = value to write, hl = address of first byte, bc = number of bytes
0403D4             0620*    ; outputs: memory block is cleared
0403D4             0621*    ; destroys: hl, bc, de
0403D4             0622*    clear_mem:
0403D4 0B          0623*        dec bc ; we do this because we will increment de before writing the first byte
0403D5 77          0624*        ld (hl),a
0403D6 E5          0625*        push hl
0403D7 D1          0626*        pop de
0403D8 13          0627*        inc de ; target address
0403D9 ED B0       0628*        ldir
0403DB C9          0629*        ret

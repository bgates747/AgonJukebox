043FE5             0227*    ps_volume_up:
043FE5 3A 84 67 04 0228*        ld a,(ps_volume)
043FE9 FE 0B       0229*        cp 11 ; max volume
043FEB CA 37 3E 04 0230*        jp z,get_input ; already at max volume so return to input
043FEF 3C          0231*        inc a ; increase volume
043FF0 32 84 67 04 0232*        ld (ps_volume),a
043FF4 CD 12 40 04 0233*        call ps_adjust_volume
043FF8 C3 37 3E 04 0234*        jp get_input
043FFC             0235*    ; end ps_volume_up
043FFC             0236*    
043FFC             0237*    ps_volume_down:
043FFC 3A 84 67 04 0238*        ld a,(ps_volume)
044000 B7          0239*        or a ; zero check for min volume
044001 CA 37 3E 04 0240*        jp z,get_input ; already at min volume so return to input
044005 3D          0241*        dec a ; decrease volume
044006 32 84 67 04 0242*        ld (ps_volume),a
04400A CD 12 40 04 0243*        call ps_adjust_volume
04400E C3 37 3E 04 0244*        jp get_input
044012             0245*    ; end ps_volume_down
044012             0246*    
044012             0247*    ; adjust master volume
044012             0248*    ; inputs: a = new volume (0-11)
044012             0249*    ; outputs: prints the new volume to the screen
044012             0250*    ; destroys: af, hl, bc
044012             0251*    ps_adjust_volume:
044012             0252*    ; save the new volume and set the volume for all channels
044012 47          0253*        ld b,a ; volume
044013 0E 0C       0254*        ld c,12
044015 ED 4C       0255*        mlt bc
044017 41          0256*        ld b,c ; b = volume * 12
044018 0E FF       0257*        ld c,-1 ; channel -1 = global volume
04401A CD 48 22 04 0258*        call vdu_channel_volume
04401E             0259*    ; print the new volume
04401E CD 25 36 04 0260*        call vp_legend_volume
044022 CD E6 1B 04 0261*        call vdu_cls
044026 3A 84 67 04 0262*        ld a,(ps_volume)
04402A CD 44 01 04 0263*        call printDec8 ; print the volume
04402E             0264*    ; restore the '<' character that got stomped on
04402E CD 5B 1B 04 0265*        call vdu_home_cursor
044032 3E 3C       0266*        ld a,'<'
044034 5B D7       0267*        rst.lil 10h ; print the '<' character
044036 C9          0268*        ret
044037             0269*    ; end ps_adjust_volume

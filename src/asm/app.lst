043F22             0129*    ; end bf_next_file
043F22             0130*    
043F22             0131*    bf_next_page:
043F22             0132*    ; advance the page number
043F22 ED 5B 0A 00 0133*        ld de,(bf_page_cur) ; get the current page number
       07          
043F27 13          0134*        inc de ; increment the page number
043F28 2A 0D 00 07 0135*        ld hl,(bf_dir_num_pages) ; get the number of pages
043F2C 2B          0136*        dec hl ; zero-based
043F2D B7          0137*        or a ; clear carry
043F2E ED 52       0138*        sbc hl,de
043F30 F2 38 3F 04 0139*        jp p,@F ; not the last page
043F34 11 00 00 00 0140*        ld de,0 ; wrap around to the first page
043F38             0141*    @@:
043F38             0142*    ; print the new page
043F38 ED 53 0A 00 0143*        ld (bf_page_cur),de
       07          
043F3D AF          0144*        xor a
043F3E 32 00 00 07 0145*        ld (bf_file_idx),a ; reset the file index
043F42 CD 06 3D 04 0146*        call bf_get_page_num_files ; get the number of files on the new page and store it
043F46 CD D2 3D 04 0147*        call bf_highlight_file ; highlight the first file
043F4A C3 37 3E 04 0148*        jp get_input
043F4E             0149*    ; end bf_next_page
043F4E             0150*    
043F4E             0151*    bf_prev_page:
043F4E             0152*    ; decrement the page number
043F4E 2A 0A 00 07 0153*        ld hl,(bf_page_cur) ; get the current page number
043F52 2B          0154*        dec hl ; decrement the page number
043F53             0155*        SIGN_UHL
                       M1 Args: none
043F53 19          0001*M1      add hl,de ; 1 cycle
043F54 B7          0002*M1      or a ; clear flags ; 1 cycle
043F55 ED 52       0003*M1      sbc hl,de ; 2 cycles
043F57             0004*M1      ; 4 cycles total
043F57 F2 60 3F 04 0156*        jp p,@F ; not time to wrap around
043F5B 2A 0D 00 07 0157*        ld hl,(bf_dir_num_pages) ; get the number of pages
043F5F 2B          0158*        dec hl ; zero-based
043F60             0159*    @@:

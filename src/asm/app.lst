043FC3             0207*    ; get a pointer to a filinfo struct from a directory page index
043FC3             0208*    ; inputs: none
043FC3             0209*    ; outputs: iy = pointer to the filinfo struct
043FC3             0210*    bf_get_filinfo_from_pg_idx:
043FC3             0211*    ; get the fileinfo pointer from the fileinfo pointer table
043FC3 2A 0A 00 07 0212*        ld hl,(bf_page_cur) ; get the current page number
043FC7 11 1E 00 00 0213*        ld de,bf_files_per_pg*3 ; number of files per page * 3 bytes per pointer
043FCB CD DC 03 04 0214*        call umul24 ; hl = page * num_files_per_page
043FCF 3A 00 00 07 0215*        ld a,(bf_file_idx) ; get the file index
043FD3 5F          0216*        ld e,a ; file index
043FD4 16 03       0217*        ld d,3 ; 3 bytes per pointer
043FD6 ED 5C       0218*        mlt de ; de = file index * 3
043FD8 19          0219*        add hl,de
043FD9 EB          0220*        ex de,hl ; can't add iy,hl ...
043FDA FD 21 00 03 0221*        ld iy,bf_filinfo_ptrs ; get the pointer to the fileinfo pointer table
       07          
043FDF FD 19       0222*        add iy,de ; iy points to the first fileinfo pointer in the current page
043FE1 FD 37 00    0223*        ld iy,(iy) ; iy points to the filinfo record
043FE4 C9          0224*        ret
043FE5             0225*    ; end bf_get_filinfo_from_pg_idx

0401D8             0299*    ; u168_to_ascii: Converts an unsigned 16.8 fixed-point value in HL to an ASCII string.
0401D8             0300*    ; HL : Value to convert to string (integer part in H, fractional part in L)
0401D8             0301*    ; DE : Pointer to buffer, requires at least 11 bytes (8 digits, sign, decimal point, and null terminator)
0401D8             0302*    u168_to_ascii:
0401D8             0303*    ; add a leading space to make room for sign flag if needed
0401D8 3E 20       0304*        ld a,' '
0401DA 12          0305*        ld (de),a
0401DB 13          0306*        inc de
0401DC             0307*    ; Convert integer part
0401DC E5          0308*        push hl ; Save HL (we’ll need the fractional part later)
0401DD             0309*        ; call hlu_udiv256 ; Shift to get integer portion in HL
0401DD             0310*        SRL_UHL ; Shift to get integer portion in HL
                       M1 Args: none
0401DD 3B          0001*M1      dec sp ; 1 cycle
0401DE E5          0002*M1      push hl ; 4 cycles
0401DF 33          0003*M1      inc sp ; 1 cycle
0401E0 E1          0004*M1      pop hl ; 4 cycles
0401E1 23          0005*M1      inc hl ; 1 cycle

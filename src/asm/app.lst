0403DC             0012*    
0403DC             0013*    ;------------------------------------------------------------------------
0403DC             0014*    ; umul24:	HL = HL*DE (unsigned)
0403DC             0015*    ; Preserves AF, BC, DE
0403DC             0016*    ; Uses a fast multiply routine.
0403DC             0017*    ;------------------------------------------------------------------------
0403DC             0018*    umul24:
0403DC D5          0019*    	push	DE
0403DD C5          0020*    	push	BC
0403DE F5          0021*    	push	AF
0403DF E5          0022*    	push	HL
0403E0 C1          0023*    	pop		BC
0403E1 3E 18       0024*        ld	 	a, 24 ; No. of bits to process
0403E3 21 00 00 00 0025*        ld	 	hl, 0 ; Result
0403E7             0026*    umul24_lp:
0403E7 29          0027*    	add	hl,hl
0403E8 EB          0028*    	ex	de,hl
0403E9 29          0029*    	add	hl,hl
0403EA EB          0030*    	ex	de,hl
0403EB 30 01       0031*    	jr	nc,umul24_nc
0403ED 09          0032*    	add	hl,bc
0403EE             0033*    umul24_nc:
0403EE 3D          0034*    	dec	a
0403EF 20 F6       0035*    	jr	nz,umul24_lp
0403F1 F1          0036*    	pop	af
0403F2 C1          0037*    	pop	bc
0403F3 D1          0038*    	pop	de
0403F4 C9          0039*    	ret
0403F5             0040*    
0403F5             0041*    
0403F5             0042*    ;------------------------------------------------------------------------
0403F5             0043*    ; udiv24
0403F5             0044*    ; Unsigned 24-bit division
0403F5             0045*    ; Divides HLU by DEU. Gives result in DEU (and BC), remainder in HLU.
0403F5             0046*    ;
0403F5             0047*    ; Uses AF BC DE HL
0403F5             0048*    ; Uses Restoring Division algorithm
0403F5             0049*    ;------------------------------------------------------------------------
0403F5             0050*    
0403F5             0051*    udiv24:
0403F5 E5          0052*    	push	hl
0403F6 C1          0053*    	pop		bc	;move dividend to BCU
0403F7 21 00 00 00 0054*    	ld		hl,0	;result
0403FB A7          0055*    	and		a
0403FC ED 52       0056*    	sbc		hl,de	;test for div by 0
0403FE C8          0057*    	ret		z		;it's zero, carry flag is clear
0403FF 19          0058*    	add		hl,de	;HL is 0 again
040400 3E 18       0059*    	ld		a,24	;number of loops through.
040402             0060*    udiv1:
040402 C5          0061*    	push	bc	;complicated way of doing this because of lack of access to top bits
040403 E3          0062*    	ex		(sp),hl
040404 37          0063*    	scf
040405 ED 6A       0064*    	adc	hl,hl
040407 E3          0065*    	ex	(sp),hl
040408 C1          0066*    	pop	bc		;we now have bc = (bc * 2) + 1
040409             0067*    
040409 ED 6A       0068*    	adc	hl,hl
04040B A7          0069*    	and	a		;is this the bug
04040C ED 52       0070*    	sbc	hl,de
04040E 30 02       0071*    	jr	nc,udiv2
040410 19          0072*    	add	hl,de
040411             0073*    ;	dec	c
040411 0B          0074*    	dec	bc
040412             0075*    udiv2:
040412 3D          0076*    	dec	a
040413 20 ED       0077*    	jr	nz,udiv1
040415 37          0078*    	scf		;flag used for div0 error
040416 C5          0079*    	push	bc
040417 D1          0080*    	pop		de	;remainder
040418 C9          0081*    	ret
040419             0082*    
040419             0083*    
040419             0084*    
040419             0085*    ;------------------------------------------------------------------------
040419             0086*    ; neg24
040419             0087*    ; Returns: HLU = 0-HLU
040419             0088*    ; preserves all other registers
040419             0089*    ;------------------------------------------------------------------------
040419             0090*    neg24:
040419 D5          0091*    	push	de
04041A EB          0092*    	ex		de,hl
04041B 21 00 00 00 0093*    	ld		hl,0
04041F B7          0094*    	or		a
040420 ED 52       0095*    	sbc		hl,de
040422 D1          0096*    	pop		de
040423 C9          0097*    	ret
040424             0098*    
040424             0099*    ;------------------------------------------------------------------------
040424             0100*    ; or_hlu_deu: 24 bit bitwise OR
040424             0101*    ; Returns: hlu = hlu OR deu
040424             0102*    ; preserves all other registers
040424             0103*    ;------------------------------------------------------------------------
040424             0104*    or_hlu_deu:
040424 22 AD 04 04 0105*    	ld	(bitbuf1),hl
040428 ED 53 B0 04 0106*    	ld	(bitbuf2),de
       04          
04042D D5          0107*    	push	de	;preserve DEU
04042E C5          0108*    	push	bc	;preserve BCU
04042F 06 03       0109*    	ld		b,3
040431 21 AD 04 04 0110*    	ld	hl,bitbuf1
040435 11 AD 04 04 0111*    	ld	de,bitbuf1
040439             0112*    orloop_24:
040439 1A          0113*    	ld	a,(de)
04043A B6          0114*    	or	(hl)
04043B 12          0115*    	ld	(de),a
04043C 13          0116*    	inc	de
04043D 23          0117*    	inc	hl
04043E 10 F9       0118*    	djnz	orloop_24
040440 2A B0 04 04 0119*    	ld	hl,(bitbuf2)
040444 C1          0120*    	pop		bc	;restore BC
040445 D1          0121*    	pop		de	;restore DE
040446             0122*    
040446             0123*    ;------------------------------------------------------------------------
040446             0124*    ; and_hlu_deu: 24 bit bitwise AND
040446             0125*    ; Returns: hlu = hlu AND deu
040446             0126*    ; preserves all other registers
040446             0127*    ;------------------------------------------------------------------------
040446             0128*    and_hlu_deu:
040446 22 AD 04 04 0129*    	ld	(bitbuf1),hl
04044A ED 53 B0 04 0130*    	ld	(bitbuf2),de
       04          
04044F D5          0131*    	push	de	;preserve DEU
040450 C5          0132*    	push	bc	;preserve BCU
040451 06 03       0133*    	ld		b,3
040453 21 AD 04 04 0134*    	ld	hl,bitbuf1
040457 11 AD 04 04 0135*    	ld	de,bitbuf1
04045B             0136*    andloop_24:
04045B 1A          0137*    	ld	a,(de)
04045C A6          0138*    	and	(hl)
04045D 12          0139*    	ld	(de),a
04045E 13          0140*    	inc	de
04045F 23          0141*    	inc	hl
040460 10 F9       0142*    	djnz	andloop_24
040462 2A B0 04 04 0143*    	ld	hl,(bitbuf2)
040466 C1          0144*    	pop		bc	;restore BC
040467 D1          0145*    	pop		de	;restore DE
040468             0146*    
040468             0147*    ;------------------------------------------------------------------------
040468             0148*    ; xor_hlu_deu: 24 bit bitwise XOR
040468             0149*    ; Returns: hlu = hlu XOR deu
040468             0150*    ; preserves all other registers
040468             0151*    ;------------------------------------------------------------------------
040468             0152*    xor_hlu_deu:
040468 22 AD 04 04 0153*    	ld	(bitbuf1),hl
04046C ED 53 B0 04 0154*    	ld	(bitbuf2),de
       04          
040471 D5          0155*    	push	de	;preserve DEU
040472 C5          0156*    	push	bc	;preserve BCU
040473 06 03       0157*    	ld		b,3
040475 21 AD 04 04 0158*    	ld	hl,bitbuf1
040479 11 AD 04 04 0159*    	ld	de,bitbuf1
04047D             0160*    xorloop_24:
04047D 1A          0161*    	ld	a,(de)
04047E AE          0162*    	xor	(hl)
04047F 12          0163*    	ld	(de),a
040480 13          0164*    	inc	de
040481 23          0165*    	inc	hl
040482 10 F9       0166*    	djnz	xorloop_24
040484 2A B0 04 04 0167*    	ld	hl,(bitbuf2)
040488 C1          0168*    	pop		bc	;restore BC
040489 D1          0169*    	pop		de	;restore DE
04048A             0170*    
04048A             0171*    ;------------------------------------------------------------------------
04048A             0172*    ; shl_hlu: 24 bit shift left hlu by a positions
04048A             0173*    ; Returns: hlu = hlu << a
04048A             0174*    ;		   a = 0
04048A             0175*    ; NOTE: only considers a up to 16 bits.
04048A             0176*    ; preserves all other registers
04048A             0177*    ; modified by Brandon R. Gates to use a instead of de
04048A             0178*    ;------------------------------------------------------------------------
04048A             0179*    shl_hlu:
04048A B7          0180*    	or a
04048B C8          0181*    	ret		z		;we're done
04048C 29          0182*    	add		hl,hl	;shift HLU left
04048D 3D          0183*    	dec a
04048E 18 FA       0184*    	jr		shl_hlu
040490             0185*    
040490             0186*    ;------------------------------------------------------------------------
040490             0187*    ; shr_hlu: 24 bit shift right hlu by a positions
040490             0188*    ; Returns: hlu = hlu >> a
040490             0189*    ;		   a = 0
040490             0190*    ; NOTE: only considers a up to 16 bits.
040490             0191*    ; preserves all other registers
040490             0192*    ; modified by Brandon R. Gates to use a instead of de
040490             0193*    ;------------------------------------------------------------------------
040490             0194*    shr_hlu:
040490 22 AD 04 04 0195*    	ld		(bitbuf1),hl
040494 21 AF 04 04 0196*    	ld		hl,bitbuf1+2
040498             0197*    @shr_loop:
040498 B7          0198*    	or a
040499 28 0D       0199*    	jr		z,@shr_done		;we're done
04049B             0200*    ;carry is clear from or instruction
04049B CB 1E       0201*    	rr		(hl)
04049D 2B          0202*    	dec		hl
04049E CB 1E       0203*    	rr		(hl)
0404A0 2B          0204*    	dec		hl
0404A1 CB 1E       0205*    	rr		(hl)
0404A3 23          0206*    	inc		hl
0404A4 23          0207*    	inc		hl
0404A5 3D          0208*    	dec a
0404A6 18 F0       0209*    	jr		@shr_loop
0404A8             0210*    @shr_done:
0404A8 2A AD 04 04 0211*    	ld		hl,(bitbuf1)	;collect result
0404AC C9          0212*    	ret

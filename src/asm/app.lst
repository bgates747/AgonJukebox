043E37             0051         include "input.inc"
043E37             0001*    get_input:
043E37             0002*    ; wait for the user to push a button
043E37 FB          0003*        ei ; enable interrupts
043E38             0004*        MOSCALL mos_getkey ; a = ascii code of key pressed
                       M1 Args: function=mos_getkey 
043E38 3E 00       0001*M1  			LD	A, function
043E3A 5B CF       0002*M1  			RST.LIL	08h
043E3C F3          0005*        di ; disable interrupts
043E3D             0006*    
043E3D             0007*    ; RETURN TO MAIN, which re-enables interrupts and exits app
043E3D FE 1B       0008*        cp '\e' ; escape
043E3F C8          0009*        ret z
043E40 FE 71       0010*        cp 'q' ; quit
043E42 C8          0011*        ret z
043E43             0012*    
043E43             0013*    ; Ignore function, alt, control, caps lock, and shift key events.
043E43 B7          0014*        or a
043E44 CA 37 3E 04 0015*        jp z,get_input
043E48             0016*    
043E48             0017*    ; FILE BROWSER COMMANDS
043E48 FE 0B       0018*        cp 0x0B ; up arrow
043E4A CA F5 3E 04 0019*        jp z,bf_prev_file
043E4E FE 0A       0020*        cp 0x0A ; down arrow
043E50 CA 16 3F 04 0021*        jp z,bf_next_file
043E54 FE 15       0022*        cp 0x15 ; right arrow
043E56 CA 22 3F 04 0023*        jp z,bf_next_page
043E5A FE 08       0024*        cp 0x08 ; left arrow
043E5C CA 4E 3F 04 0025*        jp z,bf_prev_page
043E60 FE 75       0026*        cp 'u' ; go up one directory
043E62 CA 78 3F 04 0027*        jp z,bf_up_dir
043E66             0028*    
043E66             0029*    ; SONG PLAYING COMMANDS
043E66             0030*    ; set volume commands
043E66 FE 2E       0031*        cp '.' ; increase volume
043E68 CA E5 3F 04 0032*        jp z,ps_volume_up
043E6C FE 2C       0033*        cp ',' ; decrease volume
043E6E CA FC 3F 04 0034*        jp z,ps_volume_down
043E72             0035*    ; set seek speed commands
043E72 FE 2D       0036*        cp '-' ; slow down
043E74 CA ED 40 04 0037*        jp z,ps_seek_slow
043E78 FE 3D       0038*        cp '=' ; speed up (means +)
043E7A CA F6 40 04 0039*        jp z,ps_seek_fast
043E7E             0040*    ; seek back / forward
043E7E FE 5B       0041*        cp '['
043E80 CA 24 41 04 0042*        jp z,ps_seek_back
043E84 FE 5D       0043*        cp ']'
043E86 CA 38 41 04 0044*        jp z,ps_seek_fwd
043E8A             0045*    ; toggle play / pause
043E8A FE 70       0046*        cp 'p'
043E8C CA 37 40 04 0047*        jp z,ps_toggle_pause
043E90             0048*    ; toggle loop
043E90 FE 6C       0049*        cp 'l'
043E92 CA B4 40 04 0050*        jp z,ps_toggle_loop
043E96             0051*    ; toggle shuffle
043E96 FE 73       0052*        cp 's'
043E98 CA 7B 40 04 0053*        jp z,ps_toggle_shuffle
043E9C             0054*    ; play random song
043E9C FE 72       0055*        cp 'r'
043E9E CA 17 6A 04 0056*        jp z,ps_play_random
043EA2             0057*    ; select song or directory
043EA2 FE 0D       0058*        cp '\r' ; ENTER key
043EA4 CA A5 3F 04 0059*        jp z,bf_select_file
043EA8             0060*    ; number key selections
043EA8 FE 30       0061*        cp '0'
043EAA DA BE 3E 04 0062*        jp c,@no_cmd ; not a song command
043EAE FE 3A       0063*        cp '9'+1
043EB0 D2 BE 3E 04 0064*        jp nc,@no_cmd ; not a song command
043EB4             0065*    ; select song or directory
043EB4 D6 30       0066*        sub '0' ; a = file index
043EB6 32 00 00 07 0067*        ld (bf_file_idx),a
043EBA C3 A5 3F 04 0068*        jp bf_select_file
043EBE             0069*    @no_cmd: ; no valid commands so go back to user input
043EBE C3 37 3E 04 0070*        jp get_input
043EC2             0071*    
043EC2             0072*    @play_song:
043EC2 CD D2 3D 04 0073*        call bf_highlight_file ; highlight the selected file
043EC6 C3 AA 67 04 0074*        jp play_song ; play the song
043ECA             0075*    ; end get_input
043ECA             0076*    
043ECA             0077*    get_rand_file_idx:
043ECA 3A 04 00 07 0078*        ld a,(bf_files_cur_pg)
043ECE B7          0079*        or a
043ECF C8          0080*        ret z ; no files on page
043ED0 6F          0081*        ld l,a
043ED1 CD D5 05 04 0082*        call rand_8 ; a = 0-255
043ED5 67          0083*        ld h,a
043ED6 CD 11 06 04 0084*        call udiv8 ; a = mod(a,bf_files_per_pg)
043EDA 32 00 00 07 0085*        ld (bf_file_idx),a
043EDE C9          0086*        ret
043EDF             0087*    
043EDF             0088*    get_prev_file_idx:
043EDF             0089*    ; get number of files on current page
043EDF 3A 04 00 07 0090*        ld a,(bf_files_cur_pg)
043EE3 47          0091*        ld b,a
043EE4             0092*    ; decrement the file index
043EE4 3A 00 00 07 0093*        ld a,(bf_file_idx)
043EE8 3D          0094*        dec a
043EE9 B8          0095*        cp b
043EEA DA F0 3E 04 0096*        jp c,@F ; check for wraparound
043EEE 78          0097*        ld a,b ; get the number of files this page
043EEF 3D          0098*        dec a ; zero-based
043EF0             0099*    @@:
043EF0 32 00 00 07 0100*        ld (bf_file_idx),a
043EF4 C9          0101*        ret
043EF5             0102*    ; end get_prev_file_idx
043EF5             0103*    
043EF5             0104*    bf_prev_file:
043EF5 CD DF 3E 04 0105*        call get_prev_file_idx

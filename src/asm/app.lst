040E62             0005*        ; incbin "../fonts/Lat2-VGA8_8x8.font"
040E62             0006*    font_data_end:
040E62             0007*    font_load:
040E62             0008*    ; load font into a buffer
040E62 21 10 FA 00 0009*        ld hl,Lat2_VGA8_8x8
040E66 11 62 06 04 0010*        ld de,font_data
040E6A 01 00 08 00 0011*        ld bc,font_data_end-font_data
040E6E CD 8B 1D 04 0012*        call vdu_load_buffer
040E72             0013*    ; create font from buffer
040E72 21 10 FA 00 0014*        ld hl,Lat2_VGA8_8x8
040E76 1E 08       0015*        ld e,8
040E78 16 08       0016*        ld d,8

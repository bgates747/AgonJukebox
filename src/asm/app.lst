041F5D             0040         include "vdu_buffered_api.inc"
041F5D             0001*    ; https://agonconsole8.github.io/agon-docs/vdp/Buffered-Commands-API/
041F5D             0002*    
041F5D             0003*    ; Command 0: Write block to a buffer
041F5D             0004*    ; VDU 23, 0, &A0, bufferId; 0, length; <buffer-data>
041F5D             0005*    ; inputs: hl = bufferId, bc = length of data, de = pointer to data
041F5D             0006*    vdu_write_block_to_buffer:
041F5D             0007*    ; back up input parameters
041F5D D5          0008*        push de ; pointer to data
041F5E C5          0009*        push bc ; length of data
041F5F             0010*    ; set up the vdu command string
041F5F 22 7F 1F 04 0011*        ld (@bufferId),hl
041F63 ED 43 82 1F 0012*        ld (@length),bc
       04          
041F68 AF          0013*        xor a ; load buffer
041F69 32 81 1F 04 0014*        ld (@bufferId+2),a
041F6D 21 7C 1F 04 0015*        ld hl,@cmd0
041F71 01 08 00 00 0016*        ld bc,@end0-@cmd0
041F75 5B DF       0017*        rst.lil $18
041F77             0018*    ; send the buffer data
041F77 C1          0019*        pop bc ; length of data
041F78 E1          0020*        pop hl ; pointer to data (was de)
041F79 5B DF       0021*        rst.lil $18 ; send it
041F7B C9          0022*        ret
041F7C             0023*    ; command string data
041F7C 17 00 A0    0024*    @cmd0:      db 23,0,0xA0
041F7F 00 00       0025*    @bufferId:	dw 0x0000
041F81 00          0026*                db 0 ; load buffer
041F82 00 00       0027*    @length:	dw 0x0000
041F84 00          0028*    @end0:      db 0x00 ; padding
041F85             0029*    ; end vdu_write_block_to_buffer
041F85             0030*    
041F85             0031*    ; Command 1: Call a buffer
041F85             0032*    ; VDU 23, 0, &A0, bufferId; 1
041F85             0033*    ; inputs: hl = bufferId
041F85             0034*    vdu_call_buffer:
041F85 22 9D 1F 04 0035*        ld (@bufferId),hl
041F89 3E 01       0036*        ld a,1 ; call buffer
041F8B 32 9F 1F 04 0037*        ld (@bufferId+2),a
041F8F 21 9A 1F 04 0038*        ld hl,@cmd
041F93 01 06 00 00 0039*        ld bc,@end-@cmd
041F97 5B DF       0040*        rst.lil $18
041F99 C9          0041*        ret
041F9A 17 00 A0    0042*    @cmd:     db 23,0,0xA0
041F9D 00 00       0043*    @bufferId: dw 0x0000
041F9F 01          0044*               db 1 ; call buffer
041FA0             0045*    @end:
041FA0             0046*    ; end vdu_call_buffer
041FA0             0047*    
041FA0             0048*    ; Command 2: Clear a buffer
041FA0             0049*    ; VDU 23, 0 &A0, bufferId; 2
041FA0             0050*    ; inputs: hl = bufferId
041FA0             0051*    vdu_clear_buffer:
041FA0 22 B8 1F 04 0052*        ld (@bufferId),hl
041FA4 3E 02       0053*        ld a,2 ; clear buffer
041FA6 32 BA 1F 04 0054*        ld (@bufferId+2),a
041FAA 21 B5 1F 04 0055*        ld hl,@cmd
041FAE 01 06 00 00 0056*        ld bc,@end-@cmd
041FB2 5B DF       0057*        rst.lil $18
041FB4 C9          0058*        ret
041FB5 17 00 A0    0059*    @cmd:     db 23,0,0xA0
041FB8 00 00       0060*    @bufferId: dw 0x0000
041FBA 02          0061*               db 2 ; clear buffer
041FBB             0062*    @end:
041FBB             0063*    ; end vdu_clear_buffer
041FBB             0064*    
041FBB             0065*    ; Clear all buffers
041FBB             0066*    ; inputs: none
041FBB             0067*    vdu_clear_all_buffers:
041FBB             0068*    ; clear all buffers
041FBB 21 C6 1F 04 0069*        ld hl,@beg
041FBF 01 06 00 00 0070*        ld bc,@end-@beg
041FC3 5B DF       0071*        rst.lil $18
041FC5 C9          0072*        ret
041FC6 17 00 A0    0073*    @beg: db 23,0,$A0
041FC9 FF FF       0074*          dw -1 ; bufferId -1 (65535) means clear all buffers
041FCB 02          0075*          db 2  ; command 2: clear a buffer
041FCC             0076*    @end:
041FCC             0077*    ; end vdu_clear_all_buffers
041FCC             0078*    
041FCC             0079*    ; Command 3: Create a writeable buffer
041FCC             0080*    ; VDU 23, 0 &A0, bufferId; 3, length;
041FCC             0081*    ; inputs: hl = bufferId, bc = length
041FCC             0082*    vdu_create_writeable_buffer:
041FCC 22 E9 1F 04 0083*        ld (@bufferId),hl
041FD0 ED 43 EC 1F 0084*        ld (@length),bc
       04          
041FD5 3E 03       0085*        ld a,3 ; create writeable buffer
041FD7 32 EB 1F 04 0086*        ld (@bufferId+2),a
041FDB 21 E6 1F 04 0087*        ld hl,@cmd
041FDF 01 08 00 00 0088*        ld bc,@end-@cmd
041FE3 5B DF       0089*        rst.lil $18
041FE5 C9          0090*        ret
041FE6 17 00 A0    0091*    @cmd:     db 23,0,0xA0
041FE9 00 00       0092*    @bufferId: dw 0x0000
041FEB 03          0093*               db 3 ; create writeable buffer
041FEC 00 00       0094*    @length: dw 0x0000
041FEE 00          0095*    @end:     db 0x00 ; padding
041FEF             0096*    ; end vdu_create_writeable_buffer
041FEF             0097*    
041FEF             0098*    ; Command 4: Set output stream to a buffer
041FEF             0099*    ; VDU 23, 0 &A0, bufferId; 4
041FEF             0100*    ; inputs: hl = bufferId
041FEF             0101*    vdu_set_output_stream_buffer:
041FEF 22 07 20 04 0102*        ld (@bufferId),hl
041FF3 3E 04       0103*        ld a,4 ; set output stream to buffer
041FF5 32 09 20 04 0104*        ld (@bufferId+2),a
041FF9 21 04 20 04 0105*        ld hl,@cmd
041FFD 01 06 00 00 0106*        ld bc,@end-@cmd
042001 5B DF       0107*        rst.lil $18
042003 C9          0108*        ret
042004 17 00 A0    0109*    @cmd:     db 23,0,0xA0
042007 00 00       0110*    @bufferId: dw 0x0000
042009 04          0111*               db 4 ; set output stream to buffer
04200A 00          0112*    @end:     db 0x00 ; padding
04200B             0113*    ; end vdu_set_output_stream_buffer
04200B             0114*    
04200B             0115*    ; Command 5: Adjust buffer contents
04200B             0116*    ; VDU 23, 0, &A0, bufferId; 5, operation, offset; [count;] <operand>, [arguments]
04200B             0117*    vdu_adjust_buffer:
04200B C9          0118*        ret ; TODO: implement
04200C             0119*    ; end vdu_adjust_buffer
04200C             0120*    
04200C             0121*    ; Command 6: Conditionally call a buffer
04200C             0122*    ; VDU 23, 0, &A0, bufferId; 6, operation, checkBufferId; checkOffset; [arguments]
04200C             0123*    vdu_call_buffer_conditional:
04200C C9          0124*        ret ; TODO: implement
04200D             0125*    ; end vdu_call_buffer_conditional
04200D             0126*    
04200D             0127*    ; Command 7: Jump to a buffer
04200D             0128*    ; VDU 23, 0, &A0, bufferId; 7
04200D             0129*    ; inputs: hl = bufferId
04200D             0130*    vdu_jump_to_buffer:
04200D 22 25 20 04 0131*        ld (@bufferId),hl
042011 3E 07       0132*        ld a,7 ; jump to buffer
042013 32 27 20 04 0133*        ld (@bufferId+2),a
042017 21 22 20 04 0134*        ld hl,@cmd
04201B 01 06 00 00 0135*        ld bc,@end-@cmd
04201F 5B DF       0136*        rst.lil $18
042021 C9          0137*        ret
042022 17 00 A0    0138*    @cmd:     db 23,0,0xA0
042025 00 00       0139*    @bufferId: dw 0x0000
042027 07          0140*               db 7 ; jump to buffer
042028 00          0141*    @end:     db 0x00 ; padding
042029             0142*    ; end vdu_jump_to_buffer
042029             0143*    
042029             0144*    ; Command 8: Conditional Jump to a buffer
042029             0145*    ; VDU 23, 0, &A0, bufferId; 8, operation, checkBufferId; checkOffset; [arguments]
042029             0146*    vdu_jump_to_buffer_conditional:
042029 C9          0147*        ret ; TODO: implement
04202A             0148*    ; end vdu_jump_to_buffer_conditional
04202A             0149*    
04202A             0150*    ; Command 9: Jump to an offset in a buffer
04202A             0151*    ; VDU 23, 0, &A0, bufferId; 9, offset; offsetHighByte, [blockNumber;]
04202A             0152*    vdu_jump_to_buffer_offset:
04202A C9          0153*        ret ; TODO: implement
04202B             0154*    ; end vdu_jump_to_buffer_offset
04202B             0155*    
04202B             0156*    ; Command 10: Conditional jump to an offset in a buffer
04202B             0157*    ; VDU 23, 0, &A0, bufferId; 10, offset; offsetHighByte, [blockNumber;] [arguments]
04202B             0158*    vdu_jump_to_buffer_offset_conditional:
04202B C9          0159*        ret ; TODO: implement
04202C             0160*    ; end vdu_jump_to_buffer_offset_conditional
04202C             0161*    
04202C             0162*    ; Command 11: Call buffer with an offset
04202C             0163*    ; VDU 23, 0, &A0, bufferId; 11, offset; offsetHighByte, [blockNumber;]
04202C             0164*    vdu_call_buffer_offset:
04202C C9          0165*        ret ; TODO: implement
04202D             0166*    ; end vdu_call_buffer_offset
04202D             0167*    
04202D             0168*    ; Command 64: Compress a buffer
04202D             0169*    ; VDU 23, 0, &A0, targetBufferId; 64, sourceBufferId;
04202D             0170*    ; inputs: hl = sourceBufferId, de = targetBufferId
04202D             0171*    vdu_compress_buffer:
04202D 22 4D 20 04 0172*        ld (@sourceBufferId),hl
042031 ED 53 4A 20 0173*        ld (@targetBufferId),de
       04          
042036 3E 40       0174*        ld a,64 ; compress buffer
042038 32 4C 20 04 0175*        ld (@sourceBufferId-1),a
04203C 21 47 20 04 0176*        ld hl,@cmd
042040 01 08 00 00 0177*        ld bc,@end-@cmd
042044 5B DF       0178*        rst.lil $18
042046 C9          0179*        ret
042047 17 00 A0    0180*    @cmd:     db 23,0,0xA0
04204A 00 00       0181*    @targetBufferId: dw 0x0000
04204C 40          0182*               db 64 ; compress buffer
04204D 00 00       0183*    @sourceBufferId: dw 0x0000
04204F 00          0184*    @end:     db 0x00 ; padding
042050             0185*    
042050             0186*    
042050             0187*    ; Command 65: Decompress a buffer
042050             0188*    ; VDU 23, 0, &A0, targetBufferId; 65, sourceBufferId;
042050             0189*    ; inputs: hl = sourceBufferId, de = targetBufferId
042050             0190*    vdu_decompress_buffer:
042050 22 70 20 04 0191*        ld (@sourceBufferId),hl
042054 ED 53 6D 20 0192*        ld (@targetBufferId),de
       04          
042059 3E 41       0193*        ld a,65 ; decompress buffer
04205B 32 6F 20 04 0194*        ld (@sourceBufferId-1),a
04205F 21 6A 20 04 0195*        ld hl,@cmd
042063 01 08 00 00 0196*        ld bc,@end-@cmd
042067 5B DF       0197*        rst.lil $18
042069 C9          0198*        ret
04206A 17 00 A0    0199*    @cmd:     db 23,0,0xA0
04206D 00 00       0200*    @targetBufferId: dw 0x0000
04206F 41          0201*               db 65 ; decompress buffer
042070 00 00       0202*    @sourceBufferId: dw 0x0000
042072 00          0203*    @end:     db 0x00 ; padding
042073             0041         include "vdu_fonts.inc"
042073             0001*    ; select font
042073             0002*    ; inputs: hl = bufferId, a = font flags
042073             0003*    ; Flags:
042073             0004*    ; Bit	Description
042073             0005*    ; 0	Adjust cursor position to ensure text baseline is aligned
042073             0006*    ;   0: Do not adjust cursor position (best for changing font on a new line)
042073             0007*    ;   1: Adjust cursor position (best for changing font in the middle of a line)
042073             0008*    ; 1-7	Reserved for future use
042073             0009*    ; VDU 23, 0, &95, 0, bufferId; flags: Select font
042073             0010*    vdu_font_select:
042073 22 8A 20 04 0011*        ld (@bufferId),hl
042077 32 8C 20 04 0012*        ld (@flags),a
04207B 21 86 20 04 0013*        ld hl,@cmd
04207F 01 07 00 00 0014*        ld bc,@end-@cmd
042083 5B DF       0015*        rst.lil $18
042085 C9          0016*        ret
042086 17 00 95 00 0017*    @cmd: db 23, 0, 0x95, 0
04208A 00 00       0018*    @bufferId: dw 0x0000
04208C 00          0019*    @flags: db 0x00
04208D             0020*    @end:
04208D             0021*    
04208D             0022*    ; create font from buffer
04208D             0023*    ; inputs: hl = bufferId, e = width, d = height, d = ascent, a = flags
04208D             0024*    ; VDU 23, 0, &95, 1, bufferId; width, height, ascent, flags: Create font from buffer
04208D             0025*    vdu_font_create:
04208D 22 B2 20 04 0026*        ld (@bufferId),hl
042091 ED 53 B4 20 0027*        ld (@width),de ; also loads height
       04          
042096 32 B7 20 04 0028*        ld (@flags),a
04209A 7A          0029*        ld a,d ; height
04209B 32 B6 20 04 0030*        ld (@ascent),a ; ascent = height
04209F             0031*    ; consolidate buffer
04209F CD B7 1D 04 0032*        call vdu_consolidate_buffer
0420A3             0033*    ; create font
0420A3 21 AE 20 04 0034*        ld hl,@cmd
0420A7 01 0A 00 00 0035*        ld bc,@end-@cmd
0420AB 5B DF       0036*        rst.lil $18
0420AD C9          0037*        ret
0420AE 17 00 95 01 0038*    @cmd: db 23, 0, 0x95, 1
0420B2 00 00       0039*    @bufferId: dw 0x0000
0420B4 00          0040*    @width: db 0x00
0420B5 00          0041*    @height: db 0x00
0420B6 00          0042*    @ascent: db 0x00
0420B7 00          0043*    @flags: db 0x00
0420B8             0044*    @end:
0420B8             0045*    
0420B8             0046*    ; set or adjust font property
0420B8             0047*    ; inputs: hl = bufferId, a = field, de = value
0420B8             0048*    ; VDU 23, 0, &95, 2, bufferId; field, value;: Set or adjust font property
0420B8             0049*    vdu_font_property:
0420B8 22 D4 20 04 0050*        ld (@bufferId),hl
0420BC 32 D6 20 04 0051*        ld (@field),a
0420C0 ED 53 D7 20 0052*        ld (@value),de
       04          
0420C5 21 D0 20 04 0053*        ld hl,@cmd
0420C9 01 09 00 00 0054*        ld bc,@end-@cmd
0420CD 5B DF       0055*        rst.lil $18
0420CF C9          0056*        ret
0420D0 17 00 95 02 0057*    @cmd: db 23, 0, 0x95, 2
0420D4 00 00       0058*    @bufferId: dw 0x0000
0420D6 00          0059*    @field: db 0x00
0420D7 00 00       0060*    @value: dw 0x0000
0420D9 00          0061*    @end: db 0x00 ; padding
0420DA             0062*    
0420DA             0063*    ; VDU 23, 0, &95, 3, bufferId; [<args>]: Reserved
0420DA             0064*    
0420DA             0065*    ; Clear/Delete font
0420DA             0066*    ; inputs: hl = bufferId
0420DA             0067*    ; VDU 23, 0, &95, 4, bufferId;: Clear/Delete font
0420DA             0068*    vdu_font_clear:
0420DA 22 ED 20 04 0069*        ld (@bufferId),hl
0420DE 21 E9 20 04 0070*        ld hl,@cmd
0420E2 01 06 00 00 0071*        ld bc,@end-@cmd
0420E6 5B DF       0072*        rst.lil $18
0420E8 C9          0073*        ret
0420E9 17 00 95 04 0074*    @cmd: db 23, 0, 0x95, 4
0420ED 00 00       0075*    @bufferId: dw 0x0000
0420EF 00          0076*    @end: db 0x00 ; padding
0420F0             0077*    
0420F0             0078*    ; Copy system font to buffer
0420F0             0079*    ; inputs: hl = bufferId
0420F0             0080*    ; VDU 23, 0, &95, 5, bufferId;: Copy system font to buffer
0420F0             0081*    vdu_font_copy_system:
0420F0 22 03 21 04 0082*        ld (@bufferId),hl
0420F4 21 FF 20 04 0083*        ld hl,@cmd
0420F8 01 06 00 00 0084*        ld bc,@end-@cmd
0420FC 5B DF       0085*        rst.lil $18
0420FE C9          0086*        ret
0420FF 17 00 95 05 0087*    @cmd: db 23, 0, 0x95, 5
042103 00 00       0088*    @bufferId: dw 0x0000
042105 00          0089*    @end: db 0x00 ; padding
042106             0042         include "vdu_plot.inc"
042106             0001*    ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
042106             0002*    ; PLOT code 	(Decimal) 	Effect
042106             0003*    ; &00-&07 	0-7 	Solid line, includes both ends
042106             0004*    plot_sl_both: equ 0x00
042106             0005*    
042106             0006*    ; &08-&0F 	8-15 	Solid line, final point omitted
042106             0007*    plot_sl_first: equ 0x08
042106             0008*    
042106             0009*    ; &10-&17 	16-23 	Not supported (Dot-dash line, includes both ends, pattern restarted)
042106             0010*    ; &18-&1F 	24-31 	Not supported (Dot-dash line, first point omitted, pattern restarted)
042106             0011*    
042106             0012*    ; &20-&27 	32-39 	Solid line, first point omitted
042106             0013*    plot_sl_last: equ 0x20
042106             0014*    
042106             0015*    ; &28-&2F 	40-47 	Solid line, both points omitted
042106             0016*    plot_sl_none: equ 0x28
042106             0017*    
042106             0018*    ; &30-&37 	48-55 	Not supported (Dot-dash line, first point omitted, pattern continued)
042106             0019*    ; &38-&3F 	56-63 	Not supported (Dot-dash line, both points omitted, pattern continued)
042106             0020*    
042106             0021*    ; &40-&47 	64-71 	Point plot
042106             0022*    plot_pt: equ 0x40
042106             0023*    
042106             0024*    ; &48-&4F 	72-79 	Line fill left and right to non-background §§
042106             0025*    plot_lf_lr_non_bg: equ 0x48
042106             0026*    
042106             0027*    ; &50-&57 	80-87 	Triangle fill
042106             0028*    plot_tf: equ 0x50
042106             0029*    
042106             0030*    ; &58-&5F 	88-95 	Line fill right to background §§
042106             0031*    plot_lf_r_bg: equ 0x58
042106             0032*    
042106             0033*    ; &60-&67 	96-103 	Rectangle fill
042106             0034*    plot_rf: equ 0x60
042106             0035*    
042106             0036*    ; &68-&6F 	104-111 	Line fill left and right to foreground §§
042106             0037*    plot_lf_lr_fg: equ 0x60
042106             0038*    
042106             0039*    ; &70-&77 	112-119 	Parallelogram fill
042106             0040*    plot_pf: equ 0x70
042106             0041*    
042106             0042*    ; &78-&7F 	120-127 	Line fill right to non-foreground §§
042106             0043*    plot_lf_r_non_fg: equ 0x78
042106             0044*    
042106             0045*    ; &80-&87 	128-135 	Not supported (Flood until non-background)
042106             0046*    ; &88-&8F 	136-143 	Not supported (Flood until foreground)
042106             0047*    
042106             0048*    ; &90-&97 	144-151 	Circle outline
042106             0049*    plot_co: equ 0x90
042106             0050*    
042106             0051*    ; &98-&9F 	152-159 	Circle fill
042106             0052*    plot_cf: equ 0x98
042106             0053*    
042106             0054*    ; &A0-&A7 	160-167 	Not supported (Circular arc)
042106             0055*    ; &A8-&AF 	168-175 	Not supported (Circular segment)
042106             0056*    ; &B0-&B7 	176-183 	Not supported (Circular sector)
042106             0057*    
042106             0058*    ; &B8-&BF 	184-191 	Rectangle copy/move
042106             0059*    plot_rcm: equ 0xB8
042106             0060*    
042106             0061*    ; &C0-&C7 	192-199 	Not supported (Ellipse outline)
042106             0062*    ; &C8-&CF 	200-207 	Not supported (Ellipse fill)
042106             0063*    ; &D0-&D7 	208-215 	Not defined
042106             0064*    ; &D8-&DF 	216-223 	Not defined
042106             0065*    ; &E0-&E7 	224-231 	Not defined
042106             0066*    
042106             0067*    ; &E8-&EF 	232-239 	Bitmap plot §
042106             0068*    plot_bmp: equ 0xE8
042106             0069*    
042106             0070*    ; &F0-&F7 	240-247 	Not defined
042106             0071*    ; &F8-&FF 	248-255 	Not defined
042106             0072*    
042106             0073*    ; § Support added in Agon Console8 VDP 2.1.0 §§ Support added in
042106             0074*    ; Agon Console8 VDP 2.2.0
042106             0075*    
042106             0076*    ; Within each group of eight plot codes, the effects are as follows:
042106             0077*    ; Plot code 	Effect
042106             0078*    ; 0 	Move relative
042106             0079*    mv_rel: equ 0
042106             0080*    
042106             0081*    ; 1 	Plot relative in current foreground colour
042106             0082*    dr_rel_fg: equ 1
042106             0083*    
042106             0084*    ; 2 	Not supported (Plot relative in logical inverse colour)
042106             0085*    ; 3 	Plot relative in current background colour
042106             0086*    dr_rel_bg: equ 3
042106             0087*    
042106             0088*    ; 4 	Move absolute
042106             0089*    mv_abs: equ 4
042106             0090*    
042106             0091*    ; 5 	Plot absolute in current foreground colour
042106             0092*    dr_abs_fg: equ 5
042106             0093*    
042106             0094*    ; 6 	Not supported (Plot absolute in logical inverse colour)
042106             0095*    ; 7 	Plot absolute in current background colour
042106             0096*    dr_abs_bg: equ 7
042106             0097*    
042106             0098*    ; Codes 0-3 use the position data provided as part of the command
042106             0099*    ; as a relative position, adding the position given to the current
042106             0100*    ; graphical cursor position. Codes 4-7 use the position data provided
042106             0101*    ; as part of the command as an absolute position, setting the current
042106             0102*    ; graphical cursor position to the position given.
042106             0103*    
042106             0104*    ; Codes 2 and 6 on Acorn systems plot using a logical inverse of the
042106             0105*    ; current pixel colour. These operations cannot currently be supported
042106             0106*    ; by the graphics system the Agon VDP uses, so these codes are not
042106             0107*    ; supported. Support for these codes may be added in a future version
042106             0108*    ; of the VDP firmware.
042106             0109*    
042106             0110*    ; 16 colour palette constants
042106             0111*    c_black: equ 0
042106             0112*    c_red_dk: equ 1
042106             0113*    c_green_dk: equ 2
042106             0114*    c_yellow_dk: equ 3
042106             0115*    c_blue_dk: equ 4
042106             0116*    c_magenta_dk: equ 5
042106             0117*    c_cyan_dk: equ 6
042106             0118*    c_grey: equ 7
042106             0119*    c_grey_dk: equ 8
042106             0120*    c_red: equ 9
042106             0121*    c_green: equ 10
042106             0122*    c_yellow: equ 11
042106             0123*    c_blue: equ 12
042106             0124*    c_magenta: equ 13
042106             0125*    c_cyan: equ 14
042106             0126*    c_white: equ 15
042106             0127*    
042106             0128*    ; GCOL paint modes
042106             0129*    ; The GCOL command (VDU 18, mode, colour) is used to set the paint mode for the PLOT
042106             0130*    ; command. The paint mode is used to control how the PLOT command interacts with the
042106             0131*    ; existing pixels on the screen.
042106             0132*    gcol_mode_col: equ %000000000 ; Set on-screen pixel to target colour value
042106             0133*    gcol_mode_or: equ %000000001 ; OR value with the on-screen pixel
042106             0134*    gcol_mode_and: equ %000000010 ; AND value with the on-screen pixel
042106             0135*    gcol_mode_xor: equ %000000011 ; EOR value with the on-screen pixel
042106             0136*    gcol_mode_inv: equ %000000100 ; Invert the on-screen pixel
042106             0137*    gcol_mode_non: equ %000000101 ; No operation
042106             0138*    gcol_mode_and_inv: equ %000000110 ; AND the inverse of the specified colour with the on-screen pixel
042106             0139*    gcol_mode_or_inv: equ %000000111 ; OR the inverse of the specified colour with the on-screen pixel
042106             0140*    
042106             0141*    ; VDU 25, mode, x; y;: PLOT command
042106             0142*    ; inputs: a=mode, bc=x0, de=y0
042106             0143*    vdu_plot:
042106 32 20 21 04 0144*        ld (@mode),a
04210A ED 43 21 21 0145*        ld (@x0),bc
       04          
04210F ED 53 23 21 0146*        ld (@y0),de
       04          
042114 21 1F 21 04 0147*    	ld hl,@cmd
042118 01 06 00 00 0148*    	ld bc,@end-@cmd
04211C 5B DF       0149*    	rst.lil $18
04211E C9          0150*    	ret
04211F 19          0151*    @cmd:   db 25
042120 00          0152*    @mode:  db 0
042121 00 00       0153*    @x0: 	dw 0
042123 00 00       0154*    @y0: 	dw 0
042125 00          0155*    @end:   db 0 ; extra byte to soak up deu
042126             0156*    
042126             0157*    ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
042126             0158*    ; &E8-&EF 	232-239 	Bitmap plot §
042126             0159*    ; VDU 25, mode, x; y;: PLOT command
042126             0160*    ; inputs: bc=x0, de=y0
042126             0161*    ; prerequisites: vdu_buff_select
042126             0162*    vdu_plot_bmp:
042126 ED 43 3D 21 0163*        ld (@x0),bc
       04          
04212B ED 53 3F 21 0164*        ld (@y0),de
       04          
042130 21 3B 21 04 0165*    	ld hl,@cmd
042134 01 06 00 00 0166*    	ld bc,@end-@cmd
042138 5B DF       0167*    	rst.lil $18
04213A C9          0168*    	ret
04213B 19          0169*    @cmd:   db 25
04213C ED          0170*    @mode:  db plot_bmp+dr_abs_fg ; 0xED
04213D 00 00       0171*    @x0: 	dw 0x0000
04213F 00 00       0172*    @y0: 	dw 0x0000
042141 00          0173*    @end:   db 0x00 ; padding
042142             0174*    
042142             0175*    ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
042142             0176*    ; &E8-&EF 	232-239 	Bitmap plot §
042142             0177*    ; VDU 25, mode, x; y;: PLOT command
042142             0178*    ; inputs: bc=x0, de=y0
042142             0179*    ; USING 16.8 FIXED POINT COORDINATES
042142             0180*    ; inputs: ub.c is x coordinate, ud.e is y coordinate
042142             0181*    ;   the fractional portiion of the inputs are truncated
042142             0182*    ;   leaving only the 16-bit integer portion
042142             0183*    ; prerequisites: vdu_buff_select
042142             0184*    vdu_plot_bmp168:
042142             0185*    ; populate in the reverse of normal to keep the
042142             0186*    ; inputs from stomping on each other
042142 ED 53 60 21 0187*        ld (@y0-1),de
       04          
042147 ED 43 5E 21 0188*        ld (@x0-1),bc
       04          
04214C 3E ED       0189*        ld a,plot_bmp+dr_abs_fg ; 0xED
04214E 32 5E 21 04 0190*        ld (@mode),a ; restore the mode byte that got stomped on by bcu
042152 21 5D 21 04 0191*    	ld hl,@cmd
042156 01 06 00 00 0192*    	ld bc,@end-@cmd
04215A 5B DF       0193*    	rst.lil $18
04215C C9          0194*    	ret
04215D 19          0195*    @cmd:   db 25
04215E ED          0196*    @mode:  db plot_bmp+dr_abs_fg ; 0xED
04215F 00 00       0197*    @x0: 	dw 0x0000
042161 00 00       0198*    @y0: 	dw 0x0000
042163             0199*    @end:  ; no padding required b/c we shifted de right
042163             0200*    
042163             0201*    ; draw a filled rectangle
042163             0202*    vdu_plot_rf:
042163 ED 43 8A 21 0203*        ld (@x0),bc
       04          
042168 ED 53 8C 21 0204*        ld (@y0),de
       04          
04216D DD 22 90 21 0205*        ld (@x1),ix
       04          
042172 FD 22 92 21 0206*        ld (@y1),iy
       04          
042177 3E 19       0207*        ld a,25 ; we have to reload the 2nd plot command
042179 32 8E 21 04 0208*        ld (@cmd1),a ; because the 24-bit y0 load stomped on it
04217D 21 88 21 04 0209*    	ld hl,@cmd0
042181 01 0C 00 00 0210*    	ld bc,@end-@cmd0
042185 5B DF       0211*    	rst.lil $18
042187 C9          0212*        ret
042188 19          0213*    @cmd0:  db 25 ; plot
042189 04          0214*    @arg0:  db plot_sl_both+mv_abs
04218A 00 00       0215*    @x0:    dw 0x0000
04218C 00 00       0216*    @y0:    dw 0x0000
04218E 19          0217*    @cmd1:  db 25 ; plot
04218F 65          0218*    @arg1:  db plot_rf+dr_abs_fg
042190 00 00       0219*    @x1:    dw 0x0000
042192 00 00       0220*    @y1:    dw 0x0000
042194 00          0221*    @end:   db 0x00 ; padding
042195             0222*    
042195             0223*    ; draw a filled circle
042195             0224*    vdu_plot_cf:
042195 ED 43 BC 21 0225*        ld (@x0),bc
       04          
04219A ED 53 BE 21 0226*        ld (@y0),de
       04          
04219F DD 22 C2 21 0227*        ld (@x1),ix
       04          
0421A4 FD 22 C4 21 0228*        ld (@y1),iy
       04          
0421A9 3E 19       0229*        ld a,25 ; we have to reload the 2nd plot command
0421AB 32 C0 21 04 0230*        ld (@cmd1),a ; because the 24-bit y0 load stomped on it
0421AF 21 BA 21 04 0231*    	ld hl,@cmd0
0421B3 01 0C 00 00 0232*    	ld bc,@end-@cmd0
0421B7 5B DF       0233*    	rst.lil $18
0421B9 C9          0234*        ret
0421BA 19          0235*    @cmd0:  db 25 ; plot
0421BB 04          0236*    @arg0:  db plot_sl_both+mv_abs
0421BC 00 00       0237*    @x0:    dw 0x0000
0421BE 00 00       0238*    @y0:    dw 0x0000
0421C0 19          0239*    @cmd1:  db 25 ; plot
0421C1 9D          0240*    @arg1:  db plot_cf+dr_abs_fg
0421C2 00 00       0241*    @x1:    dw 0x0000
0421C4 00 00       0242*    @y1:    dw 0x0000
0421C6 00          0243*    @end:   db 0x00 ; padding
0421C7             0043         include "vdu_sound.inc"
0421C7             0001*    ; enable sound channels
0421C7             0002*    ; inputs: a = total num channels to be enabled
0421C7             0003*    ; returns: nothing
0421C7             0004*    ; destroys: af, bc, hl
0421C7             0005*    vdu_enable_channels:
0421C7 3D          0006*        dec a ; channels are zero-based
0421C8             0007*    @loop:
0421C8 32 E1 21 04 0008*        ld (@channel),a
0421CC 21 DE 21 04 0009*        ld hl,@beg
0421D0 01 05 00 00 0010*        ld bc,@end-@beg
0421D4 F5          0011*        push af
0421D5 5B DF       0012*        rst.lil $18
0421D7 F1          0013*        pop af
0421D8 3D          0014*        dec a
0421D9 C2 C8 21 04 0015*        jp nz,@loop
0421DD C9          0016*        ret
0421DE             0017*    @beg:
0421DE 17 00 85    0018*                db 23, 0, $85
0421E1 00          0019*    @channel:   db 0
0421E2 08          0020*                db 8 ; command 8: enable channel
0421E3             0021*    @end:
0421E3             0022*    
0421E3             0023*    ; disable all but the three default sound channels
0421E3             0024*    ; inputs: max_channels set
0421E3             0025*    ; outputs: none
0421E3             0026*    ; destroys: ah,hl,bc
0421E3             0027*    vdu_disable_channels:
0421E3 3E 01       0028*        ld a,max_channels
0421E5 D6 03       0029*        sub 3 ; subtract number of default channels already enabled
0421E7 F2 EE 21 04 0030*        jp p,@loop
0421EB C9          0031*        ret
0421EC 3E 03       0032*        ld a,3 ; first non-default channel
0421EE             0033*    @loop:
0421EE 32 09 22 04 0034*        ld (@channel),a
0421F2 21 06 22 04 0035*        ld hl,@beg
0421F6 01 05 00 00 0036*        ld bc,@end-@beg
0421FA F5          0037*        push af
0421FB 5B DF       0038*        rst.lil $18
0421FD F1          0039*        pop af
0421FE 3C          0040*        inc a
0421FF FE 01       0041*        cp max_channels
042201 C2 EE 21 04 0042*        jp nz,@loop
042205 C9          0043*        ret
042206             0044*    @beg:
042206 17 00 85    0045*        db 23, 0, $85
042209 00          0046*    @channel: db 0
04220A 09          0047*        db 9 ; command 9: disable channel
04220B             0048*    @end:
04220B             0049*    
04220B             0050*    
04220B             0051*    ; ############################################################
04220B             0052*    ; VDU SOUND API
04220B             0053*    ; ############################################################
04220B             0054*    ; Command 0: Play note
04220B             0055*    ; VDU 23, 0, &85, channel, 0, volume, frequency; duration;
04220B             0056*        MACRO PLAY_NOTE channel, volume, frequency, duration
04220B             0057*        ld hl, @PLAY_NOTE_CMD        ; Start of command block
04220B             0058*        ld bc, @PLAY_NOTE_END - @PLAY_NOTE_CMD  ; Command block size
04220B             0059*        rst.lil $18
04220B             0060*        jr @PLAY_NOTE_END
04220B             0061*    @PLAY_NOTE_CMD:  db 23, 0, 0x85               ; Command header
04220B             0062*                     db channel                  ; Channel, 0 (commented out)
04220B             0063*                     db 0                        ; Play note command
04220B             0064*                     db volume                   ; Volume
04220B             0065*                     dw frequency                ; Frequency
04220B             0066*                     dw duration                 ; Duration
04220B             0067*    @PLAY_NOTE_END:
04220B             0068*        ENDMACRO
04220B             0069*    
04220B             0070*        MACRO MUTE_CHANNEL channel
04220B             0071*        ld hl, @MUTE_CHANNEL_CMD     ; Start of command block
04220B             0072*        ld bc, @MUTE_CHANNEL_END - @MUTE_CHANNEL_CMD  ; Command block size
04220B             0073*        rst.lil $18
04220B             0074*        jr @MUTE_CHANNEL_END
04220B             0075*    @MUTE_CHANNEL_CMD: db 23, 0, 0x85             ; Command header
04220B             0076*                       db channel                ; Channel, 0 (commented out)
04220B             0077*                       db 2                      ; Set volume command
04220B             0078*                       db 0                      ; Volume (mute)
04220B             0079*    @MUTE_CHANNEL_END:
04220B             0080*        ENDMACRO
04220B             0081*    
04220B             0082*    ; inputs: c = channel, b = volume, hl = frequency; de = duration;
04220B             0083*    vdu_play_note:
04220B 79          0084*        ld a,c
04220C 32 2C 22 04 0085*        ld (@channel),a
042210 78          0086*        ld a,b
042211 32 2E 22 04 0087*        ld (@volume),a
042215 22 2F 22 04 0088*        ld (@frequency),hl
042219 ED 53 31 22 0089*        ld (@duration),de
       04          
04221E 21 29 22 04 0090*        ld hl,@cmd
042222 01 0A 00 00 0091*        ld bc,@end-@cmd
042226 5B DF       0092*        rst.lil $18
042228 C9          0093*        ret
042229 17 00 85    0094*    @cmd:       db 23, 0, 0x85
04222C 00          0095*    @channel:   db 0x00
04222D 00          0096*                db 0x00 ; play note command
04222E 00          0097*    @volume:    db 0x00
04222F 00 00       0098*    @frequency: dw 0x0000
042231 00 00       0099*    @duration:  dw 0x0000
042233 00          0100*    @end:       db 0x00 ; padding
042234             0101*    
042234             0102*    ; Command 1: Status
042234             0103*    ; VDU 23, 0, &85, channel, 1
042234             0104*    ; inputs: a = channel
042234             0105*    ; Returns a bit mask indicating the status of the specified channel, or 255 if the channel is not valid, or has been disabled. The bit mask is as follows:
042234             0106*    ; Bit 	Name 	Meaning
042234             0107*    ; 0 	Active 	When set this indicates the channel is in use (has an active waveform)
042234             0108*    ; 1 	Playing 	Indicates the channel is actively playing a note, and thus will reject calls to play a new note
042234             0109*    ; 2 	Indefinite 	Set if the channel is playing an indefinite duration note
042234             0110*    ; 3 	Has Volume Envelope 	Set if the channel has a volume envelope
042234             0111*    ; 4 	Has Frequency Envelope 	Set if the channel has a frequency envelope
042234             0112*    
042234             0113*    ; Bits 5-7 are reserved for future use and, for enabled channels, will currently always be zero.
042234             0114*    vdu_channel_status:
042234 32 46 22 04 0115*        ld (@channel),a
042238 21 43 22 04 0116*        ld hl,@cmd
04223C 01 05 00 00 0117*        ld bc,@end-@cmd
042240 5B DF       0118*        rst.lil $18
042242 C9          0119*        ret
042243 17 00 85    0120*    @cmd:       db 23, 0, 0x85
042246 00          0121*    @channel:   db 0x00
042247 01          0122*                db 0x01 ; get channel status command
042248             0123*    @end:
042248             0124*    
042248             0125*    ; VDU 23, 0, &85, channel, 2, volume
042248             0126*    ; inputs: c = channel, b = volume
042248             0127*    ; Sets the volume of the specified channel. The volume is a value from 0 to 127, where 0 is silent and 127 is full volume. Values over 127 will be treated as 127 (with one exception described later).
042248             0128*    
042248             0129*    ; Specifying a channel of -1 (or 255) will set the global sound system volume level. (Requires Console8 VDP 2.5.0 or later.)
042248             0130*    
042248             0131*    ; Using this command provides more direct control over a channel than the play note command. It can be used to adjust the volume of a channel that is already playing a note.
042248             0132*    vdu_channel_volume:
042248 79          0133*        ld a,c
042249 32 60 22 04 0134*        ld (@channel),a
04224D 78          0135*        ld a,b
04224E 32 62 22 04 0136*        ld (@volume),a
042252 21 5D 22 04 0137*        ld hl,@cmd
042256 01 06 00 00 0138*        ld bc,@end-@cmd
04225A 5B DF       0139*        rst.lil $18
04225C C9          0140*        ret
04225D 17 00 85    0141*    @cmd:       db 23, 0, 0x85
042260 00          0142*    @channel:   db 0x00
042261 02          0143*                db 0x02 ; set volume command
042262 00          0144*    @volume:    db 0x00
042263             0145*    @end:
042263             0146*    
042263             0147*    ; Command 10: Reset channel
042263             0148*    ; VDU 23, 0, &85, channel, 10
042263             0149*    ; inputs: c = channel
042263             0150*    vdu_reset_channel:
042263 79          0151*        ld a,c
042264 32 76 22 04 0152*        ld (@channel),a
042268 21 73 22 04 0153*        ld hl,@cmd
04226C 01 05 00 00 0154*        ld bc,@end-@cmd
042270 5B DF       0155*        rst.lil $18
042272 C9          0156*        ret
042273 17 00 85    0157*    @cmd:       db 23, 0, 0x85
042276 00          0158*    @channel:   db 0x00
042277 0A          0159*                db 10 ; reset channel command
042278             0160*    @end:
042278             0161*    
042278             0162*    ; VDU 23, 0, &85, channel, 3, frequency;
042278             0163*    
042278             0164*    ; Sets the frequency of the specified channel. The frequency is a 16-bit value specifying in Hz the frequency of the note to be played.
042278             0165*    
042278             0166*    ; Using this command provides more direct control over a channel than the play note command. It can be used to adjust the frequency of a channel that is already playing a note.
042278             0167*    
042278             0168*    ; Returns 1 on success, 0 for failure.
042278             0169*    vdu_channel_frequency:
042278 79          0170*        ld a,c
042279 32 90 22 04 0171*        ld (@channel),a
04227D ED 53 92 22 0172*        ld (@frequency),de
       04          
042282 21 8D 22 04 0173*        ld hl,@cmd
042286 01 07 00 00 0174*        ld bc,@end-@cmd
04228A 5B DF       0175*        rst.lil $18
04228C C9          0176*        ret
04228D 17 00 85    0177*    @cmd:       db 23, 0, 0x85
042290 00          0178*    @channel:   db 0x00
042291 03          0179*                db 0x03 ; set frequency command
042292 00 00       0180*    @frequency: dw 0x0000
042294 00          0181*    @end:       db 0x00 ; padding
042295             0182*    
042295             0183*    
042295             0184*    ; VDU 23, 0, &85, channel, 4, waveformOrSample, [bufferId;]
042295             0185*    ; inputs: c = channel, b = waveformOrSample, [hl = bufferId]
042295             0186*    ; Sets the waveform type for a channel to use. The waveformOrSample value is a single byte treated as a signed value.
042295             0187*    
042295             0188*    ; Using a negative value for the waveform indicates that a sample should be used instead. For more information see the documentation for the sample command.
042295             0189*    
042295             0190*    ; By default a channel is set to use waveform 0 (square wave).
042295             0191*    
042295             0192*    ; Valid waveform values are as follows:
042295             0193*    ; Value 	Waveform
042295             0194*    ; 0 	Square wave
042295             0195*    ; 1 	Triangle wave
042295             0196*    ; 2 	Sawtooth wave
042295             0197*    ; 3 	Sine wave
042295             0198*    ; 4 	Noise (simple white noise with no frequency support)
042295             0199*    ; 5 	VIC Noise (emulates a VIC6561; supports frequency)
042295             0200*    ; 8 	Sample (specifying a 16-bit buffer ID for sample data)
042295             0201*    
042295             0202*    vdu_channel_waveform:
042295 79          0203*        ld a,c
042296 32 BB 22 04 0204*        ld (@channel),a
04229A 78          0205*        ld a,b
04229B 32 BD 22 04 0206*        ld (@waveform),a
04229F FE 08       0207*        cp 8 ; check if the waveform is a sample
0422A1 28 06       0208*        jr z, @sample
0422A3 01 06 00 00 0209*        ld bc,@bufferId-@cmd
0422A7 18 08       0210*        jr @sendToVdu
0422A9             0211*    @sample:
0422A9 22 BE 22 04 0212*        ld (@bufferId),hl
0422AD 01 08 00 00 0213*        ld bc,@end-@cmd
0422B1             0214*    @sendToVdu:
0422B1 21 B8 22 04 0215*        ld hl,@cmd
0422B5 5B DF       0216*        rst.lil $18
0422B7 C9          0217*        ret
0422B8 17 00 85    0218*    @cmd:       db 23, 0, 0x85
0422BB 00          0219*    @channel:   db 0x00
0422BC 04          0220*                db 0x04 ; set waveform command
0422BD 00          0221*    @waveform:  db 0x00
0422BE 00 00       0222*    @bufferId:  dw 0x0000
0422C0 00          0223*    @end:       db 0x00 ; padding
0422C1             0224*    
0422C1             0225*    ; VDU 23, 0, &85, channel (ignored), 5, 2, bufferId; format, [sampleRate;]
0422C1             0226*    ; inputs: hl = bufferId; a = format, de = sample rate in Hz
0422C1             0227*    ; The format is a single byte giving the format of the sample data. The following formats are supported:
0422C1             0228*    ; Value	Description
0422C1             0229*    ; 0	8-bit signed
0422C1             0230*    ; 1	8-bit unsigned
0422C1             0231*    ; The format value can also have modifier bits set to modify the behaviour of the sample. The following modifier bits are supported:
0422C1             0232*    ; Value	Description
0422C1             0233*    ; 8	sample rate is sent in the next 16-bits
0422C1             0234*    ; 16	sample is tuneable
0422C1             0235*    ; The default sample rate for samples on the VDP is 16kHz (actually 16.384kHz to be precise).
0422C1             0236*    vdu_buffer_to_sound:
0422C1 22 E1 22 04 0237*        ld (@bufferId),hl
0422C5 C6 08       0238*        add a,8 ; modify format byte to indicate sample rate argument is given
0422C7 32 E3 22 04 0239*        ld (@format),a
0422CB ED 53 E4 22 0240*        ld (@sampleRate),de
       04          
0422D0 21 DB 22 04 0241*        ld hl,@cmd
0422D4 01 0B 00 00 0242*        ld bc,@end-@cmd
0422D8 5B DF       0243*        rst.lil $18
0422DA C9          0244*        ret
0422DB 17 00 85    0245*    @cmd:       db 23, 0, 0x85
0422DE 00          0246*    @channel:   db 0x00 ; ignored
0422DF 05          0247*                db 0x05 ; buffer to sound command
0422E0 02          0248*                db 0x02 ; command 2 create sample
0422E1 00 00       0249*    @bufferId:  dw 0x0000
0422E3 00          0250*    @format:    db 0x00
0422E4 00 00       0251*    @sampleRate: dw 0x0000
0422E6 00          0252*    @end:       db 0x00 ; padding
0422E7             0253*    
0422E7             0254*    ; load a sound file to a buffer
0422E7             0255*    ; inputs: hl = bufferId ; de = sampleRate in Hz ; iy = pointer to filename
0422E7             0256*    vdu_load_sfx:
0422E7             0257*    ; back up input parameters
0422E7 E5          0258*        push hl ; bufferId
0422E8 D5          0259*        push de ; sample rate
0422E9             0260*    ; load the sound
0422E9 CD F4 1D 04 0261*        call vdu_load_buffer_from_file
0422ED             0262*    ; now make the buffer a sound sample
0422ED D1          0263*        pop de ; sample rate
0422EE E1          0264*        pop hl ; bufferId
0422EF AF          0265*        xor a ; zero is the magic number for mono 8-bit signed PCM
0422F0 CD C1 22 04 0266*        call vdu_buffer_to_sound
0422F4 C9          0267*        ret
0422F5             0268*    
0422F5             0269*    
0422F5 00          0270*    last_channel: db 0
0422F6             0271*    max_channels: equ 1
0422F6             0272*    
0422F6             0273*    ; play a sound effect from an already loaded buffer
0422F6             0274*    ; inputs: hl = bufferId ; bc = duration in milliseconds
0422F6             0275*    vdu_play_sfx:
0422F6 22 2E 23 04 0276*        ld (@bufferId),hl
0422FA ED 43 38 23 0277*        ld (@duration),bc
       04          
0422FF 3E 17       0278*        ld a,23
042301 32 30 23 04 0279*        ld (@bufferId+2),a
042305 3A F5 22 04 0280*        ld a,(last_channel)
042309 3C          0281*        inc a
04230A             0282*        ; and 31 ; modulo 32
04230A FE 01       0283*        cp max_channels
04230C C2 11 23 04 0284*        jp nz,@load_channel
042310 AF          0285*        xor a
042311             0286*    @load_channel:
042311 32 F5 22 04 0287*        ld (last_channel),a
042315 32 2B 23 04 0288*        ld (@channel0),a
042319 32 33 23 04 0289*        ld (@channel1),a
04231D 21 28 23 04 0290*        ld hl, @sample
042321 01 12 00 00 0291*        ld bc, @sample_end - @sample
042325 5B DF       0292*        rst.lil $18
042327 C9          0293*        ret
042328             0294*    @sample:
042328             0295*    ; Command 4: Set waveform
042328             0296*    ; VDU 23, 0, &85, channel, 4, waveformOrSample, [bufferId;]
042328 17 00 85    0297*        .db 23,0,$85                        ; do sound
04232B             0298*    @channel0:
04232B 00 04 08    0299*        .db 0,4,8 ; channel, command, waveform
04232E             0300*    @bufferId:
04232E 00 00       0301*        .dw 0x0000
042330             0302*    ; Command 0: Play note
042330             0303*    ; VDU 23, 0, &85, channel, 0, volume, frequency; duration;
042330 17 00 85    0304*        .db 23,0,$85                        ; do sound
042333             0305*    @channel1:
042333 00 00 7F    0306*        .db 0,0,127                ; channel, volume
042336 00 00       0307*        .dw 0
042338             0308*    @duration:                              ; freq (tuneable samples only)
042338 00 00       0309*        .dw 0x0000                        ; duration
04233A             0310*    @sample_end:
04233A 00          0311*        .db 0x00 ; padding
04233B             0312*    
04233B             0313*    ; inputs: c = channel, b = volume, de = sample rate; hl = bufferId;
04233B             0314*    vdu_play_sample:
04233B             0315*        ; populate input parameters
04233B 79          0316*        ld a,c
04233C 32 6E 23 04 0317*        ld (@channel0),a
042340 32 76 23 04 0318*        ld (@channel1),a
042344 32 7D 23 04 0319*        ld (@channel2),a
042348 78          0320*        ld a,b
042349 32 7F 23 04 0321*        ld (@volume),a
04234D ED 53 78 23 0322*        ld (@sampleRate),de
       04          
042352 22 71 23 04 0323*        ld (@bufferId),hl
042356 3E 17       0324*        ld a,23
042358 32 73 23 04 0325*        ld (@cmd1),a
04235C 32 7A 23 04 0326*        ld (@cmd2),a
042360             0327*        ; prep the vdu command string
042360 21 6B 23 04 0328*        ld hl, @cmd0
042364 01 19 00 00 0329*        ld bc, @end - @cmd0
042368 5B DF       0330*        rst.lil $18
04236A C9          0331*        ret
04236B             0332*    ; set waveform command
04236B 17 00 85    0333*    @cmd0:       db 23, 0, 0x85
04236E 00          0334*    @channel0:   db 0x00
04236F 04          0335*                 db 0x04 ; set waveform command
042370 08          0336*    @waveform:   db 0x08 ; sample
042371 00 00       0337*    @bufferId:   dw 0x0000
042373             0338*    ; set sample rate command
042373 17 00 85    0339*    @cmd1:       db 23, 0, 0x85
042376 00          0340*    @channel1:   db 0x00
042377 0D          0341*                db 13 ; set sample rate command
042378 00 00       0342*    @sampleRate: dw 0x0000
04237A             0343*    ; play note command
04237A 17 00 85    0344*    @cmd2:       db 23, 0, 0x85
04237D 00          0345*    @channel2:   db 0x00
04237E 00          0346*                 db 0x00 ; play note command
04237F 00          0347*    @volume:     db 0x00
042380 00 00       0348*    @frequency:  dw 0x00 ; no effect unless buffer has been set to tuneable sample
042382 00 00       0349*    @duration:   dw 0x0000 ; milliseconds: set to -1 to loop indefinitely, 0 to play full duration once
042384 00          0350*    @end:        db 0x00 ; padding

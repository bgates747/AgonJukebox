043F01             0108*    ; end bf_prev_file
043F01             0109*    
043F01             0110*    get_next_file_idx:
043F01             0111*    ; get number of files on current page
043F01 3A 04 00 07 0112*        ld a,(bf_files_cur_pg)
043F05 47          0113*        ld b,a
043F06             0114*    ; increment the file index
043F06 3A 00 00 07 0115*        ld a,(bf_file_idx)
043F0A 3C          0116*        inc a
043F0B B8          0117*        cp b
043F0C DA 11 3F 04 0118*        jp c,@F ; check for wraparound
043F10 AF          0119*        xor a ; wrap around to the first file
043F11             0120*    @@:
043F11 32 00 00 07 0121*        ld (bf_file_idx),a
043F15 C9          0122*        ret
043F16             0123*    ; end get_next_file_idx
043F16             0124*    
043F16             0125*    bf_next_file:
043F16 CD 01 3F 04 0126*        call get_next_file_idx

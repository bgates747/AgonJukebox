044140             0378*    ps_seek:
044140             0379*    ; compute new playhead position and update the playbar
044140 ED 5B 90 67 0380*        ld de,(ps_playhead)
       04          
044145 19          0381*        add hl,de ; hl = playhead + seek_rate
044146 2B          0382*        dec hl ; to offset an inc we get further down somewhere
044147             0383*    ; handle wraparound
044147 ED 5B 94 67 0384*        ld de,(ps_song_duration)
       04          
